# The «Feedback about Vilna» window (lt). Review by a native speaker is welcome (Weblate).
msgid ""
msgstr "Content-Type: text/plain; charset=UTF-8\n"

msgid "Feedback about Vilna"
msgstr "Atsiliepimas apie Vilna"

msgid "Feedback"
msgstr "Atsiliepimas"

msgid "Crash reports"
msgstr "Strigčių ataskaitos"

msgid "Tell us what went wrong, what surprised you or what you would like. Only the Vilna team reads it; nothing is published without your permission."
msgstr "Parašykite, kas nepavyko, kas nustebino ar ko norėtumėte. Skaito tik Vilna komanda; be jūsų leidimo niekas neskelbiama."

msgid "What is it about?"
msgstr "Dėl ko tai?"

msgid "Something does not work"
msgstr "Kažkas neveikia"

msgid "An idea or a wish"
msgstr "Idėja ar pageidavimas"

msgid "Something else"
msgstr "Kita"

msgid "Your message"
msgstr "Jūsų žinutė"

msgid "Add facts about this computer"
msgstr "Pridėti duomenis apie šį kompiuterį"

msgid "You may answer me by e-mail"
msgstr "Galite man atsakyti el. paštu"

msgid "E-mail address"
msgstr "El. pašto adresas"

msgid "You may publish it, without my address, after reading it"
msgstr "Perskaitę galite paskelbti, be mano adreso"

msgid "Add my conversation with Gloxi from the installation"
msgstr "Pridėti mano pokalbį su Gloxi diegimo metu"

msgid "It may have your name, the computer's name or a Wi-Fi network. You read it before it is added."
msgstr "Jame gali būti jūsų vardas, kompiuterio ar Wi-Fi tinklo pavadinimas. Prieš pridedant jį perskaitysite."

msgid "Conversation with Gloxi"
msgstr "Pokalbis su Gloxi"

msgid "Read"
msgstr "Skaityti"

msgid "Add"
msgstr "Pridėti"

msgid "Do not add"
msgstr "Nepridėti"

msgid "What will be sent"
msgstr "Kas bus išsiųsta"

msgid "Send"
msgstr "Siųsti"

msgid "Sending…"
msgstr "Siunčiama…"

msgid "Thank you! Your feedback is sent."
msgstr "Ačiū! Jūsų atsiliepimas išsiųstas."

msgid "Write what happened or what you suggest."
msgstr "Parašykite, kas nutiko arba ką siūlote."

msgid "This does not look like an e-mail address."
msgstr "Tai nepanašu į el. pašto adresą."

msgid "The message is longer than 8000 characters."
msgstr "Žinutė ilgesnė nei 8000 ženklų."

msgid "The report service is not running on this computer, so nothing can be sent now. Your text stays here."
msgstr "Ataskaitų tarnyba šiame kompiuteryje neveikia, todėl dabar nieko negalima išsiųsti. Jūsų tekstas lieka čia."

msgid "Not sent: {reason}"
msgstr "Neišsiųsta: {reason}"

msgid "Crash reports stay on this computer until they are sent. Each one has only what you see here: which program crashed and where in its code."
msgstr "Strigčių ataskaitos lieka šiame kompiuteryje, kol jos išsiunčiamos. Kiekvienoje yra tik tai, ką matote čia: kuri programa užstrigo ir kurioje jos kodo vietoje."

msgid "No crash reports."
msgstr "Strigčių ataskaitų nėra."

msgid "If a program crashes, send us a crash report?"
msgstr "Jei programa užstrigs, siųsti mums strigties ataskaitą?"

msgid "Send automatically"
msgstr "Siųsti automatiškai"

msgid "Ask me every time"
msgstr "Klausti kaskart"

msgid "Never"
msgstr "Niekada"

msgid "No answer yet: nothing is sent."
msgstr "Atsakymo dar nėra: niekas nesiunčiama."

msgid "The answer was not changed."
msgstr "Atsakymas nepakeistas."

msgid "Not sent"
msgstr "Neišsiųsta"

msgid "Sent"
msgstr "Išsiųsta"

msgid "Not accepted by the server"
msgstr "Serveris nepriėmė"

msgid "First report of this crash"
msgstr "Pirmoji šios strigties ataskaita"

msgid "We already know about this crash"
msgstr "Apie šią strigtį jau žinome"

msgid "Fixed in {version}"
msgstr "Ištaisyta versijoje {version}"

msgid "View"
msgstr "Peržiūrėti"

msgid "Crash report"
msgstr "Strigties ataskaita"

msgid "Close"
msgstr "Užverti"

msgid "Do not send"
msgstr "Nesiųsti"

msgid "Delete everything I sent from the server"
msgstr "Ištrinti iš serverio viską, ką išsiunčiau"

msgid "Deleted from the server: {count}"
msgstr "Ištrinta iš serverio: {count}"

msgid "{program} crashed"
msgstr "{program} užstrigo"

msgid "Send us a crash report? It has only which program crashed and where in its code."
msgstr "Siųsti mums strigties ataskaitą? Joje tik tai, kuri programa užstrigo ir kurioje jos kodo vietoje."
