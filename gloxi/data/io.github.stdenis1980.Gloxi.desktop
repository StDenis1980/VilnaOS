# SPDX-License-Identifier: GPL-3.0-or-later
[Desktop Entry]
Type=Application
Name=Gloxi
Comment=AI assistant that acts only with your permission
Comment[uk]=AI-асистент, який діє лише з вашого дозволу
Comment[es]=Asistente de IA que actúa solo con tu permiso
Comment[pl]=Asystent AI, który działa tylko za Twoją zgodą
Comment[de]=KI-Assistent, der nur mit Ihrer Erlaubnis handelt
Comment[fr]=Assistant IA qui n’agit qu’avec votre permission
Comment[it]=Assistente IA che agisce solo con il tuo permesso
Comment[ro]=Asistent AI care acționează doar cu permisiunea dumneavoastră
Comment[cs]=Asistent AI, který jedná jen s vaším svolením
Comment[lt]=DI asistentas, kuris veikia tik jums leidus
Exec=gloxi-gtk
Icon=io.github.stdenis1980.Gloxi
Terminal=false
Categories=Utility;GTK;
Keywords=assistant;AI;chat;
Keywords[uk]=асистент;ШІ;чат;
Keywords[es]=asistente;IA;chat;
Keywords[pl]=asystent;AI;czat;
Keywords[de]=Assistent;KI;Chat;
Keywords[fr]=assistant;IA;discussion;
Keywords[it]=assistente;IA;chat;
Keywords[ro]=asistent;AI;chat;
Keywords[cs]=asistent;AI;chat;
Keywords[lt]=asistentas;DI;pokalbis;
StartupNotify=true
Actions=vpn;

[Desktop Action vpn]
Name=Talk about a VPN
Name[uk]=Поговорити про VPN
Name[es]=Hablar sobre una VPN
Name[pl]=Porozmawiaj o VPN
Name[de]=Über ein VPN sprechen
Name[fr]=Parler d’un VPN
Name[it]=Parla di una VPN
Name[ro]=Vorbiți despre un VPN
Name[cs]=Promluvit si o VPN
Name[lt]=Pasikalbėti apie VPN
Exec=gloxi-gtk --vpn
