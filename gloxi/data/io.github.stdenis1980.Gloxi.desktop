# SPDX-License-Identifier: GPL-3.0-or-later
[Desktop Entry]
Type=Application
Name=Gloxi
Comment=AI assistant that acts only with your permission
Comment[uk]=AI-асистент, який діє лише з вашого дозволу
Comment[es]=Asistente de IA que solo actúa con tu permiso
Comment[pl]=Asystent AI, który działa tylko za twoją zgodą
Comment[de]=KI-Assistent, der nur mit Ihrer Erlaubnis handelt
Comment[fr]=Assistant IA qui n’agit qu’avec votre autorisation
Comment[it]=Assistente IA che agisce solo con il tuo permesso
Comment[ro]=Asistent AI care acționează doar cu permisiunea dumneavoastră
Comment[cs]=AI asistent, který jedná jen s vaším svolením
Comment[lt]=DI asistentas, veikiantis tik jums leidus
Exec=gloxi-gtk
Icon=io.github.stdenis1980.Gloxi
Terminal=false
Categories=Utility;GTK;
Keywords=assistant;AI;chat;
Keywords[uk]=асистент;ШІ;AI;чат;
Keywords[es]=asistente;IA;AI;chat;
Keywords[pl]=asystent;AI;SI;czat;
Keywords[de]=Assistent;KI;AI;Chat;
Keywords[fr]=assistant;IA;AI;discussion;chat;
Keywords[it]=assistente;IA;AI;chat;
Keywords[ro]=asistent;AI;IA;chat;
Keywords[cs]=asistent;AI;UI;chat;
Keywords[lt]=asistentas;DI;AI;pokalbis;
StartupNotify=true
