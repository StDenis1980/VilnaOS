msgid "Programs for Gloxi"
msgstr "Programas para Gloxi"

#: src/gloxi/gui/window.py
msgid "Report a problem or suggest something"
msgstr "Informar de un problema o sugerir algo"

#: src/gloxi/gui/window.py
msgid "Send"
msgstr "Enviar"

#: src/gloxi/gui/window.py
msgid "Stop sharing this folder"
msgstr "Dejar de compartir esta carpeta"

#: src/gloxi/programs.py
msgid "Off: Gloxi cannot use it"
msgstr "Desactivado: Gloxi no puede usarlo"

#: src/gloxi/programs.py
msgid "On"
msgstr "Activado"

#: src/gloxi/programs.py
msgid "On: starts when Herkos starts again"
msgstr "Activado: se inicia cuando Herkos se reinicie"

#: src/gloxi/programs.py
msgid "You turned this program on in Gloxi's settings"
msgstr "Activaste este programa en la configuración de Gloxi"

#: src/gloxi/router.py
msgid "Note: the cloud model changed some masked values, so they could not be put back. Check the answer before you use it."
msgstr "Atención: el modelo en la nube cambió algunos valores enmascarados, así que no se pudieron restaurar. Revisa la respuesta antes de usarla."

