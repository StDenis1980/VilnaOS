msgstr "{model} en {host}, datos privados enmascarados"

#: src/gloxi/gui/controller.py
#, python-brace-format
msgid "{model}, on this computer"
msgstr "{model}, en este ordenador"

#: src/gloxi/gui/window.py
msgid "Actions hidden from Gloxi"
msgstr "Acciones ocultas para Gloxi"

#: src/gloxi/gui/window.py
msgid "Add folder…"
msgstr "Añadir carpeta…"

#: src/gloxi/gui/window.py
msgid "Ask Gloxi… (/local or /cloud to pick the model)"
msgstr "Pregunta a Gloxi… (/local o /cloud para elegir el modelo)"

#: src/gloxi/gui/window.py
msgid "Choose a folder for Gloxi"
msgstr "Elige una carpeta para Gloxi"

#: src/gloxi/gui/window.py
msgid "Download"
msgstr "Descargar"

#: src/gloxi/gui/window.py
msgid "Download the language model?"
msgstr "¿Descargar el modelo de lenguaje?"

#: src/gloxi/gui/window.py
msgid "Folders Gloxi may use"
msgstr "Carpetas que Gloxi puede usar"

#: src/gloxi/gui/window.py
msgid "Gloxi can use only the programs you turn on here. Herkos asks you before turning one on, and every action still goes through it."
msgstr "Gloxi solo puede usar los programas que actives aquí. Herkos te pregunta antes de activar uno, y cada acción sigue pasando por Herkos."

#: src/gloxi/gui/window.py
msgid "Gloxi sees only the folders you choose here, and every action in them goes through Herkos, which asks you first."
msgstr "Gloxi solo ve las carpetas que elijas aquí, y cada acción en ellas pasa por Herkos, que te pregunta primero."

#: src/gloxi/gui/window.py
#, python-brace-format
msgid "Herkos could not change it: {why}"
msgstr "Herkos no pudo cambiarlo: {why}"

#: src/gloxi/gui/window.py
#, python-brace-format
msgid "Herkos could not restart: {why}"
msgstr "Herkos no pudo reiniciarse: {why}"

#: src/gloxi/gui/window.py
msgid "Herkos found something suspicious in how the program describes them."
msgstr "Herkos encontró algo sospechoso en cómo los describe el programa."

#: src/gloxi/gui/window.py
msgid "It starts the next time Herkos starts."
msgstr "Se inicia la próxima vez que se inicie Herkos."

#: src/gloxi/gui/window.py
msgid "Model"
msgstr "Modelo"

#: src/gloxi/gui/window.py
msgid "New conversation"
msgstr "Nueva conversación"

#: src/gloxi/gui/window.py
msgid "No folders yet: Gloxi cannot see any of your files."
msgstr "Aún no hay carpetas: Gloxi no puede ver ninguno de tus archivos."

#: src/gloxi/gui/window.py
msgid "No programs for Gloxi are installed."
msgstr "No hay programas para Gloxi instalados."

#: src/gloxi/gui/window.py
msgid "Not now"
msgstr "Ahora no"

#: src/gloxi/gui/window.py
msgid "Not turned on: you said no in the Herkos window."
msgstr "No activado: dijiste que no en la ventana de Herkos."

