#: src/gloxi/ai_notice.py
msgid "I am Gloxi, an AI assistant: a language model writes my answers, and they can be wrong."
msgstr "Soc Gloxi, un assistent d'IA: les meves respostes les escriu un model de llenguatge i poden ser errònies."

#: src/gloxi/ai_notice.py
msgid "Written by AI"
msgstr "Escrit per una IA"

#: src/gloxi/backup_intro.py
msgid "All right. I will ask once more in a week. You can also type /backup any time."
msgstr "D'acord. T'ho tornaré a preguntar d'aquí a una setmana. També pots escriure /backup quan vulguis."

#: src/gloxi/backup_intro.py
msgid "An external disk"
msgstr "Un disc extern"

#: src/gloxi/backup_intro.py
msgid "And Wi-Fi passwords, online accounts, SSH and GPG keys?"
msgstr "I les contrasenyes de la Wi-Fi, els comptes en línia i les claus SSH i GPG?"

#: src/gloxi/backup_intro.py src/gloxi/vpn_intro.py
#, python-brace-format
msgid "Choose a number from 1 to {n}."
msgstr "Tria un número de l'1 al {n}."

#: src/gloxi/backup_intro.py
msgid "Choose a number from the list, or type an amount in GB, e.g. 120"
msgstr "Tria un número de la llista o escriu una quantitat en GB, p. ex. 120"

#: src/gloxi/backup_intro.py
msgid "Choose myself"
msgstr "Triar-ho jo"

#: src/gloxi/backup_intro.py
msgid "Choose what goes into backups"
msgstr "Tria què entra a les còpies"

#: src/gloxi/backup_intro.py
msgid "Desktop"
msgstr "Escriptori"

#: src/gloxi/backup_intro.py
msgid "Documents"
msgstr "Documents"

#: src/gloxi/backup_intro.py
msgid "Downloads"
msgstr "Baixades"

#: src/gloxi/backup_intro.py
msgid "Dropbox, OneDrive, Google Drive"
msgstr "Dropbox, OneDrive, Google Drive"

#: src/gloxi/backup_intro.py
msgid "Every day, recommended"
msgstr "Cada dia, recomanat"

#: src/gloxi/backup_intro.py
msgid "Every hour"
msgstr "Cada hora"

#: src/gloxi/backup_intro.py
msgid "Every week"
msgstr "Cada setmana"

#: src/gloxi/backup_intro.py
msgid "Everything in the home folder"
msgstr "Tot el que hi ha a la carpeta personal"

#: src/gloxi/backup_intro.py
#, python-brace-format
msgid "Everything in the home folder, without caches and Downloads ({size})"
msgstr "Tot el que hi ha a la carpeta personal, sense memòria cau ni Baixades ({size})"

#: src/gloxi/backup_intro.py
msgid "Gloxi checks that the backup fits"
msgstr "Gloxi comprova que la còpia hi cap"

#: src/gloxi/backup_intro.py
msgid "Gloxi checks whether backups are set up"
msgstr "Gloxi comprova si les còpies estan configurades"

#: src/gloxi/backup_intro.py
msgid "Gloxi measures how much space your folders take"
msgstr "Gloxi mesura quant d'espai ocupen les teves carpetes"

#: src/gloxi/backup_intro.py
msgid ""
"Have your recovery sheet ready and run this in a terminal:\n"
"  vilna-backup recover <where the backups are>\n"
"Then: vilna-backup restore --in-place"
msgstr ""
"Tingues a mà el teu full de recuperació i executa això en un terminal:\n"
"  vilna-backup recover <on són les còpies>\n"
"Després: vilna-backup restore --in-place"

#: src/gloxi/backup_intro.py src/gloxi/vpn_intro.py
msgid "Herkos sent an answer Gloxi does not understand"
msgstr "Herkos ha enviat una resposta que Gloxi no entén"

#: src/gloxi/backup_intro.py src/gloxi/vpn_intro.py
msgid "Herkos, the permission service, is not available"
msgstr "Herkos, el servei de permisos, no està disponible"

#: src/gloxi/backup_intro.py
msgid "How much space are you ready to give to backups?"
msgstr "Quant d'espai vols dedicar a les còpies?"

#: src/gloxi/backup_intro.py
msgid "How often?"
msgstr "Amb quina freqüència?"

#: src/gloxi/backup_intro.py
#, python-brace-format
msgid "I could not continue: {why}. We can go on later: type /backup."
msgstr "No he pogut continuar: {why}. Podem seguir més tard: escriu /backup."

#: src/gloxi/backup_intro.py
msgid "I had Vilna before: restore from a backup"
msgstr "Ja tenia Vilna: restaura des d'una còpia"

#: src/gloxi/backup_intro.py
#, python-brace-format
msgid "I will back up {what} (about {size}) {how} {where}."
msgstr "Faré còpia de {what} (uns {size}) {how} {where}."

#: src/gloxi/backup_intro.py
msgid "Keep Gloxi conversations in backups"
msgstr "Inclou les converses amb Gloxi a les còpies"

#: src/gloxi/backup_intro.py
msgid "Keep your conversations with Gloxi in backups too?"
msgstr "Vols incloure també les teves converses amb Gloxi a les còpies?"

#: src/gloxi/backup_intro.py src/gloxi/vpn_intro.py
msgid "Later"
msgstr "Més tard"

#: src/gloxi/backup_intro.py
msgid "Leave large folders out of backups"
msgstr "Deixa les carpetes grans fora de les còpies"

#: src/gloxi/backup_intro.py
msgid "Leave out Gloxi history"
msgstr "Deixa fora l'historial de Gloxi"

#: src/gloxi/backup_intro.py
msgid "Music"
msgstr "Música"

#: src/gloxi/backup_intro.py
msgid "My own storage (S3, SFTP)"
msgstr "El meu propi emmagatzematge (S3, SFTP)"

#: src/gloxi/backup_intro.py src/gloxi/feedback.py src/gloxi/vpn_intro.py
msgid "No"
msgstr "No"

#: src/gloxi/backup_intro.py
msgid "No limit"
msgstr "Sense límit"

#: src/gloxi/backup_intro.py
msgid "No, I will give more space"
msgstr "No, donaré més espai"

#: src/gloxi/backup_intro.py
#, python-brace-format
msgid "Only settings ({size})"
msgstr "Només la configuració ({size})"

#: src/gloxi/backup_intro.py
msgid "Passwords and accounts are switched on by you only:"
msgstr "Les contrasenyes i els comptes només els actives tu:"

#: src/gloxi/backup_intro.py
msgid "Pictures"
msgstr "Imatges"

#: src/gloxi/backup_intro.py
msgid "Set how much space backups may take"
msgstr "Fixa quant d'espai poden ocupar les còpies"

#: src/gloxi/backup_intro.py
msgid "Set how often backups are made"
msgstr "Fixa cada quant es fan les còpies"

#: src/gloxi/backup_intro.py
#, python-brace-format
msgid "Settings and documents, recommended ({size})"
msgstr "Configuració i documents, recomanat ({size})"

#: src/gloxi/backup_intro.py
msgid "Settings are always kept. Which folders to add? Type their numbers, for example: 1 3"
msgstr "La configuració sempre es guarda. Quines carpetes hi afegeixo? Escriu-ne els números, per exemple: 1 3"

#: src/gloxi/backup_intro.py
msgid "Settings, passwords, Gloxi and Herkos"
msgstr "Configuració, contrasenyes, Gloxi i Herkos"

#: src/gloxi/backup_intro.py
msgid "Shall I keep backups of your data, so you do not lose it along with the computer?"
msgstr "Faig còpies de les teves dades perquè no les perdis juntament amb l'ordinador?"

#: src/gloxi/backup_intro.py
msgid "The Vilna cloud is not open yet in this preview. Choose another place."
msgstr "El núvol Vilna encara no està disponible en aquesta versió preliminar. Tria un altre lloc."

#: src/gloxi/backup_intro.py
msgid "The last step is yours, because it is about keys: run this in a terminal. It shows the recovery key once; write it on paper and keep it away from the computer. Without it, backups cannot be restored if this computer is lost. The first backup starts right after."
msgstr "L'últim pas és teu, perquè té a veure amb claus: executa això en un terminal. Mostra la clau de recuperació una sola vegada; anota-la en un paper i guarda-la lluny de l'ordinador. Sense ella, les còpies no es poden restaurar si perds aquest ordinador. La primera còpia comença just després."

#: src/gloxi/backup_intro.py
msgid "These are US companies: they see your account, the size and time of backups (not the contents), and a broken device could delete the backups. They are not in this preview yet. Choose another place."
msgstr "Són empreses dels EUA: veuen el teu compte, la mida i l'hora de les còpies (no el contingut), i un dispositiu compromès podria esborrar les còpies. Encara no són en aquesta versió preliminar. Tria un altre lloc."

#: src/gloxi/backup_intro.py
msgid "Type an amount in GB, e.g. 120"
msgstr "Escriu una quantitat en GB, p. ex. 120"

#: src/gloxi/backup_intro.py
msgid "Type the numbers of the folders, for example: 1 3"
msgstr "Escriu els números de les carpetes, per exemple: 1 3"

#: src/gloxi/backup_intro.py
msgid "Videos"
msgstr "Vídeos"

#: src/gloxi/backup_intro.py
msgid "Vilna cloud (EU)"
msgstr "Núvol Vilna (UE)"

#: src/gloxi/backup_intro.py
msgid "We are not talking about backups now."
msgstr "Ara no estem parlant de còpies."

#: src/gloxi/backup_intro.py
msgid "What shall we keep? This is how much space it takes now:"
msgstr "Què guardem? Això és el que ocupa ara:"

#: src/gloxi/backup_intro.py
msgid "Where shall we keep them? Everything is encrypted on this computer first."
msgstr "On les guardem? Primer tot es xifra en aquest ordinador."

#: src/gloxi/backup_intro.py src/gloxi/feedback.py
msgid "Yes"
msgstr "Sí"

#: src/gloxi/backup_intro.py
msgid "Yes, leave them out"
msgstr "Sí, deixa-les fora"

#: src/gloxi/backup_intro.py
msgid "every day"
msgstr "cada dia"

#: src/gloxi/backup_intro.py
msgid "every hour"
msgstr "cada hora"

#: src/gloxi/backup_intro.py
msgid "every week"
msgstr "cada setmana"

#: src/gloxi/backup_intro.py
msgid "everything in the home folder"
msgstr "tot el que hi ha a la carpeta personal"

#: src/gloxi/backup_intro.py
msgid "in your own storage"
msgstr "al teu propi emmagatzematge"

#: src/gloxi/backup_intro.py
msgid "no"
msgstr "no"

#: src/gloxi/backup_intro.py
msgid "on the external disk"
msgstr "al disc extern"

#: src/gloxi/backup_intro.py
msgid "settings"
msgstr "la configuració"

#: src/gloxi/backup_intro.py
msgid "settings and documents"
msgstr "la configuració i els documents"

#: src/gloxi/backup_intro.py
msgid "settings and the folders you chose"
msgstr "la configuració i les carpetes que has triat"

#: src/gloxi/backup_intro.py src/gloxi/cli.py src/gloxi/voice/cli.py
msgid "yes"
msgstr "sí"

#: src/gloxi/backup_intro.py
#, python-brace-format
msgid ""
"{size} does not fit into {limit}. Leave out these large folders (about {after} remains)?\n"
"{folders}"
msgstr ""
"{size} no hi cap en {limit}. Deixo fora aquestes carpetes grans (en quedarien uns {after})?\n"
"{folders}"

#: src/gloxi/backup_intro.py
#, python-brace-format
msgid "{size} does not fit. Choose a larger amount."
msgstr "{size} no hi cap. Tria una quantitat més gran."

#: src/gloxi/check.py
msgid "Could not read the memory size; the local model may still work."
msgstr "No s'ha pogut llegir la mida de la memòria; potser el model local funciona igualment."

#: src/gloxi/check.py
#, python-brace-format
msgid "Free disk space: {free}. The model needs {size}."
msgstr "Espai lliure al disc: {free}. El model necessita {size}."

#: src/gloxi/check.py
#, python-brace-format
msgid "Gloxi starts {large} because its file is in the models folder, but the speed test has not shown that it is fast enough here. To go back to {small}, delete {file} from {folder}."
msgstr "Gloxi inicia {large} perquè el seu fitxer és a la carpeta de models, però la prova de velocitat no ha demostrat que sigui prou ràpid aquí. Per tornar a {small}, esborra {file} de {folder}."

#: src/gloxi/check.py
#, python-brace-format
msgid "Memory: {ram}. The local model needs at least 8 GB; Gloxi can still answer through the cloud with your own key."
msgstr "Memòria: {ram}. El model local necessita com a mínim 8 GB; Gloxi encara pot respondre a través del núvol amb la teva pròpia clau."

#: src/gloxi/check.py
msgid "The processor has no AVX2 (it is older than Intel Core 8th generation or Ryzen 2000), so the local model will be slow."
msgstr "El processador no té AVX2 (és anterior als Intel Core de 8a generació o als Ryzen 2000), així que el model local anirà lent."

#: src/gloxi/check.py
#, python-brace-format
msgid "This computer can run {name}."
msgstr "Aquest ordinador pot executar {name}."

#: src/gloxi/check.py
#, python-brace-format
msgid "This computer can run {name}. Gloxi will measure once whether the larger model would be fast enough."
msgstr "Aquest ordinador pot executar {name}. Gloxi mesurarà una vegada si el model més gran seria prou ràpid."

#: src/gloxi/check.py
msgid "This computer is below the minimum for the local model."
msgstr "Aquest ordinador està per sota del mínim per al model local."

#: src/gloxi/check.py
#, python-brace-format
msgid "This computer is fast enough for the larger model, {name}."
msgstr "Aquest ordinador és prou ràpid per al model més gran, {name}."

#: src/gloxi/check.py
msgid "To paste into the feedback form:"
msgstr "Per enganxar al formulari d'opinió:"

#: src/gloxi/cli.py
msgid "(interrupted)"
msgstr "(interromput)"

#: src/gloxi/cli.py src/gloxi/gui/controller.py
msgid "Backups need Herkos, and it is not running."
msgstr "Les còpies necessiten Herkos, i no està en marxa."

#: src/gloxi/cli.py src/gloxi/gui/controller.py
msgid "Checking how fast this computer runs the model (about a minute)…"
msgstr "S'està comprovant com de ràpid executa el model aquest ordinador (cosa d'un minut)…"

#: src/gloxi/cli.py
msgid "Cloud: off. Everything stays on this computer."
msgstr "Núvol: desactivat. Tot es queda en aquest ordinador."

#: src/gloxi/cli.py
#, python-brace-format
msgid "Cloud: on ({mode} mode)."
msgstr "Núvol: activat (mode {mode})."

#: src/gloxi/cli.py
msgid "Commands: /local <text> or /cloud <text> picks the model for one message, /reset clears the conversation, /backup sets up backups, /vpn sets up a VPN, /feedback reports a problem or suggests something, /exit quits."
msgstr "Ordres: /local <text> o /cloud <text> tria el model per a un missatge, /reset esborra la conversa, /backup configura les còpies de seguretat, /vpn configura una VPN, /feedback informa d'un problema o suggereix alguna cosa, /exit surt."

#: src/gloxi/cli.py
msgid "Conversation cleared."
msgstr "S'ha esborrat la conversa."

#: src/gloxi/cli.py src/gloxi/voice/cli.py
msgid "Download it now? [y/N] "
msgstr "El vols baixar ara? [s/N] "

#: src/gloxi/cli.py src/gloxi/gui/controller.py
#, python-brace-format
msgid "Downloading the model: {percent}%"
msgstr "S'està baixant el model: {percent} %"

#: src/gloxi/cli.py src/gloxi/gui/controller.py
msgid "Gloxi keeps the current model and will not ask again."
msgstr "Gloxi manté el model actual i no ho tornarà a preguntar."

#: src/gloxi/cli.py
#, python-brace-format
msgid "Gloxi needs a language model on this computer to answer. It is {name}, {size}, licence {licence}, from {source}. It will be kept in {folder}. Only the file is downloaded: nothing about you is sent."
msgstr "Per respondre, Gloxi necessita un model de llenguatge en aquest ordinador. És {name}, {size}, llicència {licence}, de {source}. Es guardarà a {folder}. Només es baixa el fitxer: no s'envia res sobre tu."

#: src/gloxi/cli.py
msgid ""
"Is llama-server running? For example:\n"
"  llama-server -m model.gguf --port 8080\n"
"or point Gloxi elsewhere with GLOXI_LOCAL_URL."
msgstr ""
"Està en marxa llama-server? Per exemple:\n"
"  llama-server -m model.gguf --port 8080\n"
"o indica a Gloxi una altra adreça amb GLOXI_LOCAL_URL."

#: src/gloxi/cli.py src/gloxi/gui/controller.py
msgid "Not downloaded. Gloxi will ask again next time."
msgstr "No s'ha baixat. Gloxi ho tornarà a preguntar la pròxima vegada."

#: src/gloxi/cli.py
msgid "Note: masking is off (mask_cloud = false), so messages sent to the cloud are NOT masked."
msgstr "Atenció: l'emmascarament està desactivat (mask_cloud = false), així que els missatges enviats al núvol NO s'emmascaren."

#: src/gloxi/cli.py
#, python-brace-format
msgid "Open the app: {app}"
msgstr "Obre l'aplicació: {app}"

#: src/gloxi/cli.py src/gloxi/gui/controller.py
#, python-brace-format
msgid "Starting {name} on this computer…"
msgstr "S'està iniciant {name} en aquest ordinador…"

#: src/gloxi/cli.py src/gloxi/gui/controller.py
msgid "The VPN needs Vilna and Herkos, and Herkos is not running."
msgstr "La VPN necessita Vilna i Herkos, i Herkos no està en marxa."

#: src/gloxi/cli.py src/gloxi/gui/controller.py
#, python-brace-format
msgid "The model could not be started: {why}"
msgstr "No s'ha pogut iniciar el model: {why}"

#: src/gloxi/cli.py
msgid "The model is ready."
msgstr "El model està llest."

#: src/gloxi/cli.py src/gloxi/gui/controller.py
msgid "The model is ready. Gloxi will use it from the next start."
msgstr "El model està llest. Gloxi el farà servir a partir del pròxim inici."

#: src/gloxi/cli.py src/gloxi/gui/controller.py
#, python-brace-format
msgid "The model was not downloaded: {why}"
msgstr "No s'ha baixat el model: {why}"

#: src/gloxi/cli.py
msgid "There is no language model yet. Run gloxi in a terminal once to download it."
msgstr "Encara no hi ha cap model de llenguatge. Executa gloxi una vegada en un terminal per baixar-lo."

#: src/gloxi/cli.py
#, python-brace-format
msgid "This computer is fast enough for a better model: {name}, {size}, licence {licence}, from {source}. It answers better, in Ukrainian too; Gloxi expects about {speed} tokens per second here. It will be kept in {folder}, next to the current model, and Gloxi will use it from the next start. Only the file is downloaded: nothing about you is sent."
msgstr "Aquest ordinador és prou ràpid per a un model millor: {name}, {size}, llicència {licence}, de {source}. Respon millor, també en ucraïnès; aquí Gloxi espera uns {speed} tokens per segon. Es guardarà a {folder}, al costat del model actual, i Gloxi el farà servir a partir del pròxim inici. Només es baixa el fitxer: no s'envia res sobre tu."

#: src/gloxi/cli.py
msgid "Without a language model Gloxi cannot answer. Run gloxi again when you want to download it."
msgstr "Sense un model de llenguatge, Gloxi no pot respondre. Torna a executar gloxi quan el vulguis baixar."

#: src/gloxi/cli.py
#, python-brace-format
msgid "[cloud: {host}, masked]"
msgstr "[núvol: {host}, emmascarat]"

#: src/gloxi/cli.py
#, python-brace-format
msgid "[cloud: {host}, not masked]"
msgstr "[núvol: {host}, sense emmascarar]"

#: src/gloxi/cli.py
msgid "[local]"
msgstr "[local]"

#: src/gloxi/engine.py
msgid "."
msgstr ","

#: src/gloxi/engine.py
msgid "Google on Hugging Face"
msgstr "Google a Hugging Face"

#: src/gloxi/engine.py
msgid "Mistral AI on Hugging Face"
msgstr "Mistral AI a Hugging Face"

#: src/gloxi/engine.py
msgid "Qwen (Alibaba Cloud) on Hugging Face"
msgstr "Qwen (Alibaba Cloud) a Hugging Face"

#: src/gloxi/engine.py
msgid "the model"
msgstr "el model"

#: src/gloxi/engine.py
#, python-brace-format
msgid "{value} GB"
msgstr "{value} GB"

#: src/gloxi/engine.py
#, python-brace-format
msgid "{value} MB"
msgstr "{value} MB"

#: src/gloxi/feedback.py
msgid "A suggestion"
msgstr "Un suggeriment"

#: src/gloxi/feedback.py
msgid "About this computer:"
msgstr "Sobre aquest ordinador:"

#: src/gloxi/feedback.py
msgid "All right, nothing was sent."
msgstr "D'acord, no s'ha enviat res."

#: src/gloxi/feedback.py src/gloxi/gui/window.py
msgid "Cancel"
msgstr "Cancel·la"

#: src/gloxi/feedback.py
msgid "Crash report:"
msgstr "Informe de fallada:"

#: src/gloxi/feedback.py
msgid "Expected:"
msgstr "Esperat:"

#: src/gloxi/feedback.py
msgid "Gloxi stopped with an error recently. Add that crash report?"
msgstr "Fa poc Gloxi s'ha aturat amb un error. Hi afegeixo aquell informe de fallada?"

#: src/gloxi/feedback.py
#, python-brace-format
msgid "Hidden before showing it here: {what}."
msgstr "S'ha amagat abans de mostrar-ho aquí: {what}."

#: src/gloxi/feedback.py
msgid "May I add what this computer is (system, processor, memory, graphics, models), as gloxi check shows it? Nothing personal."
msgstr "Puc afegir quin ordinador és aquest (sistema, processador, memòria, gràfics, models), tal com ho mostra gloxi check? Res personal."

#: src/gloxi/feedback.py
msgid "Never mind"
msgstr "Deixa-ho"

#: src/gloxi/feedback.py
msgid "Open the form"
msgstr "Obre el formulari"

#: src/gloxi/feedback.py
#, python-brace-format
msgid "Opening the form in your browser. Thank you! If it does not open: {url}"
msgstr "S'està obrint el formulari al navegador. Gràcies! Si no s'obre: {url}"

#: src/gloxi/feedback.py
msgid "Please answer 1 or 2."
msgstr "Respon 1 o 2."

#: src/gloxi/feedback.py
msgid "Please answer 1, 2 or 3."
msgstr "Respon 1, 2 o 3."

#: src/gloxi/feedback.py
msgid "Please write a few words, or /cancel to stop."
msgstr "Escriu unes paraules, o /cancel per aturar."

#: src/gloxi/feedback.py src/gloxi/gui/panel.py
msgid "Something went wrong"
msgstr "Alguna cosa ha anat malament"

#: src/gloxi/feedback.py
msgid "Suggestion:"
msgstr "Suggeriment:"

#: src/gloxi/feedback.py
msgid "This is public: anyone can read it on GitHub, and you need a GitHub account to send it. The form opens in your browser, where you can still change everything; it is sent only when you press Create there."
msgstr "Això és públic: qualsevol ho pot llegir a GitHub, i necessites un compte de GitHub per enviar-ho. El formulari s'obre al navegador, on encara ho pots canviar tot; només s'envia quan hi prems Create."

#: src/gloxi/feedback.py
#, python-brace-format
msgid "This sounds like a security problem. Please do not post it publicly: report it privately at {url}"
msgstr "Sembla un problema de seguretat. No el publiquis: informa'n en privat a {url}"

#: src/gloxi/feedback.py
msgid "Title:"
msgstr "Títol:"

#: src/gloxi/feedback.py
msgid "What did you do or ask, and what happened?"
msgstr "Què has fet o demanat, i què ha passat?"

#: src/gloxi/feedback.py
msgid "What did you expect instead? (Enter to skip)"
msgstr "Què esperaves que passés? (Retorn per ometre)"

#: src/gloxi/feedback.py
msgid "What happened:"
msgstr "Què ha passat:"

#: src/gloxi/feedback.py
msgid "What would you like to tell us?"
msgstr "Què ens vols explicar?"

#: src/gloxi/feedback.py
msgid "What would you suggest? A sentence or two is enough."
msgstr "Què suggereixes? N'hi ha prou amb una o dues frases."

#: src/gloxi/feedback.py
msgid "a card number"
msgstr "un número de targeta"

#: src/gloxi/feedback.py
msgid "a date of birth"
msgstr "una data de naixement"

#: src/gloxi/feedback.py
msgid "a name"
msgstr "un nom"

#: src/gloxi/feedback.py
msgid "a passport number"
msgstr "un número de passaport"

