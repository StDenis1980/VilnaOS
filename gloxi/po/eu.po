#: src/gloxi/voice/session.py
#, python-brace-format
msgid "Voice could not be started: {why}"
msgstr "Ezin izan da ahotsa abiarazi: {why}"

#: src/gloxi/voice/session.py
msgid "Voices"
msgstr "Ahotsak"

#: src/gloxi/voice/session.py
#, python-brace-format
msgid "• {what}: {name}, {size}, {licence}, {source}"
msgstr "• {what}: {name}, {size}, {licence}, {source}"

#: src/gloxi/voice/speech.py
msgid "The code is on the screen."
msgstr "Kodea pantailan dago."

#: src/gloxi/voice/speech.py
msgid "link"
msgstr "esteka"

#: src/gloxi/voice/speech.py
msgid "password hidden"
msgstr "pasahitza ezkutatuta"

#: src/gloxi/vpn_intro.py
msgid "All right. I will ask once more in a week. You can also type /vpn any time."
msgstr "Ados. Astebete barru galdetuko dizut berriro. /vpn ere idatz dezakezu nahi duzunean."

#: src/gloxi/vpn_intro.py
msgid "All right. Type /vpn when you want to go on."
msgstr "Ados. Idatzi /vpn jarraitu nahi duzunean."

#: src/gloxi/vpn_intro.py
msgid "Connected"
msgstr "Konektatuta"

#: src/gloxi/vpn_intro.py
msgid "Create a free Proton account (5 countries, 1 device)"
msgstr "Sortu doako Proton kontu bat (5 herrialde, gailu 1)"

#: src/gloxi/vpn_intro.py
msgid "Gloxi checks whether a VPN protects this computer"
msgstr "Gloxik egiaztatzen du VPN batek ordenagailu hau babesten duen"

#: src/gloxi/vpn_intro.py
msgid "Gloxi checks whether the VPN is connected"
msgstr "Gloxik egiaztatzen du VPNa konektatuta dagoen"

#: src/gloxi/vpn_intro.py
msgid "I am opening Proton's sign-up page. You can create the account with a Proton address, without another email. Then sign in in the Proton VPN app that I open next, press Connect and tell me when it is connected."
msgstr "Protonen izen-emate orria irekitzen ari naiz. Kontua Proton helbide batekin sor dezakezu, beste posta elektronikorik gabe. Gero hasi saioa jarraian irekiko dudan Proton VPN aplikazioan, sakatu «Connect» eta esan iezadazu konektatuta dagoenean."

#: src/gloxi/vpn_intro.py
msgid "I am opening the Mullvad app. Enter your account number or activation code there, not here: I do not see it and do not keep it. Then press Connect and tell me when it is connected."
msgstr "Mullvad aplikazioa irekitzen ari naiz. Idatzi han zure kontu-zenbakia edo aktibazio-kodea, ez hemen: nik ez dut ikusten ez gordetzen. Gero sakatu «Connect» eta esan iezadazu konektatuta dagoenean."

#: src/gloxi/vpn_intro.py
msgid "I am opening the Proton VPN app. Sign in there, not here: I do not see your password. Then press Connect and tell me when it is connected."
msgstr "Proton VPN aplikazioa irekitzen ari naiz. Hasi saioa han, ez hemen: nik ez dut zure pasahitza ikusten. Gero sakatu «Connect» eta esan iezadazu konektatuta dagoenean."

#: src/gloxi/vpn_intro.py
#, python-brace-format
msgid "I could not continue: {why}. We can go on later: type /vpn."
msgstr "Ezin izan dut jarraitu: {why}. Geroago jarrai dezakegu: idatzi /vpn."

#: src/gloxi/vpn_intro.py
msgid "I do not see a VPN connection yet. Press Connect in the app, wait a few seconds and tell me again."
msgstr "Oraindik ez dut VPN konexiorik ikusten. Sakatu «Connect» aplikazioan, itxaron segundo batzuk eta esan berriro."

#: src/gloxi/vpn_intro.py
msgid "I have a Mullvad account number or code"
msgstr "Mullvad kontu-zenbaki edo kode bat daukat"

#: src/gloxi/vpn_intro.py
msgid "One more step in the Mullvad app: in its settings turn on “Auto-connect”, so the VPN comes up by itself."
msgstr "Urrats bat gehiago Mullvad aplikazioan: bere ezarpenetan aktibatu «Auto-connect» (konexio automatikoa), VPNa bere kabuz aktiba dadin."

#: src/gloxi/vpn_intro.py
msgid "One more step in the Proton VPN app: in its settings turn on “Connect at startup”, so the VPN comes up by itself."
msgstr "Urrats bat gehiago Proton VPN aplikazioan: bere ezarpenetan aktibatu «Connect at startup» (konektatu abiaraztean), VPNa bere kabuz aktiba dadin."

#: src/gloxi/vpn_intro.py
msgid "Sign in to Proton VPN"
msgstr "Hasi saioa Proton VPN-n"

#: src/gloxi/vpn_intro.py
msgid "Start Mullvad VPN and keep its service on after a restart"
msgstr "Abiarazi Mullvad VPN eta mantendu bere zerbitzua aktibo berrabiarazi ondoren"

#: src/gloxi/vpn_intro.py
msgid "The VPN is connected. Shall I turn on the kill switch? Then nothing leaves this computer outside the VPN: if the VPN drops, the internet stops until it is back. Turning it off later always asks you first."
msgstr "VPNa konektatuta dago. Larrialdiko etengailua aktibatuko dut? Horrela ez da ezer aterako ordenagailu honetatik VPNtik kanpo: VPNa erortzen bada, internet gelditu egingo da itzuli arte. Geroago desaktibatzeko beti galdetuko dizut lehenik."

#: src/gloxi/vpn_intro.py
msgid "The kill switch is on."
msgstr "Larrialdiko etengailua aktibatuta dago."

#: src/gloxi/vpn_intro.py
msgid "The kill switch stays off. You can turn it on any time: type /vpn."
msgstr "Larrialdiko etengailua desaktibatuta dago oraindik. Nahi duzunean aktiba dezakezu: idatzi /vpn."

#: src/gloxi/vpn_intro.py
msgid "Turn on the VPN kill switch"
msgstr "Aktibatu VPNaren larrialdiko etengailua"

#: src/gloxi/vpn_intro.py
msgid "We are not talking about a VPN now."
msgstr "Orain ez gara VPN bati buruz ari."

#: src/gloxi/vpn_intro.py
msgid "Yes, recommended"
msgstr "Bai, gomendatua"

#: src/gloxi/vpn_intro.py
msgid "You chose this while installing Vilna."
msgstr "Hau aukeratu zenuen Vilna instalatzean."

#: src/gloxi/vpn_intro.py
msgid "Your connection is already protected: Vilna encrypts DNS, so the network you are on does not see which sites you look up. Do you want even more protection with a VPN? It also hides the rest of your traffic from that network (a cafe, a hotel) and your address from websites. The VPN provider sees where you go, so I only suggest proven ones."
msgstr "Zure konexioa babestuta dago jada: Vilnak DNSa zifratzen du, beraz zauden sareak ez du ikusten zein gune bilatzen dituzun. Babes gehiago nahi duzu VPN batekin? Zure gainerako trafikoa ere ezkutatzen dio sare horri (kafetegi bat, hotel bat), eta zure helbidea webguneei. VPN hornitzaileak ikusten du nora zoazen; horregatik, konfiantza frogatuko hornitzaileak soilik proposatzen dizkizut."
