#: src/gloxi/ai_notice.py
msgid "I am Gloxi, an AI assistant: a language model writes my answers, and they can be wrong."
msgstr "Gloxi naiz, AA laguntzailea: hizkuntza-eredu batek idazten ditu nire erantzunak, eta okerrak izan daitezke."

#: src/gloxi/ai_notice.py
msgid "Written by AI"
msgstr "AAk idatzia"

#: src/gloxi/backup_intro.py
msgid "All right. I will ask once more in a week. You can also type /backup any time."
msgstr "Ados. Astebete barru galdetuko dizut berriro. /backup ere idatz dezakezu nahi duzunean."

#: src/gloxi/backup_intro.py
msgid "An external disk"
msgstr "Kanpoko disko bat"

#: src/gloxi/backup_intro.py
msgid "And Wi-Fi passwords, online accounts, SSH and GPG keys?"
msgstr "Eta Wi-Fi pasahitzak, lineako kontuak eta SSH eta GPG gakoak?"

#: src/gloxi/backup_intro.py src/gloxi/vpn_intro.py
#, python-brace-format
msgid "Choose a number from 1 to {n}."
msgstr "Aukeratu zenbaki bat, 1etik {n}ra."

#: src/gloxi/backup_intro.py
msgid "Choose a number from the list, or type an amount in GB, e.g. 120"
msgstr "Aukeratu zerrendako zenbaki bat, edo idatzi kopuru bat GBtan, adib. 120"

#: src/gloxi/backup_intro.py
msgid "Choose myself"
msgstr "Neuk aukeratu"

#: src/gloxi/backup_intro.py
msgid "Choose what goes into backups"
msgstr "Aukeratu zer sartzen den babeskopietan"

#: src/gloxi/backup_intro.py
msgid "Desktop"
msgstr "Mahaigaina"

#: src/gloxi/backup_intro.py
msgid "Documents"
msgstr "Dokumentuak"

#: src/gloxi/backup_intro.py
msgid "Downloads"
msgstr "Deskargak"

#: src/gloxi/backup_intro.py
msgid "Dropbox, OneDrive, Google Drive"
msgstr "Dropbox, OneDrive, Google Drive"

#: src/gloxi/backup_intro.py
msgid "Every day, recommended"
msgstr "Egunero, gomendatua"

#: src/gloxi/backup_intro.py
msgid "Every hour"
msgstr "Orduro"

#: src/gloxi/backup_intro.py
msgid "Every week"
msgstr "Astero"

#: src/gloxi/backup_intro.py
msgid "Everything in the home folder"
msgstr "Karpeta pertsonaleko guztia"

#: src/gloxi/backup_intro.py
#, python-brace-format
msgid "Everything in the home folder, without caches and Downloads ({size})"
msgstr "Karpeta pertsonaleko guztia, cacherik eta Deskargarik gabe ({size})"

#: src/gloxi/backup_intro.py
msgid "Gloxi checks that the backup fits"
msgstr "Gloxik egiaztatzen du babeskopia sartzen dela"

#: src/gloxi/backup_intro.py
msgid "Gloxi checks whether backups are set up"
msgstr "Gloxik egiaztatzen du babeskopiak konfiguratuta dauden"

#: src/gloxi/backup_intro.py
msgid "Gloxi measures how much space your folders take"
msgstr "Gloxik neurtzen du zure karpetek zenbat leku hartzen duten"

#: src/gloxi/backup_intro.py
msgid ""
"Have your recovery sheet ready and run this in a terminal:\n"
"  vilna-backup recover <where the backups are>\n"
"Then: vilna-backup restore --in-place"
msgstr ""
"Izan eskura zure berreskuratze-orria, eta exekutatu hau terminal batean:\n"
"  vilna-backup recover <babeskopiak non dauden>\n"
"Gero: vilna-backup restore --in-place"

#: src/gloxi/backup_intro.py src/gloxi/vpn_intro.py
msgid "Herkos sent an answer Gloxi does not understand"
msgstr "Herkosek Gloxik ulertzen ez duen erantzun bat bidali du"

#: src/gloxi/backup_intro.py src/gloxi/vpn_intro.py
msgid "Herkos, the permission service, is not available"
msgstr "Herkos, baimen-zerbitzua, ez dago erabilgarri"

#: src/gloxi/backup_intro.py
msgid "How much space are you ready to give to backups?"
msgstr "Zenbat leku eman nahi diezu babeskopiei?"

#: src/gloxi/backup_intro.py
msgid "How often?"
msgstr "Zein maiztasunez?"

#: src/gloxi/backup_intro.py
#, python-brace-format
msgid "I could not continue: {why}. We can go on later: type /backup."
msgstr "Ezin izan dut jarraitu: {why}. Geroago jarrai dezakegu: idatzi /backup."

#: src/gloxi/backup_intro.py
msgid "I had Vilna before: restore from a backup"
msgstr "Lehen ere Vilna nuen: leheneratu babeskopia batetik"

#: src/gloxi/backup_intro.py
#, python-brace-format
msgid "I will back up {what} (about {size}) {how} {where}."
msgstr "{what} babeskopia egingo dut (gutxi gorabehera {size}) {how} {where}."

#: src/gloxi/backup_intro.py
msgid "Keep Gloxi conversations in backups"
msgstr "Sartu Gloxirekin izandako elkarrizketak babeskopietan"

#: src/gloxi/backup_intro.py
msgid "Keep your conversations with Gloxi in backups too?"
msgstr "Gloxirekin izandako zure elkarrizketak ere sartu babeskopietan?"

#: src/gloxi/backup_intro.py src/gloxi/vpn_intro.py
msgid "Later"
msgstr "Geroago"

#: src/gloxi/backup_intro.py
msgid "Leave large folders out of backups"
msgstr "Utzi karpeta handiak babeskopietatik kanpo"

#: src/gloxi/backup_intro.py
msgid "Leave out Gloxi history"
msgstr "Utzi kanpo Gloxiren historia"

#: src/gloxi/backup_intro.py
msgid "Music"
msgstr "Musika"

#: src/gloxi/backup_intro.py
msgid "My own storage (S3, SFTP)"
msgstr "Nire biltegiratze propioa (S3, SFTP)"

#: src/gloxi/backup_intro.py src/gloxi/feedback.py src/gloxi/vpn_intro.py
msgid "No"
msgstr "Ez"

#: src/gloxi/backup_intro.py
msgid "No limit"
msgstr "Mugarik gabe"

#: src/gloxi/backup_intro.py
msgid "No, I will give more space"
msgstr "Ez, leku gehiago emango dut"

#: src/gloxi/backup_intro.py
#, python-brace-format
msgid "Only settings ({size})"
msgstr "Ezarpenak soilik ({size})"

#: src/gloxi/backup_intro.py
msgid "Passwords and accounts are switched on by you only:"
msgstr "Pasahitzak eta kontuak zuk bakarrik aktibatzen dituzu:"

#: src/gloxi/backup_intro.py
msgid "Pictures"
msgstr "Irudiak"

#: src/gloxi/backup_intro.py
msgid "Set how much space backups may take"
msgstr "Ezarri babeskopiek zenbat leku har dezaketen"

#: src/gloxi/backup_intro.py
msgid "Set how often backups are made"
msgstr "Ezarri babeskopiak zein maiztasunez egiten diren"

#: src/gloxi/backup_intro.py
#, python-brace-format
msgid "Settings and documents, recommended ({size})"
msgstr "Ezarpenak eta dokumentuak, gomendatua ({size})"

#: src/gloxi/backup_intro.py
msgid "Settings are always kept. Which folders to add? Type their numbers, for example: 1 3"
msgstr "Ezarpenak beti gordetzen dira. Zein karpeta gehituko ditut? Idatzi haien zenbakiak, adibidez: 1 3"

#: src/gloxi/backup_intro.py
msgid "Settings, passwords, Gloxi and Herkos"
msgstr "Ezarpenak, pasahitzak, Gloxi eta Herkos"

#: src/gloxi/backup_intro.py
msgid "Shall I keep backups of your data, so you do not lose it along with the computer?"
msgstr "Zure datuen babeskopiak egingo ditut, ordenagailuarekin batera ez galtzeko?"

#: src/gloxi/backup_intro.py
msgid "The Vilna cloud is not open yet in this preview. Choose another place."
msgstr "Vilna hodeia ez dago oraindik erabilgarri aurrebista honetan. Aukeratu beste leku bat."

#: src/gloxi/backup_intro.py
msgid "The last step is yours, because it is about keys: run this in a terminal. It shows the recovery key once; write it on paper and keep it away from the computer. Without it, backups cannot be restored if this computer is lost. The first backup starts right after."
msgstr "Azken urratsa zurea da, gakoei buruzkoa delako: exekutatu hau terminal batean. Berreskuratze-gakoa behin bakarrik erakusten du; idatzi paper batean eta gorde ordenagailutik urrun. Hura gabe, babeskopiak ezin dira leheneratu ordenagailu hau galtzen baduzu. Lehen babeskopia berehala hasten da."

#: src/gloxi/backup_intro.py
msgid "These are US companies: they see your account, the size and time of backups (not the contents), and a broken device could delete the backups. They are not in this preview yet. Choose another place."
msgstr "AEBetako enpresak dira: zure kontua, babeskopien tamaina eta ordua ikusten dituzte (ez edukia), eta arriskuan dagoen gailu batek babeskopiak ezaba litzake. Oraindik ez daude aurrebista honetan. Aukeratu beste leku bat."

#: src/gloxi/backup_intro.py
msgid "Type an amount in GB, e.g. 120"
msgstr "Idatzi kopuru bat GBtan, adib. 120"

#: src/gloxi/backup_intro.py
msgid "Type the numbers of the folders, for example: 1 3"
msgstr "Idatzi karpeten zenbakiak, adibidez: 1 3"

#: src/gloxi/backup_intro.py
msgid "Videos"
msgstr "Bideoak"

#: src/gloxi/backup_intro.py
msgid "Vilna cloud (EU)"
msgstr "Vilna hodeia (EB)"

#: src/gloxi/backup_intro.py
msgid "We are not talking about backups now."
msgstr "Orain ez gara babeskopiez ari."

#: src/gloxi/backup_intro.py
msgid "What shall we keep? This is how much space it takes now:"
msgstr "Zer gordeko dugu? Hau da orain hartzen duen lekua:"

#: src/gloxi/backup_intro.py
msgid "Where shall we keep them? Everything is encrypted on this computer first."
msgstr "Non gordeko ditugu? Dena ordenagailu honetan zifratzen da lehenik."

#: src/gloxi/backup_intro.py src/gloxi/feedback.py
msgid "Yes"
msgstr "Bai"

#: src/gloxi/backup_intro.py
msgid "Yes, leave them out"
msgstr "Bai, utzi kanpoan"

#: src/gloxi/backup_intro.py
msgid "every day"
msgstr "egunero"

#: src/gloxi/backup_intro.py
msgid "every hour"
msgstr "orduro"

#: src/gloxi/backup_intro.py
msgid "every week"
msgstr "astero"

#: src/gloxi/backup_intro.py
msgid "everything in the home folder"
msgstr "karpeta pertsonaleko guztia"

#: src/gloxi/backup_intro.py
msgid "in your own storage"
msgstr "zure biltegiratze propioan"

#: src/gloxi/backup_intro.py
msgid "no"
msgstr "ez"

#: src/gloxi/backup_intro.py
msgid "on the external disk"
msgstr "kanpoko diskoan"

#: src/gloxi/backup_intro.py
msgid "settings"
msgstr "ezarpenak"

#: src/gloxi/backup_intro.py
msgid "settings and documents"
msgstr "ezarpenak eta dokumentuak"

#: src/gloxi/backup_intro.py
msgid "settings and the folders you chose"
msgstr "ezarpenak eta aukeratu dituzun karpetak"

#: src/gloxi/backup_intro.py src/gloxi/cli.py src/gloxi/voice/cli.py
msgid "yes"
msgstr "bai"

#: src/gloxi/backup_intro.py
#, python-brace-format
msgid ""
"{size} does not fit into {limit}. Leave out these large folders (about {after} remains)?\n"
"{folders}"
msgstr ""
"{size} ez da sartzen {limit}(e)n. Karpeta handi hauek kanpoan utziko ditut (gutxi gorabehera {after} geratuko litzateke)?\n"
"{folders}"

#: src/gloxi/backup_intro.py
#, python-brace-format
msgid "{size} does not fit. Choose a larger amount."
msgstr "{size} ez da sartzen. Aukeratu kopuru handiago bat."

#: src/gloxi/check.py
msgid "Could not read the memory size; the local model may still work."
msgstr "Ezin izan da memoriaren tamaina irakurri; baliteke tokiko ereduak hala ere funtzionatzea."

#: src/gloxi/check.py
#, python-brace-format
msgid "Free disk space: {free}. The model needs {size}."
msgstr "Leku librea diskoan: {free}. Ereduak {size} behar ditu."

#: src/gloxi/check.py
#, python-brace-format
msgid "Gloxi starts {large} because its file is in the models folder, but the speed test has not shown that it is fast enough here. To go back to {small}, delete {file} from {folder}."
msgstr "Gloxik {large} abiarazten du bere fitxategia ereduen karpetan dagoelako, baina abiadura-probak ez du erakutsi hemen behar bezain azkarra denik. {small} eredura itzultzeko, ezabatu {file} {folder} karpetatik."

#: src/gloxi/check.py
#, python-brace-format
msgid "Memory: {ram}. The local model needs at least 8 GB; Gloxi can still answer through the cloud with your own key."
msgstr "Memoria: {ram}. Tokiko ereduak gutxienez 8 GB behar ditu; Gloxik hala ere erantzun dezake hodeiaren bidez, zure gako propioarekin."

#: src/gloxi/check.py
msgid "The processor has no AVX2 (it is older than Intel Core 8th generation or Ryzen 2000), so the local model will be slow."
msgstr "Prozesadoreak ez du AVX2rik (Intel Core 8. belaunaldia edo Ryzen 2000 baino zaharragoa da), beraz tokiko eredua motel ibiliko da."

#: src/gloxi/check.py
#, python-brace-format
msgid "This computer can run {name}."
msgstr "Ordenagailu honek {name} exekuta dezake."

#: src/gloxi/check.py
#, python-brace-format
msgid "This computer can run {name}. Gloxi will measure once whether the larger model would be fast enough."
msgstr "Ordenagailu honek {name} exekuta dezake. Gloxik behin neurtuko du eredu handiagoa behar bezain azkarra izango litzatekeen."

#: src/gloxi/check.py
msgid "This computer is below the minimum for the local model."
msgstr "Ordenagailu hau tokiko ereduaren gutxienekoaren azpitik dago."

#: src/gloxi/check.py
#, python-brace-format
msgid "This computer is fast enough for the larger model, {name}."
msgstr "Ordenagailu hau behar bezain azkarra da eredu handiagorako, {name}."

#: src/gloxi/check.py
msgid "To paste into the feedback form:"
msgstr "Iritzi-inprimakian itsasteko:"

#: src/gloxi/cli.py
msgid "(interrupted)"
msgstr "(etenda)"

#: src/gloxi/cli.py src/gloxi/gui/controller.py
msgid "Backups need Herkos, and it is not running."
msgstr "Babeskopiek Herkos behar dute, eta ez dago martxan."

#: src/gloxi/cli.py src/gloxi/gui/controller.py
msgid "Checking how fast this computer runs the model (about a minute)…"
msgstr "Ordenagailu honek eredua zein azkar exekutatzen duen egiaztatzen (minutu bat inguru)…"

#: src/gloxi/cli.py
msgid "Cloud: off. Everything stays on this computer."
msgstr "Hodeia: desaktibatuta. Dena ordenagailu honetan geratzen da."

#: src/gloxi/cli.py
#, python-brace-format
msgid "Cloud: on ({mode} mode)."
msgstr "Hodeia: aktibatuta ({mode} modua)."

#: src/gloxi/cli.py
msgid "Commands: /local <text> or /cloud <text> picks the model for one message, /reset clears the conversation, /backup sets up backups, /vpn sets up a VPN, /feedback reports a problem or suggests something, /exit quits."
msgstr "Aginduak: /local <testua> edo /cloud <testua> mezu baterako eredua aukeratzen du, /reset elkarrizketa garbitzen du, /backup babeskopiak konfiguratzen ditu, /vpn VPN bat konfiguratzen du, /feedback arazo baten berri ematen du edo zerbait iradokitzen du, /exit irten egiten da."

#: src/gloxi/cli.py
msgid "Conversation cleared."
msgstr "Elkarrizketa garbitu da."

#: src/gloxi/cli.py src/gloxi/voice/cli.py
msgid "Download it now? [y/N] "
msgstr "Deskargatu orain? [b/E] "

#: src/gloxi/cli.py src/gloxi/gui/controller.py
#, python-brace-format
msgid "Downloading the model: {percent}%"
msgstr "Eredua deskargatzen: % {percent}"

#: src/gloxi/cli.py src/gloxi/gui/controller.py
msgid "Gloxi keeps the current model and will not ask again."
msgstr "Gloxik oraingo eredua mantentzen du eta ez du berriro galdetuko."

#: src/gloxi/cli.py
#, python-brace-format
msgid "Gloxi needs a language model on this computer to answer. It is {name}, {size}, licence {licence}, from {source}. It will be kept in {folder}. Only the file is downloaded: nothing about you is sent."
msgstr "Erantzuteko, Gloxik hizkuntza-eredu bat behar du ordenagailu honetan. {name} da, {size}, {licence} lizentzia, {source} iturburutik. {folder} karpetan gordeko da. Fitxategia soilik deskargatzen da: ez da zuri buruzko ezer bidaltzen."

#: src/gloxi/cli.py
msgid ""
"Is llama-server running? For example:\n"
"  llama-server -m model.gguf --port 8080\n"
"or point Gloxi elsewhere with GLOXI_LOCAL_URL."
msgstr ""
"Martxan dago llama-server? Adibidez:\n"
"  llama-server -m model.gguf --port 8080\n"
"edo eman Gloxiri beste helbide bat GLOXI_LOCAL_URL bidez."

#: src/gloxi/cli.py src/gloxi/gui/controller.py
msgid "Not downloaded. Gloxi will ask again next time."
msgstr "Ez da deskargatu. Gloxik berriro galdetuko du hurrengoan."

#: src/gloxi/cli.py
msgid "Note: masking is off (mask_cloud = false), so messages sent to the cloud are NOT masked."
msgstr "Kontuz: maskaratzea desaktibatuta dago (mask_cloud = false), beraz hodeira bidalitako mezuak EZ dira maskaratzen."

#: src/gloxi/cli.py
#, python-brace-format
msgid "Open the app: {app}"
msgstr "Ireki aplikazioa: {app}"

#: src/gloxi/cli.py src/gloxi/gui/controller.py
#, python-brace-format
msgid "Starting {name} on this computer…"
msgstr "{name} abiarazten ordenagailu honetan…"

#: src/gloxi/cli.py src/gloxi/gui/controller.py
msgid "The VPN needs Vilna and Herkos, and Herkos is not running."
msgstr "VPNak Vilna eta Herkos behar ditu, eta Herkos ez dago martxan."

#: src/gloxi/cli.py src/gloxi/gui/controller.py
#, python-brace-format
msgid "The model could not be started: {why}"
msgstr "Ezin izan da eredua abiarazi: {why}"

#: src/gloxi/cli.py
msgid "The model is ready."
msgstr "Eredua prest dago."

#: src/gloxi/cli.py src/gloxi/gui/controller.py
msgid "The model is ready. Gloxi will use it from the next start."
msgstr "Eredua prest dago. Gloxik hurrengo abiotik aurrera erabiliko du."

#: src/gloxi/cli.py src/gloxi/gui/controller.py
#, python-brace-format
msgid "The model was not downloaded: {why}"
msgstr "Eredua ez da deskargatu: {why}"

#: src/gloxi/cli.py
msgid "There is no language model yet. Run gloxi in a terminal once to download it."
msgstr "Oraindik ez dago hizkuntza-eredurik. Exekutatu gloxi behin terminal batean deskargatzeko."

#: src/gloxi/cli.py
#, python-brace-format
msgid "This computer is fast enough for a better model: {name}, {size}, licence {licence}, from {source}. It answers better, in Ukrainian too; Gloxi expects about {speed} tokens per second here. It will be kept in {folder}, next to the current model, and Gloxi will use it from the next start. Only the file is downloaded: nothing about you is sent."
msgstr "Ordenagailu hau behar bezain azkarra da eredu hobe baterako: {name}, {size}, {licence} lizentzia, {source} iturburutik. Hobeto erantzuten du, baita ukraineraz ere; Gloxik hemen segundoko {speed} token inguru espero ditu. {folder} karpetan gordeko da, oraingo ereduaren ondoan, eta Gloxik hurrengo abiotik aurrera erabiliko du. Fitxategia soilik deskargatzen da: ez da zuri buruzko ezer bidaltzen."

#: src/gloxi/cli.py
msgid "Without a language model Gloxi cannot answer. Run gloxi again when you want to download it."
msgstr "Hizkuntza-eredurik gabe Gloxik ezin du erantzun. Exekutatu gloxi berriro deskargatu nahi duzunean."

#: src/gloxi/cli.py
#, python-brace-format
msgid "[cloud: {host}, masked]"
msgstr "[hodeia: {host}, maskaratuta]"

#: src/gloxi/cli.py
#, python-brace-format
msgid "[cloud: {host}, not masked]"
msgstr "[hodeia: {host}, maskaratu gabe]"

#: src/gloxi/cli.py
msgid "[local]"
msgstr "[tokikoa]"

#: src/gloxi/engine.py
msgid "."
msgstr ","

#: src/gloxi/engine.py
msgid "Google on Hugging Face"
msgstr "Google Hugging Face-n"

#: src/gloxi/engine.py
msgid "Mistral AI on Hugging Face"
msgstr "Mistral AI Hugging Face-n"

#: src/gloxi/engine.py
msgid "Qwen (Alibaba Cloud) on Hugging Face"
msgstr "Qwen (Alibaba Cloud) Hugging Face-n"

#: src/gloxi/engine.py
msgid "the model"
msgstr "eredua"

#: src/gloxi/engine.py
#, python-brace-format
msgid "{value} GB"
msgstr "{value} GB"

#: src/gloxi/engine.py
#, python-brace-format
msgid "{value} MB"
msgstr "{value} MB"

#: src/gloxi/feedback.py
msgid "A suggestion"
msgstr "Iradokizun bat"

#: src/gloxi/feedback.py
msgid "About this computer:"
msgstr "Ordenagailu honi buruz:"

#: src/gloxi/feedback.py
msgid "All right, nothing was sent."
msgstr "Ados, ez da ezer bidali."

#: src/gloxi/feedback.py src/gloxi/gui/window.py
msgid "Cancel"
msgstr "Utzi"

#: src/gloxi/feedback.py
msgid "Crash report:"
msgstr "Hutsegite-txostena:"

#: src/gloxi/feedback.py
msgid "Expected:"
msgstr "Espero zena:"

#: src/gloxi/feedback.py
msgid "Gloxi stopped with an error recently. Add that crash report?"
msgstr "Gloxi errore batekin gelditu da duela gutxi. Hutsegite-txosten hori gehituko dut?"

#: src/gloxi/feedback.py
#, python-brace-format
msgid "Hidden before showing it here: {what}."
msgstr "Hemen erakutsi aurretik ezkutatua: {what}."

#: src/gloxi/feedback.py
msgid "May I add what this computer is (system, processor, memory, graphics, models), as gloxi check shows it? Nothing personal."
msgstr "Gehi dezaket zer ordenagailu den hau (sistema, prozesadorea, memoria, grafikoak, ereduak), gloxi check-ek erakusten duen bezala? Ezer pertsonalik ez."

#: src/gloxi/feedback.py
msgid "Never mind"
msgstr "Utzi"

#: src/gloxi/feedback.py
msgid "Open the form"
msgstr "Ireki inprimakia"

#: src/gloxi/feedback.py
#, python-brace-format
msgid "Opening the form in your browser. Thank you! If it does not open: {url}"
msgstr "Inprimakia zure nabigatzailean irekitzen. Eskerrik asko! Irekitzen ez bada: {url}"

#: src/gloxi/feedback.py
msgid "Please answer 1 or 2."
msgstr "Erantzun 1 edo 2."

#: src/gloxi/feedback.py
msgid "Please answer 1, 2 or 3."
msgstr "Erantzun 1, 2 edo 3."

#: src/gloxi/feedback.py
msgid "Please write a few words, or /cancel to stop."
msgstr "Idatzi hitz batzuk, edo /cancel gelditzeko."

#: src/gloxi/feedback.py src/gloxi/gui/panel.py
msgid "Something went wrong"
msgstr "Zerbait gaizki joan da"

#: src/gloxi/feedback.py
msgid "Suggestion:"
msgstr "Iradokizuna:"

#: src/gloxi/feedback.py
msgid "This is public: anyone can read it on GitHub, and you need a GitHub account to send it. The form opens in your browser, where you can still change everything; it is sent only when you press Create there."
msgstr "Hau publikoa da: edonork irakur dezake GitHub-en, eta GitHub kontu bat behar duzu bidaltzeko. Inprimakia zure nabigatzailean irekitzen da, eta han oraindik dena alda dezakezu; han Create sakatzen duzunean soilik bidaltzen da."

#: src/gloxi/feedback.py
#, python-brace-format
