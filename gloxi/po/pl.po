msgstr ""
"Project-Id-Version: gloxi\n"
"Report-Msgid-Bugs-To: https://github.com/StDenis1980/VilnaOS/issues\n"
"Language: pl\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"

#: src/gloxi/backup_intro.py
msgid "All right. I will ask once more in a week. You can also type /backup any time."
msgstr "Dobrze. Zapytam jeszcze raz za tydzień. Możesz też w każdej chwili wpisać /backup."

#: src/gloxi/backup_intro.py
msgid "An external disk"
msgstr "Dysk zewnętrzny"

#: src/gloxi/backup_intro.py
msgid "And Wi-Fi passwords, online accounts, SSH and GPG keys?"
msgstr "A hasła do Wi-Fi, konta online, klucze SSH i GPG?"

#: src/gloxi/backup_intro.py
#, python-brace-format
msgid "Choose a number from 1 to {n}."
msgstr "Wybierz liczbę od 1 do {n}."

#: src/gloxi/backup_intro.py
msgid "Choose a number from the list, or type an amount in GB, e.g. 120"
msgstr "Wybierz liczbę z listy albo wpisz ilość w GB, np. 120"

#: src/gloxi/backup_intro.py
msgid "Choose myself"
msgstr "Własny wybór"

#: src/gloxi/backup_intro.py
msgid "Choose what goes into backups"
msgstr "Wybór, co trafia do kopii"

#: src/gloxi/backup_intro.py
msgid "Desktop"
msgstr "Pulpit"

#: src/gloxi/backup_intro.py
msgid "Documents"
msgstr "Dokumenty"

#: src/gloxi/backup_intro.py
msgid "Downloads"
msgstr "Pobrane"

#: src/gloxi/backup_intro.py
msgid "Dropbox, OneDrive, Google Drive"
msgstr "Dropbox, OneDrive, Google Drive"

#: src/gloxi/backup_intro.py
msgid "Every day, recommended"
msgstr "Codziennie, zalecane"

#: src/gloxi/backup_intro.py
msgid "Every hour"
msgstr "Co godzinę"

#: src/gloxi/backup_intro.py
msgid "Every week"
msgstr "Co tydzień"

#: src/gloxi/backup_intro.py
msgid "Everything in the home folder"
msgstr "Wszystko w katalogu domowym"

#: src/gloxi/backup_intro.py
#, python-brace-format
msgid "Everything in the home folder, without caches and Downloads ({size})"
msgstr "Wszystko w katalogu domowym, bez pamięci podręcznej i Pobranych ({size})"

#: src/gloxi/backup_intro.py
msgid "Gloxi checks that the backup fits"
msgstr "Gloxi sprawdza, czy kopia się zmieści"

#: src/gloxi/backup_intro.py
msgid "Gloxi checks whether backups are set up"
msgstr "Gloxi sprawdza, czy kopie są skonfigurowane"

#: src/gloxi/backup_intro.py
msgid "Gloxi measures how much space your folders take"
msgstr "Gloxi mierzy, ile miejsca zajmują twoje foldery"

#: src/gloxi/backup_intro.py
msgid ""
"Have your recovery sheet ready and run this in a terminal:\n"
"  vilna-backup recover <where the backups are>\n"
"Then: vilna-backup restore --in-place"
msgstr ""
"Przygotuj arkusz odzyskiwania i uruchom w terminalu:\n"
"  vilna-backup recover <gdzie są kopie>\n"
"Następnie: vilna-backup restore --in-place"

#: src/gloxi/backup_intro.py
msgid "Herkos sent an answer Gloxi does not understand"
msgstr "Herkos wysłał odpowiedź, której Gloxi nie rozumie"

#: src/gloxi/backup_intro.py
msgid "Herkos, the permission service, is not available"
msgstr "Herkos, usługa uprawnień, jest niedostępny"

#: src/gloxi/backup_intro.py
msgid "How much space are you ready to give to backups?"
msgstr "Ile miejsca chcesz przeznaczyć na kopie?"

#: src/gloxi/backup_intro.py
msgid "How often?"
msgstr "Jak często?"

#: src/gloxi/backup_intro.py
#, python-brace-format
msgid "I could not continue: {why}. We can go on later: type /backup."
msgstr "Nie udało mi się kontynuować: {why}. Możemy wrócić do tego później: wpisz /backup."

#: src/gloxi/backup_intro.py
msgid "I had Vilna before: restore from a backup"
msgstr "Mam już kopię z Vilny: przywróć ją"

#: src/gloxi/backup_intro.py
#, python-brace-format
msgid "I will back up {what} (about {size}) {how} {where}."
msgstr "Będę kopiować {what} (około {size}) {how} {where}."

#: src/gloxi/backup_intro.py
msgid "Keep Gloxi conversations in backups"
msgstr "Zachowuj rozmowy z Gloxi w kopiach"

#: src/gloxi/backup_intro.py
msgid "Keep your conversations with Gloxi in backups too?"
msgstr "Czy zachowywać w kopiach także twoje rozmowy z Gloxi?"

#: src/gloxi/backup_intro.py
msgid "Later"
msgstr "Później"

#: src/gloxi/backup_intro.py
msgid "Leave large folders out of backups"
msgstr "Pomiń duże foldery w kopiach"

#: src/gloxi/backup_intro.py
msgid "Leave out Gloxi history"
msgstr "Pomiń historię Gloxi"

#: src/gloxi/backup_intro.py
msgid "Music"
msgstr "Muzyka"

#: src/gloxi/backup_intro.py
msgid "My own storage (S3, SFTP)"
msgstr "Własna przestrzeń (S3, SFTP)"

#: src/gloxi/backup_intro.py src/gloxi/feedback.py
msgid "No"
msgstr "Nie"

#: src/gloxi/backup_intro.py
msgid "No limit"
msgstr "Bez limitu"

#: src/gloxi/backup_intro.py
msgid "No, I will give more space"
msgstr "Nie, dam więcej miejsca"

#: src/gloxi/backup_intro.py
#, python-brace-format
msgid "Only settings ({size})"
msgstr "Tylko ustawienia ({size})"

#: src/gloxi/backup_intro.py
msgid "Passwords and accounts are switched on by you only:"
msgstr "Hasła i konta włączasz tylko ty:"

#: src/gloxi/backup_intro.py
msgid "Pictures"
msgstr "Obrazy"

#: src/gloxi/backup_intro.py
msgid "Set how much space backups may take"
msgstr "Ustaw, ile miejsca mogą zajmować kopie"

#: src/gloxi/backup_intro.py
msgid "Set how often backups are made"
msgstr "Ustaw, jak często są robione kopie"

#: src/gloxi/backup_intro.py
#, python-brace-format
msgid "Settings and documents, recommended ({size})"
msgstr "Ustawienia i dokumenty, zalecane ({size})"

#: src/gloxi/backup_intro.py
msgid "Settings are always kept. Which folders to add? Type their numbers, for example: 1 3"
msgstr "Ustawienia są zawsze zachowywane. Które foldery dodać? Wpisz ich numery, na przykład: 1 3"

#: src/gloxi/backup_intro.py
msgid "Settings, passwords, Gloxi and Herkos"
msgstr "Ustawienia, hasła, Gloxi i Herkos"

#: src/gloxi/backup_intro.py
msgid "Shall I keep backups of your data, so you do not lose it along with the computer?"
msgstr "Czy mam robić kopie twoich danych, żeby nie przepadły razem z komputerem?"

#: src/gloxi/backup_intro.py
msgid "The Vilna cloud is not open yet in this preview. Choose another place."
msgstr "Chmura Vilna nie jest jeszcze dostępna w tej wersji testowej. Wybierz inne miejsce."

#: src/gloxi/backup_intro.py
msgid "The last step is yours, because it is about keys: run this in a terminal. It shows the recovery key once; write it on paper and keep it away from the computer. Without it, backups cannot be restored if this computer is lost. The first backup starts right after."
msgstr "Ostatni krok należy do ciebie, bo dotyczy kluczy: uruchom to w terminalu. Klucz odzyskiwania zostanie pokazany tylko raz; zapisz go na papierze i trzymaj z dala od komputera. Bez niego kopii nie da się przywrócić, jeśli stracisz ten komputer. Pierwsza kopia zacznie się zaraz potem."

#: src/gloxi/backup_intro.py
msgid "These are US companies: they see your account, the size and time of backups (not the contents), and a broken device could delete the backups. They are not in this preview yet. Choose another place."
msgstr "To firmy z USA: widzą twoje konto, rozmiar i czas kopii (nie ich treść), a przejęte urządzenie mogłoby usunąć kopie. Nie ma ich jeszcze w tej wersji testowej. Wybierz inne miejsce."

#: src/gloxi/backup_intro.py
msgid "Type an amount in GB, e.g. 120"
msgstr "Wpisz ilość w GB, np. 120"

#: src/gloxi/backup_intro.py
msgid "Type the numbers of the folders, for example: 1 3"
msgstr "Wpisz numery folderów, na przykład: 1 3"

#: src/gloxi/backup_intro.py
msgid "Videos"
msgstr "Wideo"

#: src/gloxi/backup_intro.py
msgid "Vilna cloud (EU)"
msgstr "Chmura Vilna (UE)"

#: src/gloxi/backup_intro.py
msgid "We are not talking about backups now."
msgstr "Teraz nie rozmawiamy o kopiach."

#: src/gloxi/backup_intro.py
msgid "What shall we keep? This is how much space it takes now:"
msgstr "Co zachowamy? Tyle miejsca zajmuje to teraz:"

#: src/gloxi/backup_intro.py
msgid "Where shall we keep them? Everything is encrypted on this computer first."
msgstr "Gdzie je przechowywać? Wszystko jest najpierw szyfrowane na tym komputerze."

#: src/gloxi/backup_intro.py src/gloxi/feedback.py
msgid "Yes"
msgstr "Tak"

#: src/gloxi/backup_intro.py
msgid "Yes, leave them out"
msgstr "Tak, pomiń je"

#: src/gloxi/backup_intro.py
msgid "every day"
msgstr "codziennie"

#: src/gloxi/backup_intro.py
msgid "every hour"
msgstr "co godzinę"

#: src/gloxi/backup_intro.py
msgid "every week"
msgstr "co tydzień"

#: src/gloxi/backup_intro.py
msgid "everything in the home folder"
msgstr "wszystko w katalogu domowym"

#: src/gloxi/backup_intro.py
msgid "in your own storage"
msgstr "w twojej własnej przestrzeni"

#: src/gloxi/backup_intro.py
msgid "no"
msgstr "nie"

#: src/gloxi/backup_intro.py
msgid "on the external disk"
msgstr "na dysku zewnętrznym"

#: src/gloxi/backup_intro.py
msgid "settings"
msgstr "ustawienia"

#: src/gloxi/backup_intro.py
msgid "settings and documents"
msgstr "ustawienia i dokumenty"

#: src/gloxi/backup_intro.py
msgid "settings and the folders you chose"
msgstr "ustawienia i wybrane przez ciebie foldery"

#: src/gloxi/backup_intro.py src/gloxi/cli.py
msgid "yes"
msgstr "tak"

#: src/gloxi/backup_intro.py
#, python-brace-format
msgid ""
"{size} does not fit into {limit}. Leave out these large folders (about {after} remains)?\n"
"{folders}"
msgstr ""
"{size} nie mieści się w {limit}. Pominąć te duże foldery (zostanie około {after})?\n"
"{folders}"

#: src/gloxi/backup_intro.py
#, python-brace-format
msgid "{size} does not fit. Choose a larger amount."
msgstr "{size} się nie zmieści. Wybierz większą ilość."

#: src/gloxi/check.py
msgid "Could not read the memory size; the local model may still work."
msgstr "Nie udało się odczytać ilości pamięci; model lokalny może mimo to działać."

#: src/gloxi/check.py
#, python-brace-format
msgid "Free disk space: {free}. The model needs {size}."
msgstr "Wolne miejsce na dysku: {free}. Model potrzebuje {size}."

#: src/gloxi/check.py
#, python-brace-format
msgid "Gloxi starts {large} because its file is in the models folder, but the speed test has not shown that it is fast enough here. To go back to {small}, delete {file} from {folder}."
msgstr "Gloxi uruchamia {large}, bo jego plik leży w folderze modeli, ale test szybkości nie wykazał, że jest tu wystarczająco szybki. Aby wrócić do {small}, usuń {file} z {folder}."

#: src/gloxi/check.py
#, python-brace-format
msgid "Memory: {ram}. The local model needs at least 8 GB; Gloxi can still answer through the cloud with your own key."
msgstr "Pamięć: {ram}. Model lokalny potrzebuje co najmniej 8 GB; Gloxi może nadal odpowiadać przez chmurę z twoim własnym kluczem."

#: src/gloxi/check.py
msgid "The processor has no AVX2 (it is older than Intel Core 8th generation or Ryzen 2000), so the local model will be slow."
msgstr "Procesor nie ma AVX2 (jest starszy niż Intel Core 8. generacji lub Ryzen 2000), więc model lokalny będzie działał wolno."

#: src/gloxi/check.py
#, python-brace-format
msgid "This computer can run {name}."
msgstr "Ten komputer może uruchomić {name}."

#: src/gloxi/check.py
#, python-brace-format
msgid "This computer can run {name}. Gloxi will measure once whether the larger model would be fast enough."
msgstr "Ten komputer może uruchomić {name}. Gloxi raz zmierzy, czy większy model byłby wystarczająco szybki."

#: src/gloxi/check.py
msgid "This computer is below the minimum for the local model."
msgstr "Ten komputer nie spełnia minimum dla modelu lokalnego."

#: src/gloxi/check.py
#, python-brace-format
msgid "This computer is fast enough for the larger model, {name}."
msgstr "Ten komputer jest wystarczająco szybki dla większego modelu, {name}."

#: src/gloxi/check.py
msgid "To paste into the feedback form:"
msgstr "Do wklejenia w formularzu opinii:"

#: src/gloxi/cli.py
msgid "(interrupted)"
msgstr "(przerwano)"

#: src/gloxi/cli.py src/gloxi/gui/controller.py
msgid "Backups need Herkos, and it is not running."
msgstr "Kopie potrzebują Herkosa, a on nie działa."

#: src/gloxi/cli.py src/gloxi/gui/controller.py
msgid "Checking how fast this computer runs the model (about a minute)…"
msgstr "Sprawdzam, jak szybko ten komputer uruchamia model (około minuty)…"

#: src/gloxi/cli.py
msgid "Cloud: off. Everything stays on this computer."
msgstr "Chmura: wyłączona. Wszystko zostaje na tym komputerze."

#: src/gloxi/cli.py
#, python-brace-format
msgid "Cloud: on ({mode} mode)."
msgstr "Chmura: włączona (tryb {mode})."

#: src/gloxi/cli.py
msgid "Commands: /local <text> or /cloud <text> picks the model for one message, /reset clears the conversation, /backup sets up backups, /feedback reports a problem or suggests something, /exit quits."
msgstr "Polecenia: /local <tekst> lub /cloud <tekst> wybiera model dla jednej wiadomości, /reset czyści rozmowę, /backup konfiguruje kopie, /feedback zgłasza problem lub sugestię, /exit kończy."

#: src/gloxi/cli.py
msgid "Conversation cleared."
msgstr "Rozmowa wyczyszczona."

#: src/gloxi/cli.py
msgid "Download it now? [y/N] "
msgstr "Pobrać teraz? [t/N] "

#: src/gloxi/cli.py src/gloxi/gui/controller.py
#, python-brace-format
msgid "Downloading the model: {percent}%"
msgstr "Pobieranie modelu: {percent}%"

#: src/gloxi/cli.py src/gloxi/gui/controller.py
msgid "Gloxi keeps the current model and will not ask again."
msgstr "Gloxi zostaje przy obecnym modelu i nie zapyta ponownie."

#: src/gloxi/cli.py
#, python-brace-format
msgid "Gloxi needs a language model on this computer to answer. It is {name}, {size}, licence {licence}, from {source}. It will be kept in {folder}. Only the file is downloaded: nothing about you is sent."
msgstr "Aby odpowiadać, Gloxi potrzebuje modelu językowego na tym komputerze. To {name}, {size}, licencja {licence}, z {source}. Zostanie zapisany w {folder}. Pobierany jest tylko plik: nic o tobie nie jest wysyłane."

#: src/gloxi/cli.py
msgid ""
"Is llama-server running? For example:\n"
"  llama-server -m model.gguf --port 8080\n"
"or point Gloxi elsewhere with GLOXI_LOCAL_URL."
msgstr ""
"Czy llama-server działa? Na przykład:\n"
"  llama-server -m model.gguf --port 8080\n"
"albo wskaż Gloxi inny adres przez GLOXI_LOCAL_URL."

#: src/gloxi/cli.py src/gloxi/gui/controller.py
msgid "Not downloaded. Gloxi will ask again next time."
msgstr "Nie pobrano. Gloxi zapyta ponownie następnym razem."

#: src/gloxi/cli.py
msgid "Note: masking is off (mask_cloud = false), so messages sent to the cloud are NOT masked."
msgstr "Uwaga: maskowanie jest wyłączone (mask_cloud = false), więc wiadomości wysyłane do chmury NIE są maskowane."

#: src/gloxi/cli.py src/gloxi/gui/controller.py
#, python-brace-format
msgid "Starting {name} on this computer…"
msgstr "Uruchamianie {name} na tym komputerze…"

#: src/gloxi/cli.py src/gloxi/gui/controller.py
#, python-brace-format
msgid "The model could not be started: {why}"
msgstr "Nie udało się uruchomić modelu: {why}"

#: src/gloxi/cli.py
msgid "The model is ready."
msgstr "Model jest gotowy."

#: src/gloxi/cli.py src/gloxi/gui/controller.py
msgid "The model is ready. Gloxi will use it from the next start."
msgstr "Model jest gotowy. Gloxi użyje go od następnego uruchomienia."

#: src/gloxi/cli.py src/gloxi/gui/controller.py
#, python-brace-format
msgid "The model was not downloaded: {why}"
msgstr "Model nie został pobrany: {why}"

#: src/gloxi/cli.py
msgid "There is no language model yet. Run gloxi in a terminal once to download it."
msgstr "Nie ma jeszcze modelu językowego. Uruchom raz gloxi w terminalu, aby go pobrać."

#: src/gloxi/cli.py
#, python-brace-format
msgid "This computer is fast enough for a better model: {name}, {size}, licence {licence}, from {source}. It answers better, in Ukrainian too; Gloxi expects about {speed} tokens per second here. It will be kept in {folder}, next to the current model, and Gloxi will use it from the next start. Only the file is downloaded: nothing about you is sent."
msgstr "Ten komputer jest wystarczająco szybki dla lepszego modelu: {name}, {size}, licencja {licence}, z {source}. Odpowiada lepiej, także po ukraińsku; Gloxi spodziewa się tu około {speed} tokenów na sekundę. Zostanie zapisany w {folder}, obok obecnego modelu, a Gloxi użyje go od następnego uruchomienia. Pobierany jest tylko plik: nic o tobie nie jest wysyłane."

#: src/gloxi/cli.py
msgid "Without a language model Gloxi cannot answer. Run gloxi again when you want to download it."
msgstr "Bez modelu językowego Gloxi nie może odpowiadać. Uruchom gloxi ponownie, gdy zechcesz go pobrać."

#: src/gloxi/cli.py
#, python-brace-format
msgid "[cloud: {host}, masked]"
msgstr "[chmura: {host}, zamaskowane]"

#: src/gloxi/cli.py
#, python-brace-format
msgid "[cloud: {host}, not masked]"
msgstr "[chmura: {host}, bez maskowania]"

#: src/gloxi/cli.py
msgid "[local]"
msgstr "[lokalnie]"

#: src/gloxi/engine.py
msgid "."
msgstr ","

#: src/gloxi/engine.py
msgid "Mistral AI on Hugging Face"
msgstr "Mistral AI w Hugging Face"

#: src/gloxi/engine.py
msgid "Qwen (Alibaba Cloud) on Hugging Face"
msgstr "Qwen (Alibaba Cloud) w Hugging Face"

#: src/gloxi/engine.py
msgid "the model"
msgstr "model"

#: src/gloxi/engine.py
#, python-brace-format
msgid "{value} GB"
msgstr "{value} GB"

#: src/gloxi/engine.py
#, python-brace-format
msgid "{value} MB"
msgstr "{value} MB"

#: src/gloxi/feedback.py
msgid "A suggestion"
msgstr "Sugestia"

#: src/gloxi/feedback.py
msgid "About this computer:"
msgstr "O tym komputerze:"

#: src/gloxi/feedback.py
msgid "All right, nothing was sent."
msgstr "Dobrze, nic nie zostało wysłane."

#: src/gloxi/feedback.py src/gloxi/gui/window.py
msgid "Cancel"
msgstr "Anuluj"

#: src/gloxi/feedback.py
msgid "Crash report:"
msgstr "Raport o awarii:"

#: src/gloxi/feedback.py
msgid "Expected:"
msgstr "Oczekiwano:"

#: src/gloxi/feedback.py
msgid "Gloxi stopped with an error recently. Add that crash report?"
msgstr "Gloxi niedawno zatrzymał się z błędem. Dołączyć ten raport o awarii?"

#: src/gloxi/feedback.py
#, python-brace-format
msgid "Hidden before showing it here: {what}."
msgstr "Ukryto przed pokazaniem tutaj: {what}."

#: src/gloxi/feedback.py
msgid "May I add what this computer is (system, processor, memory, graphics, models), as gloxi check shows it? Nothing personal."
msgstr "Czy mogę dodać, co to za komputer (system, procesor, pamięć, grafika, modele), tak jak pokazuje to gloxi check? Nic osobistego."

#: src/gloxi/feedback.py
msgid "Never mind"
msgstr "Nieważne"

#: src/gloxi/feedback.py
msgid "Open the form"
msgstr "Otwórz formularz"

#: src/gloxi/feedback.py
#, python-brace-format
msgid "Opening the form in your browser. Thank you! If it does not open: {url}"
msgstr "Otwieram formularz w przeglądarce. Dziękuję! Jeśli się nie otworzy: {url}"

#: src/gloxi/feedback.py
msgid "Please answer 1 or 2."
msgstr "Odpowiedz 1 lub 2."

#: src/gloxi/feedback.py
msgid "Please answer 1, 2 or 3."
msgstr "Odpowiedz 1, 2 lub 3."

#: src/gloxi/feedback.py
msgid "Please write a few words, or /cancel to stop."
msgstr "Napisz kilka słów albo /cancel, aby przerwać."

#: src/gloxi/feedback.py
msgid "Something went wrong"
msgstr "Coś poszło nie tak"

#: src/gloxi/feedback.py
msgid "Suggestion:"
msgstr "Sugestia:"

#: src/gloxi/feedback.py
msgid "This is public: anyone can read it on GitHub, and you need a GitHub account to send it. The form opens in your browser, where you can still change everything; it is sent only when you press Create there."
msgstr "To jest publiczne: każdy może to przeczytać na GitHubie, a do wysłania potrzebujesz konta GitHub. Formularz otworzy się w przeglądarce, gdzie wciąż możesz wszystko zmienić; zostanie wysłany dopiero, gdy naciśniesz tam Create."

#: src/gloxi/feedback.py
#, python-brace-format
msgid "This sounds like a security problem. Please do not post it publicly: report it privately at {url}"
msgstr "To wygląda na problem z bezpieczeństwem. Nie publikuj tego: zgłoś to prywatnie pod adresem {url}"

#: src/gloxi/feedback.py
msgid "Title:"
msgstr "Tytuł:"

#: src/gloxi/feedback.py
msgid "What did you do or ask, and what happened?"
msgstr "Co zrobiłeś(-aś) lub o co prosiłeś(-aś) i co się stało?"

#: src/gloxi/feedback.py
msgid "What did you expect instead? (Enter to skip)"
msgstr "Czego oczekiwałeś(-aś) zamiast tego? (Enter, aby pominąć)"

#: src/gloxi/feedback.py
msgid "What happened:"
msgstr "Co się stało:"

#: src/gloxi/feedback.py
msgid "What would you like to tell us?"
msgstr "Co chcesz nam przekazać?"

#: src/gloxi/feedback.py
msgid "What would you suggest? A sentence or two is enough."
msgstr "Co proponujesz? Wystarczy jedno lub dwa zdania."

#: src/gloxi/feedback.py
msgid "a card number"
msgstr "numer karty"

#: src/gloxi/feedback.py
msgid "a date of birth"
msgstr "data urodzenia"

#: src/gloxi/feedback.py
msgid "a name"
msgstr "imię lub nazwisko"

#: src/gloxi/feedback.py
msgid "a passport number"
msgstr "numer paszportu"

#: src/gloxi/feedback.py
msgid "a password or key"
msgstr "hasło lub klucz"

#: src/gloxi/feedback.py
msgid "a personal ID number"
msgstr "numer identyfikacyjny"

#: src/gloxi/feedback.py
msgid "a phone number"
msgstr "numer telefonu"

