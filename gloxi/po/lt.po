"Content-Transfer-Encoding: 8bit\n"

#: src/gloxi/backup_intro.py
msgid "All right. I will ask once more in a week. You can also type /backup any time."
msgstr "Gerai. Paklausiu dar kartą po savaitės. Bet kada taip pat galite įvesti /backup."

#: src/gloxi/backup_intro.py
msgid "An external disk"
msgstr "Išorinis diskas"

#: src/gloxi/backup_intro.py
msgid "And Wi-Fi passwords, online accounts, SSH and GPG keys?"
msgstr "O „Wi-Fi“ slaptažodžiai, internetinės paskyros, SSH ir GPG raktai?"

#: src/gloxi/backup_intro.py
#, python-brace-format
msgid "Choose a number from 1 to {n}."
msgstr "Pasirinkite skaičių nuo 1 iki {n}."

#: src/gloxi/backup_intro.py
msgid "Choose a number from the list, or type an amount in GB, e.g. 120"
msgstr "Pasirinkite skaičių iš sąrašo arba įveskite dydį GB, pvz., 120"

#: src/gloxi/backup_intro.py
msgid "Choose myself"
msgstr "Pasirinksiu savo nuožiūra"

#: src/gloxi/backup_intro.py
msgid "Choose what goes into backups"
msgstr "Pasirinkti, kas įtraukiama į atsargines kopijas"

#: src/gloxi/backup_intro.py
msgid "Desktop"
msgstr "Darbalaukis"

#: src/gloxi/backup_intro.py
msgid "Documents"
msgstr "Dokumentai"

#: src/gloxi/backup_intro.py
msgid "Downloads"
msgstr "Atsisiuntimai"

#: src/gloxi/backup_intro.py
msgid "Dropbox, OneDrive, Google Drive"
msgstr "Dropbox, OneDrive, Google Drive"

#: src/gloxi/backup_intro.py
msgid "Every day, recommended"
msgstr "Kasdien, rekomenduojama"

#: src/gloxi/backup_intro.py
msgid "Every hour"
msgstr "Kas valandą"

#: src/gloxi/backup_intro.py
msgid "Every week"
msgstr "Kas savaitę"

#: src/gloxi/backup_intro.py
msgid "Everything in the home folder"
msgstr "Viskas namų aplanke"

#: src/gloxi/backup_intro.py
#, python-brace-format
msgid "Everything in the home folder, without caches and Downloads ({size})"
msgstr "Viskas namų aplanke, be podėlio ir Atsisiuntimų ({size})"

#: src/gloxi/backup_intro.py
msgid "Gloxi checks that the backup fits"
msgstr "Gloxi tikrina, ar kopija tilps"

#: src/gloxi/backup_intro.py
msgid "Gloxi checks whether backups are set up"
msgstr "Gloxi tikrina, ar atsarginės kopijos nustatytos"

#: src/gloxi/backup_intro.py
msgid "Gloxi measures how much space your folders take"
msgstr "Gloxi matuoja, kiek vietos užima jūsų aplankai"

#: src/gloxi/backup_intro.py
msgid ""
"Have your recovery sheet ready and run this in a terminal:\n"
"  vilna-backup recover <where the backups are>\n"
"Then: vilna-backup restore --in-place"
msgstr ""
"Pasiruoškite atkūrimo lapą ir terminale paleiskite:\n"
"  vilna-backup recover <kur yra kopijos>\n"
"Tada: vilna-backup restore --in-place"

#: src/gloxi/backup_intro.py
msgid "Herkos sent an answer Gloxi does not understand"
msgstr "Herkos atsiuntė atsakymą, kurio Gloxi nesupranta"

#: src/gloxi/backup_intro.py
msgid "Herkos, the permission service, is not available"
msgstr "Herkos, leidimų tarnyba, nepasiekiama"

#: src/gloxi/backup_intro.py
msgid "How much space are you ready to give to backups?"
msgstr "Kiek vietos norite skirti atsarginėms kopijoms?"

#: src/gloxi/backup_intro.py
msgid "How often?"
msgstr "Kaip dažnai?"

#: src/gloxi/backup_intro.py
#, python-brace-format
msgid "I could not continue: {why}. We can go on later: type /backup."
msgstr "Negalėjau tęsti: {why}. Galime grįžti vėliau: įveskite /backup."

#: src/gloxi/backup_intro.py
msgid "I had Vilna before: restore from a backup"
msgstr "Turiu kopiją iš ankstesnės Vilna: atkurti iš jos"

#: src/gloxi/backup_intro.py
#, python-brace-format
msgid "I will back up {what} (about {size}) {how} {where}."
msgstr "Kopijuosiu {what} (apie {size}) {how} {where}."

#: src/gloxi/backup_intro.py
msgid "Keep Gloxi conversations in backups"
msgstr "Įtraukti pokalbius su Gloxi į kopijas"

#: src/gloxi/backup_intro.py
msgid "Keep your conversations with Gloxi in backups too?"
msgstr "Ar įtraukti į kopijas ir jūsų pokalbius su Gloxi?"

#: src/gloxi/backup_intro.py
msgid "Later"
msgstr "Vėliau"

#: src/gloxi/backup_intro.py
msgid "Leave large folders out of backups"
msgstr "Neįtraukti didelių aplankų į kopijas"

#: src/gloxi/backup_intro.py
msgid "Leave out Gloxi history"
msgstr "Neįtraukti Gloxi istorijos"

#: src/gloxi/backup_intro.py
msgid "Music"
msgstr "Muzika"

#: src/gloxi/backup_intro.py
msgid "My own storage (S3, SFTP)"
msgstr "Mano saugykla (S3, SFTP)"

#: src/gloxi/backup_intro.py src/gloxi/feedback.py
msgid "No"
msgstr "Ne"

#: src/gloxi/backup_intro.py
msgid "No limit"
msgstr "Be ribos"

#: src/gloxi/backup_intro.py
msgid "No, I will give more space"
msgstr "Ne, skirsiu daugiau vietos"

#: src/gloxi/backup_intro.py
#, python-brace-format
msgid "Only settings ({size})"
msgstr "Tik nustatymai ({size})"

#: src/gloxi/backup_intro.py
msgid "Passwords and accounts are switched on by you only:"
msgstr "Slaptažodžius ir paskyras įjungiate tik jūs patys:"

#: src/gloxi/backup_intro.py
msgid "Pictures"
msgstr "Paveikslėliai"

#: src/gloxi/backup_intro.py
msgid "Set how much space backups may take"
msgstr "Nustatyti, kiek vietos gali užimti kopijos"

#: src/gloxi/backup_intro.py
msgid "Set how often backups are made"
msgstr "Nustatyti, kaip dažnai daromos kopijos"

#: src/gloxi/backup_intro.py
#, python-brace-format
msgid "Settings and documents, recommended ({size})"
msgstr "Nustatymai ir dokumentai, rekomenduojama ({size})"

#: src/gloxi/backup_intro.py
msgid "Settings are always kept. Which folders to add? Type their numbers, for example: 1 3"
msgstr "Nustatymai įtraukiami visada. Kuriuos aplankus pridėti? Įveskite jų numerius, pavyzdžiui: 1 3"

#: src/gloxi/backup_intro.py
msgid "Settings, passwords, Gloxi and Herkos"
msgstr "Nustatymai, slaptažodžiai, Gloxi ir Herkos"

#: src/gloxi/backup_intro.py
msgid "Shall I keep backups of your data, so you do not lose it along with the computer?"
msgstr "Ar daryti jūsų duomenų atsargines kopijas, kad jų neprarastumėte kartu su kompiuteriu?"

#: src/gloxi/backup_intro.py
msgid "The Vilna cloud is not open yet in this preview. Choose another place."
msgstr "Vilna debesis šioje bandomojoje versijoje dar neveikia. Pasirinkite kitą vietą."

#: src/gloxi/backup_intro.py
msgid "The last step is yours, because it is about keys: run this in a terminal. It shows the recovery key once; write it on paper and keep it away from the computer. Without it, backups cannot be restored if this computer is lost. The first backup starts right after."
msgstr "Paskutinis žingsnis – jūsų, nes jis susijęs su raktais: paleiskite tai terminale. Atkūrimo raktas bus parodytas vieną kartą; užsirašykite jį ant popieriaus ir laikykite atskirai nuo kompiuterio. Be jo kopijų atkurti nepavyks, jei šis kompiuteris bus prarastas. Pirmoji kopija prasidės iškart po to."

#: src/gloxi/backup_intro.py
msgid "These are US companies: they see your account, the size and time of backups (not the contents), and a broken device could delete the backups. They are not in this preview yet. Choose another place."
msgstr "Tai JAV įmonės: jos mato jūsų paskyrą, kopijų dydį ir laiką (ne turinį), o įsilaužtas įrenginys galėtų ištrinti kopijas. Šioje bandomojoje versijoje jų dar nėra. Pasirinkite kitą vietą."

#: src/gloxi/backup_intro.py
msgid "Type an amount in GB, e.g. 120"
msgstr "Įveskite dydį GB, pvz., 120"

#: src/gloxi/backup_intro.py
msgid "Type the numbers of the folders, for example: 1 3"
msgstr "Įveskite aplankų numerius, pavyzdžiui: 1 3"

#: src/gloxi/backup_intro.py
msgid "Videos"
msgstr "Vaizdo įrašai"

#: src/gloxi/backup_intro.py
msgid "Vilna cloud (EU)"
msgstr "Vilna debesis (ES)"

#: src/gloxi/backup_intro.py
msgid "We are not talking about backups now."
msgstr "Dabar nekalbame apie atsargines kopijas."

#: src/gloxi/backup_intro.py
msgid "What shall we keep? This is how much space it takes now:"
msgstr "Ką saugosime? Tiek vietos tai užima dabar:"

#: src/gloxi/backup_intro.py
msgid "Where shall we keep them? Everything is encrypted on this computer first."
msgstr "Kur jas laikysime? Viskas pirmiausia užšifruojama šiame kompiuteryje."

#: src/gloxi/backup_intro.py src/gloxi/feedback.py
msgid "Yes"
msgstr "Taip"

#: src/gloxi/backup_intro.py
msgid "Yes, leave them out"
msgstr "Taip, neįtraukti"

#: src/gloxi/backup_intro.py
msgid "every day"
msgstr "kasdien"

#: src/gloxi/backup_intro.py
msgid "every hour"
msgstr "kas valandą"

#: src/gloxi/backup_intro.py
msgid "every week"
msgstr "kas savaitę"

#: src/gloxi/backup_intro.py
msgid "everything in the home folder"
msgstr "viską namų aplanke"

#: src/gloxi/backup_intro.py
msgid "in your own storage"
msgstr "jūsų saugykloje"

#: src/gloxi/backup_intro.py
msgid "no"
msgstr "ne"

#: src/gloxi/backup_intro.py
msgid "on the external disk"
msgstr "išoriniame diske"

#: src/gloxi/backup_intro.py
msgid "settings"
msgstr "nustatymus"

#: src/gloxi/backup_intro.py
msgid "settings and documents"
msgstr "nustatymus ir dokumentus"

#: src/gloxi/backup_intro.py
msgid "settings and the folders you chose"
msgstr "nustatymus ir jūsų pasirinktus aplankus"

#: src/gloxi/backup_intro.py src/gloxi/cli.py
msgid "yes"
msgstr "taip"

#: src/gloxi/backup_intro.py
#, python-brace-format
msgid ""
"{size} does not fit into {limit}. Leave out these large folders (about {after} remains)?\n"
"{folders}"
msgstr ""
"{size} netelpa į {limit}. Neįtraukti šių didelių aplankų (liks apie {after})?\n"
"{folders}"

#: src/gloxi/backup_intro.py
#, python-brace-format
msgid "{size} does not fit. Choose a larger amount."
msgstr "{size} netelpa. Pasirinkite didesnį dydį."

#: src/gloxi/check.py
msgid "Could not read the memory size; the local model may still work."
msgstr "Nepavyko nuskaityti atminties dydžio; vietinis modelis vis tiek gali veikti."

#: src/gloxi/check.py
#, python-brace-format
msgid "Free disk space: {free}. The model needs {size}."
msgstr "Laisva vieta diske: {free}. Modeliui reikia {size}."

#: src/gloxi/check.py
#, python-brace-format
msgid "Gloxi starts {large} because its file is in the models folder, but the speed test has not shown that it is fast enough here. To go back to {small}, delete {file} from {folder}."
msgstr "Gloxi paleidžia {large}, nes jo failas yra modelių aplanke, bet greičio testas neparodė, kad čia jis pakankamai greitas. Norėdami grįžti prie {small}, ištrinkite {file} iš {folder}."

#: src/gloxi/check.py
#, python-brace-format
msgid "Memory: {ram}. The local model needs at least 8 GB; Gloxi can still answer through the cloud with your own key."
msgstr "Atmintis: {ram}. Vietiniam modeliui reikia bent 8 GB; Gloxi vis tiek gali atsakyti per debesį su jūsų raktu."

#: src/gloxi/check.py
msgid "The processor has no AVX2 (it is older than Intel Core 8th generation or Ryzen 2000), so the local model will be slow."
msgstr "Procesorius neturi AVX2 (jis senesnis nei 8-osios kartos Intel Core ar Ryzen 2000), todėl vietinis modelis veiks lėtai."

#: src/gloxi/check.py
#, python-brace-format
msgid "This computer can run {name}."
msgstr "Šiame kompiuteryje galima paleisti {name}."

#: src/gloxi/check.py
#, python-brace-format
msgid "This computer can run {name}. Gloxi will measure once whether the larger model would be fast enough."
msgstr "Šiame kompiuteryje galima paleisti {name}. Gloxi vieną kartą pamatuos, ar didesnis modelis būtų pakankamai greitas."

#: src/gloxi/check.py
msgid "This computer is below the minimum for the local model."
msgstr "Šis kompiuteris neatitinka vietinio modelio minimalių reikalavimų."

#: src/gloxi/check.py
#, python-brace-format
msgid "This computer is fast enough for the larger model, {name}."
msgstr "Šis kompiuteris pakankamai greitas didesniam modeliui, {name}."

#: src/gloxi/check.py
msgid "To paste into the feedback form:"
msgstr "Įklijuoti į atsiliepimo formą:"

#: src/gloxi/cli.py
msgid "(interrupted)"
msgstr "(nutraukta)"

#: src/gloxi/cli.py src/gloxi/gui/controller.py
msgid "Backups need Herkos, and it is not running."
msgstr "Atsarginėms kopijoms reikia Herkos, o jis neveikia."

#: src/gloxi/cli.py src/gloxi/gui/controller.py
msgid "Checking how fast this computer runs the model (about a minute)…"
msgstr "Tikrinama, kaip greitai šis kompiuteris vykdo modelį (apie minutę)…"

#: src/gloxi/cli.py
msgid "Cloud: off. Everything stays on this computer."
msgstr "Debesis: išjungtas. Viskas lieka šiame kompiuteryje."

#: src/gloxi/cli.py
#, python-brace-format
msgid "Cloud: on ({mode} mode)."
msgstr "Debesis: įjungtas (režimas {mode})."

#: src/gloxi/cli.py
msgid "Commands: /local <text> or /cloud <text> picks the model for one message, /reset clears the conversation, /backup sets up backups, /feedback reports a problem or suggests something, /exit quits."
msgstr "Komandos: /local <tekstas> arba /cloud <tekstas> parenka modelį vienai žinutei, /reset išvalo pokalbį, /backup nustato atsargines kopijas, /feedback praneša apie problemą ar ką nors pasiūlo, /exit išeina."

#: src/gloxi/cli.py
msgid "Conversation cleared."
msgstr "Pokalbis išvalytas."

#: src/gloxi/cli.py
msgid "Download it now? [y/N] "
msgstr "Atsisiųsti dabar? [t/N] "

#: src/gloxi/cli.py src/gloxi/gui/controller.py
#, python-brace-format
msgid "Downloading the model: {percent}%"
msgstr "Atsisiunčiamas modelis: {percent} %"

#: src/gloxi/cli.py src/gloxi/gui/controller.py
msgid "Gloxi keeps the current model and will not ask again."
msgstr "Gloxi pasilieka dabartinį modelį ir daugiau nebeklaus."

#: src/gloxi/cli.py
#, python-brace-format
msgid "Gloxi needs a language model on this computer to answer. It is {name}, {size}, licence {licence}, from {source}. It will be kept in {folder}. Only the file is downloaded: nothing about you is sent."
msgstr "Kad galėtų atsakyti, Gloxi reikia kalbos modelio šiame kompiuteryje. Tai {name}, {size}, licencija {licence}, iš {source}. Jis bus laikomas {folder}. Atsisiunčiamas tik failas: nieko apie jus nesiunčiama."

#: src/gloxi/cli.py
msgid ""
"Is llama-server running? For example:\n"
"  llama-server -m model.gguf --port 8080\n"
"or point Gloxi elsewhere with GLOXI_LOCAL_URL."
msgstr ""
"Ar veikia llama-server? Pavyzdžiui:\n"
"  llama-server -m model.gguf --port 8080\n"
"arba nurodykite Gloxi kitą adresą per GLOXI_LOCAL_URL."

#: src/gloxi/cli.py src/gloxi/gui/controller.py
msgid "Not downloaded. Gloxi will ask again next time."
msgstr "Neatsisiųsta. Gloxi paklaus kitą kartą."

#: src/gloxi/cli.py
msgid "Note: masking is off (mask_cloud = false), so messages sent to the cloud are NOT masked."
msgstr "Pastaba: maskavimas išjungtas (mask_cloud = false), todėl į debesį siunčiamos žinutės NĖRA maskuojamos."

#: src/gloxi/cli.py src/gloxi/gui/controller.py
#, python-brace-format
msgid "Starting {name} on this computer…"
msgstr "Šiame kompiuteryje paleidžiamas {name}…"

#: src/gloxi/cli.py src/gloxi/gui/controller.py
#, python-brace-format
msgid "The model could not be started: {why}"
msgstr "Modelio paleisti nepavyko: {why}"

#: src/gloxi/cli.py
msgid "The model is ready."
msgstr "Modelis paruoštas."

#: src/gloxi/cli.py src/gloxi/gui/controller.py
msgid "The model is ready. Gloxi will use it from the next start."
msgstr "Modelis paruoštas. Gloxi jį naudos nuo kito paleidimo."

#: src/gloxi/cli.py src/gloxi/gui/controller.py
#, python-brace-format
msgid "The model was not downloaded: {why}"
msgstr "Modelis neatsisiųstas: {why}"

#: src/gloxi/cli.py
msgid "There is no language model yet. Run gloxi in a terminal once to download it."
msgstr "Kalbos modelio dar nėra. Kartą paleiskite gloxi terminale, kad jį atsisiųstumėte."

#: src/gloxi/cli.py
#, python-brace-format
msgid "This computer is fast enough for a better model: {name}, {size}, licence {licence}, from {source}. It answers better, in Ukrainian too; Gloxi expects about {speed} tokens per second here. It will be kept in {folder}, next to the current model, and Gloxi will use it from the next start. Only the file is downloaded: nothing about you is sent."
msgstr "Šis kompiuteris pakankamai greitas geresniam modeliui: {name}, {size}, licencija {licence}, iš {source}. Jis atsako geriau, taip pat ir ukrainiečių kalba; Gloxi čia tikisi apie {speed} žetonų per sekundę. Jis bus laikomas {folder}, šalia dabartinio modelio, o Gloxi jį naudos nuo kito paleidimo. Atsisiunčiamas tik failas: nieko apie jus nesiunčiama."

#: src/gloxi/cli.py
msgid "Without a language model Gloxi cannot answer. Run gloxi again when you want to download it."
msgstr "Be kalbos modelio Gloxi negali atsakyti. Kai norėsite jį atsisiųsti, vėl paleiskite gloxi."

#: src/gloxi/cli.py
#, python-brace-format
msgid "[cloud: {host}, masked]"
msgstr "[debesis: {host}, maskuota]"

#: src/gloxi/cli.py
#, python-brace-format
msgid "[cloud: {host}, not masked]"
msgstr "[debesis: {host}, nemaskuota]"

#: src/gloxi/cli.py
msgid "[local]"
msgstr "[vietinis]"

#: src/gloxi/engine.py
msgid "."
msgstr ","

#: src/gloxi/engine.py
msgid "Mistral AI on Hugging Face"
msgstr "Mistral AI per Hugging Face"

#: src/gloxi/engine.py
msgid "Qwen (Alibaba Cloud) on Hugging Face"
msgstr "Qwen (Alibaba Cloud) per Hugging Face"

#: src/gloxi/engine.py
msgid "the model"
msgstr "modelis"

#: src/gloxi/engine.py
#, python-brace-format
msgid "{value} GB"
msgstr "{value} GB"

#: src/gloxi/engine.py
#, python-brace-format
msgid "{value} MB"
msgstr "{value} MB"

#: src/gloxi/feedback.py
msgid "A suggestion"
msgstr "Pasiūlymas"

#: src/gloxi/feedback.py
msgid "About this computer:"
msgstr "Apie šį kompiuterį:"

#: src/gloxi/feedback.py
msgid "All right, nothing was sent."
msgstr "Gerai, nieko neišsiųsta."

#: src/gloxi/feedback.py src/gloxi/gui/window.py
msgid "Cancel"
msgstr "Atšaukti"

#: src/gloxi/feedback.py
msgid "Crash report:"
msgstr "Strigties ataskaita:"

#: src/gloxi/feedback.py
msgid "Expected:"
msgstr "Tikėtasi:"

#: src/gloxi/feedback.py
msgid "Gloxi stopped with an error recently. Add that crash report?"
msgstr "Gloxi neseniai sustojo dėl klaidos. Pridėti tą strigties ataskaitą?"

#: src/gloxi/feedback.py
#, python-brace-format
msgid "Hidden before showing it here: {what}."
msgstr "Paslėpta prieš rodant čia: {what}."

#: src/gloxi/feedback.py
msgid "May I add what this computer is (system, processor, memory, graphics, models), as gloxi check shows it? Nothing personal."
msgstr "Ar galiu pridėti, koks tai kompiuteris (sistema, procesorius, atmintis, grafika, modeliai), kaip rodo gloxi check? Nieko asmeniško."

#: src/gloxi/feedback.py
msgid "Never mind"
msgstr "Nesvarbu"

#: src/gloxi/feedback.py
msgid "Open the form"
msgstr "Atverti formą"

#: src/gloxi/feedback.py
#, python-brace-format
msgid "Opening the form in your browser. Thank you! If it does not open: {url}"
msgstr "Forma atveriama naršyklėje. Ačiū! Jei ji neatsidaro: {url}"

#: src/gloxi/feedback.py
msgid "Please answer 1 or 2."
msgstr "Atsakykite 1 arba 2."

#: src/gloxi/feedback.py
msgid "Please answer 1, 2 or 3."
msgstr "Atsakykite 1, 2 arba 3."

#: src/gloxi/feedback.py
msgid "Please write a few words, or /cancel to stop."
msgstr "Parašykite kelis žodžius arba /cancel, kad sustabdytumėte."

#: src/gloxi/feedback.py
msgid "Something went wrong"
msgstr "Kažkas nepavyko"

#: src/gloxi/feedback.py
msgid "Suggestion:"
msgstr "Pasiūlymas:"

#: src/gloxi/feedback.py
msgid "This is public: anyone can read it on GitHub, and you need a GitHub account to send it. The form opens in your browser, where you can still change everything; it is sent only when you press Create there."
msgstr "Tai vieša: bet kas gali tai perskaityti „GitHub“, o išsiųsti reikia „GitHub“ paskyros. Forma atsidaro naršyklėje, kur dar galite viską pakeisti; ji išsiunčiama tik tada, kai ten paspaudžiate Create."

#: src/gloxi/feedback.py
#, python-brace-format
msgid "This sounds like a security problem. Please do not post it publicly: report it privately at {url}"
msgstr "Panašu į saugumo problemą. Neskelbkite jos viešai: praneškite apie ją privačiai adresu {url}"

#: src/gloxi/feedback.py
msgid "Title:"
msgstr "Pavadinimas:"

#: src/gloxi/feedback.py
msgid "What did you do or ask, and what happened?"
msgstr "Ką darėte ar prašėte ir kas nutiko?"

#: src/gloxi/feedback.py
msgid "What did you expect instead? (Enter to skip)"
msgstr "Ko tikėjotės vietoj to? (Enter – praleisti)"

#: src/gloxi/feedback.py
msgid "What happened:"
msgstr "Kas nutiko:"

#: src/gloxi/feedback.py
msgid "What would you like to tell us?"
msgstr "Ką norėtumėte mums pasakyti?"

#: src/gloxi/feedback.py
msgid "What would you suggest? A sentence or two is enough."
msgstr "Ką siūlote? Užtenka vieno ar dviejų sakinių."

#: src/gloxi/feedback.py
msgid "a card number"
msgstr "kortelės numeris"

#: src/gloxi/feedback.py
msgid "a date of birth"
msgstr "gimimo data"

#: src/gloxi/feedback.py
msgid "a name"
msgstr "vardas"

#: src/gloxi/feedback.py
