#: src/gloxi/ai_notice.py
msgid "I am Gloxi, an AI assistant: a language model writes my answers, and they can be wrong."
msgstr "Sou o Gloxi, um assistente de IA: as minhas respostas são escritas por um modelo de linguagem e podem estar erradas."

#: src/gloxi/ai_notice.py
msgid "Written by AI"
msgstr "Escrito por IA"

#: src/gloxi/backup_intro.py
msgid "All right. I will ask once more in a week. You can also type /backup any time."
msgstr "Muito bem. Volto a perguntar daqui a uma semana. Também pode escrever /backup quando quiser."

#: src/gloxi/backup_intro.py
msgid "An external disk"
msgstr "Um disco externo"

#: src/gloxi/backup_intro.py
msgid "And Wi-Fi passwords, online accounts, SSH and GPG keys?"
msgstr "E as palavras-passe de Wi-Fi, as contas online e as chaves SSH e GPG?"

#: src/gloxi/backup_intro.py src/gloxi/vpn_intro.py
#, python-brace-format
msgid "Choose a number from 1 to {n}."
msgstr "Escolha um número de 1 a {n}."

#: src/gloxi/backup_intro.py
msgid "Choose a number from the list, or type an amount in GB, e.g. 120"
msgstr "Escolha um número da lista ou escreva uma quantidade em GB, p. ex. 120"

#: src/gloxi/backup_intro.py
msgid "Choose myself"
msgstr "Escolher eu"

#: src/gloxi/backup_intro.py
msgid "Choose what goes into backups"
msgstr "Escolher o que entra nas cópias"

#: src/gloxi/backup_intro.py
msgid "Desktop"
msgstr "Ambiente de trabalho"

#: src/gloxi/backup_intro.py
msgid "Documents"
msgstr "Documentos"

#: src/gloxi/backup_intro.py
msgid "Downloads"
msgstr "Transferências"

#: src/gloxi/backup_intro.py
msgid "Dropbox, OneDrive, Google Drive"
msgstr "Dropbox, OneDrive, Google Drive"

#: src/gloxi/backup_intro.py
msgid "Every day, recommended"
msgstr "Todos os dias, recomendado"

#: src/gloxi/backup_intro.py
msgid "Every hour"
msgstr "A cada hora"

#: src/gloxi/backup_intro.py
msgid "Every week"
msgstr "Todas as semanas"

#: src/gloxi/backup_intro.py
msgid "Everything in the home folder"
msgstr "Tudo na pasta pessoal"

#: src/gloxi/backup_intro.py
#, python-brace-format
msgid "Everything in the home folder, without caches and Downloads ({size})"
msgstr "Tudo na pasta pessoal, sem caches nem Transferências ({size})"

#: src/gloxi/backup_intro.py
msgid "Gloxi checks that the backup fits"
msgstr "O Gloxi verifica se a cópia cabe"

#: src/gloxi/backup_intro.py
msgid "Gloxi checks whether backups are set up"
msgstr "O Gloxi verifica se as cópias estão configuradas"

#: src/gloxi/backup_intro.py
msgid "Gloxi measures how much space your folders take"
msgstr "O Gloxi mede quanto espaço ocupam as suas pastas"

#: src/gloxi/backup_intro.py
msgid ""
"Have your recovery sheet ready and run this in a terminal:\n"
"  vilna-backup recover <where the backups are>\n"
"Then: vilna-backup restore --in-place"
msgstr ""
"Tenha à mão a sua folha de recuperação e execute isto num terminal:\n"
"  vilna-backup recover <onde estão as cópias>\n"
"Depois: vilna-backup restore --in-place"

#: src/gloxi/backup_intro.py src/gloxi/vpn_intro.py
msgid "Herkos sent an answer Gloxi does not understand"
msgstr "O Herkos enviou uma resposta que o Gloxi não entende"

#: src/gloxi/backup_intro.py src/gloxi/vpn_intro.py
msgid "Herkos, the permission service, is not available"
msgstr "O Herkos, o serviço de permissões, não está disponível"

#: src/gloxi/backup_intro.py
msgid "How much space are you ready to give to backups?"
msgstr "Quanto espaço quer dedicar às cópias?"

#: src/gloxi/backup_intro.py
msgid "How often?"
msgstr "Com que frequência?"

#: src/gloxi/backup_intro.py
#, python-brace-format
msgid "I could not continue: {why}. We can go on later: type /backup."
msgstr "Não consegui continuar: {why}. Podemos continuar mais tarde: escreva /backup."

#: src/gloxi/backup_intro.py
msgid "I had Vilna before: restore from a backup"
msgstr "Já tinha o Vilna: restaurar a partir de uma cópia"

#: src/gloxi/backup_intro.py
#, python-brace-format
msgid "I will back up {what} (about {size}) {how} {where}."
msgstr "Vou fazer cópia de {what} (cerca de {size}) {how} {where}."

#: src/gloxi/backup_intro.py
msgid "Keep Gloxi conversations in backups"
msgstr "Incluir as conversas com o Gloxi nas cópias"

#: src/gloxi/backup_intro.py
msgid "Keep your conversations with Gloxi in backups too?"
msgstr "Incluir também as suas conversas com o Gloxi nas cópias?"

#: src/gloxi/backup_intro.py src/gloxi/vpn_intro.py
msgid "Later"
msgstr "Mais tarde"

#: src/gloxi/backup_intro.py
msgid "Leave large folders out of backups"
msgstr "Deixar as pastas grandes fora das cópias"

#: src/gloxi/backup_intro.py
msgid "Leave out Gloxi history"
msgstr "Deixar de fora o histórico do Gloxi"

#: src/gloxi/backup_intro.py
msgid "Music"
msgstr "Música"

#: src/gloxi/backup_intro.py
msgid "My own storage (S3, SFTP)"
msgstr "O meu próprio armazenamento (S3, SFTP)"

#: src/gloxi/backup_intro.py src/gloxi/feedback.py src/gloxi/vpn_intro.py
msgid "No"
msgstr "Não"

#: src/gloxi/backup_intro.py
msgid "No limit"
msgstr "Sem limite"

#: src/gloxi/backup_intro.py
msgid "No, I will give more space"
msgstr "Não, vou dar mais espaço"

#: src/gloxi/backup_intro.py
#, python-brace-format
msgid "Only settings ({size})"
msgstr "Só as definições ({size})"

#: src/gloxi/backup_intro.py
msgid "Passwords and accounts are switched on by you only:"
msgstr "As palavras-passe e as contas só são ativadas por si:"

#: src/gloxi/backup_intro.py
msgid "Pictures"
msgstr "Imagens"

#: src/gloxi/backup_intro.py
msgid "Set how much space backups may take"
msgstr "Definir quanto espaço as cópias podem ocupar"

#: src/gloxi/backup_intro.py
msgid "Set how often backups are made"
msgstr "Definir a frequência das cópias"

#: src/gloxi/backup_intro.py
#, python-brace-format
msgid "Settings and documents, recommended ({size})"
msgstr "Definições e documentos, recomendado ({size})"

#: src/gloxi/backup_intro.py
msgid "Settings are always kept. Which folders to add? Type their numbers, for example: 1 3"
msgstr "As definições são sempre guardadas. Que pastas adiciono? Escreva os números, por exemplo: 1 3"

#: src/gloxi/backup_intro.py
msgid "Settings, passwords, Gloxi and Herkos"
msgstr "Definições, palavras-passe, Gloxi e Herkos"

#: src/gloxi/backup_intro.py
msgid "Shall I keep backups of your data, so you do not lose it along with the computer?"
msgstr "Faço cópias dos seus dados para não os perder juntamente com o computador?"

#: src/gloxi/backup_intro.py
msgid "The Vilna cloud is not open yet in this preview. Choose another place."
msgstr "A nuvem Vilna ainda não está disponível nesta versão de pré-visualização. Escolha outro local."

#: src/gloxi/backup_intro.py
msgid "The last step is yours, because it is about keys: run this in a terminal. It shows the recovery key once; write it on paper and keep it away from the computer. Without it, backups cannot be restored if this computer is lost. The first backup starts right after."
msgstr "O último passo é seu, porque tem a ver com chaves: execute isto num terminal. Mostra a chave de recuperação uma só vez; anote-a em papel e guarde-a longe do computador. Sem ela, as cópias não podem ser restauradas se perder este computador. A primeira cópia começa logo a seguir."

#: src/gloxi/backup_intro.py
msgid "These are US companies: they see your account, the size and time of backups (not the contents), and a broken device could delete the backups. They are not in this preview yet. Choose another place."
msgstr "São empresas dos EUA: veem a sua conta, o tamanho e a hora das cópias (não o conteúdo), e um dispositivo comprometido poderia apagar as cópias. Ainda não estão nesta versão de pré-visualização. Escolha outro local."

#: src/gloxi/backup_intro.py
msgid "Type an amount in GB, e.g. 120"
msgstr "Escreva uma quantidade em GB, p. ex. 120"

#: src/gloxi/backup_intro.py
msgid "Type the numbers of the folders, for example: 1 3"
msgstr "Escreva os números das pastas, por exemplo: 1 3"

#: src/gloxi/backup_intro.py
msgid "Videos"
msgstr "Vídeos"

#: src/gloxi/backup_intro.py
msgid "Vilna cloud (EU)"
msgstr "Nuvem Vilna (UE)"

#: src/gloxi/backup_intro.py
msgid "We are not talking about backups now."
msgstr "Agora não estamos a falar de cópias."

#: src/gloxi/backup_intro.py
msgid "What shall we keep? This is how much space it takes now:"
msgstr "O que guardamos? Isto é o espaço que ocupa agora:"

#: src/gloxi/backup_intro.py
msgid "Where shall we keep them? Everything is encrypted on this computer first."
msgstr "Onde as guardamos? Tudo é primeiro encriptado neste computador."

#: src/gloxi/backup_intro.py src/gloxi/feedback.py
msgid "Yes"
msgstr "Sim"

#: src/gloxi/backup_intro.py
msgid "Yes, leave them out"
msgstr "Sim, deixá-las de fora"

#: src/gloxi/backup_intro.py
msgid "every day"
msgstr "todos os dias"

#: src/gloxi/backup_intro.py
msgid "every hour"
msgstr "a cada hora"

#: src/gloxi/backup_intro.py
msgid "every week"
msgstr "todas as semanas"

#: src/gloxi/backup_intro.py
msgid "everything in the home folder"
msgstr "tudo na pasta pessoal"

#: src/gloxi/backup_intro.py
msgid "in your own storage"
msgstr "no seu próprio armazenamento"

#: src/gloxi/backup_intro.py
msgid "no"
msgstr "não"

#: src/gloxi/backup_intro.py
msgid "on the external disk"
msgstr "no disco externo"

#: src/gloxi/backup_intro.py
msgid "settings"
msgstr "as definições"

#: src/gloxi/backup_intro.py
msgid "settings and documents"
msgstr "as definições e os documentos"

#: src/gloxi/backup_intro.py
msgid "settings and the folders you chose"
msgstr "as definições e as pastas que escolheu"

#: src/gloxi/backup_intro.py src/gloxi/cli.py src/gloxi/voice/cli.py
msgid "yes"
msgstr "sim"

#: src/gloxi/backup_intro.py
#, python-brace-format
msgid ""
"{size} does not fit into {limit}. Leave out these large folders (about {after} remains)?\n"
"{folders}"
msgstr ""
"{size} não cabe em {limit}. Deixar de fora estas pastas grandes (ficariam cerca de {after})?\n"
"{folders}"

#: src/gloxi/backup_intro.py
#, python-brace-format
msgid "{size} does not fit. Choose a larger amount."
msgstr "{size} não cabe. Escolha uma quantidade maior."

#: src/gloxi/check.py
msgid "Could not read the memory size; the local model may still work."
msgstr "Não foi possível ler o tamanho da memória; o modelo local pode funcionar mesmo assim."

#: src/gloxi/check.py
#, python-brace-format
msgid "Free disk space: {free}. The model needs {size}."
msgstr "Espaço livre no disco: {free}. O modelo precisa de {size}."

#: src/gloxi/check.py
#, python-brace-format
msgid "Gloxi starts {large} because its file is in the models folder, but the speed test has not shown that it is fast enough here. To go back to {small}, delete {file} from {folder}."
msgstr "O Gloxi inicia {large} porque o ficheiro está na pasta de modelos, mas o teste de velocidade não mostrou que seja suficientemente rápido aqui. Para voltar a {small}, apague {file} de {folder}."

#: src/gloxi/check.py
#, python-brace-format
msgid "Memory: {ram}. The local model needs at least 8 GB; Gloxi can still answer through the cloud with your own key."
msgstr "Memória: {ram}. O modelo local precisa de pelo menos 8 GB; o Gloxi ainda pode responder através da nuvem com a sua própria chave."

#: src/gloxi/check.py
msgid "The processor has no AVX2 (it is older than Intel Core 8th generation or Ryzen 2000), so the local model will be slow."
msgstr "O processador não tem AVX2 (é anterior aos Intel Core de 8.ª geração ou Ryzen 2000), por isso o modelo local vai ser lento."

#: src/gloxi/check.py
#, python-brace-format
msgid "This computer can run {name}."
msgstr "Este computador consegue executar {name}."

#: src/gloxi/check.py
#, python-brace-format
msgid "This computer can run {name}. Gloxi will measure once whether the larger model would be fast enough."
msgstr "Este computador consegue executar {name}. O Gloxi vai medir uma vez se o modelo maior seria suficientemente rápido."

#: src/gloxi/check.py
msgid "This computer is below the minimum for the local model."
msgstr "Este computador está abaixo do mínimo para o modelo local."

#: src/gloxi/check.py
#, python-brace-format
msgid "This computer is fast enough for the larger model, {name}."
msgstr "Este computador é suficientemente rápido para o modelo maior, {name}."

#: src/gloxi/check.py
msgid "To paste into the feedback form:"
msgstr "Para colar no formulário de opinião:"

#: src/gloxi/cli.py
msgid "(interrupted)"
msgstr "(interrompido)"

#: src/gloxi/cli.py src/gloxi/gui/controller.py
msgid "Backups need Herkos, and it is not running."
msgstr "As cópias precisam do Herkos, e ele não está a funcionar."

#: src/gloxi/cli.py src/gloxi/gui/controller.py
msgid "Checking how fast this computer runs the model (about a minute)…"
msgstr "A verificar a rapidez com que este computador executa o modelo (cerca de um minuto)…"

#: src/gloxi/cli.py
msgid "Cloud: off. Everything stays on this computer."
msgstr "Nuvem: desligada. Tudo fica neste computador."

#: src/gloxi/cli.py
#, python-brace-format
msgid "Cloud: on ({mode} mode)."
msgstr "Nuvem: ligada (modo {mode})."

#: src/gloxi/cli.py
msgid "Commands: /local <text> or /cloud <text> picks the model for one message, /reset clears the conversation, /backup sets up backups, /vpn sets up a VPN, /feedback reports a problem or suggests something, /exit quits."
msgstr "Comandos: /local <texto> ou /cloud <texto> escolhe o modelo para uma mensagem, /reset limpa a conversa, /backup configura as cópias de segurança, /vpn configura uma VPN, /feedback comunica um problema ou sugere algo, /exit sai."

#: src/gloxi/cli.py
msgid "Conversation cleared."
msgstr "Conversa limpa."

#: src/gloxi/cli.py src/gloxi/voice/cli.py
msgid "Download it now? [y/N] "
msgstr "Transferir agora? [s/N] "

#: src/gloxi/cli.py src/gloxi/gui/controller.py
#, python-brace-format
msgid "Downloading the model: {percent}%"
msgstr "A transferir o modelo: {percent} %"

#: src/gloxi/cli.py src/gloxi/gui/controller.py
msgid "Gloxi keeps the current model and will not ask again."
msgstr "O Gloxi mantém o modelo atual e não volta a perguntar."

#: src/gloxi/cli.py
#, python-brace-format
msgid "Gloxi needs a language model on this computer to answer. It is {name}, {size}, licence {licence}, from {source}. It will be kept in {folder}. Only the file is downloaded: nothing about you is sent."
msgstr "Para responder, o Gloxi precisa de um modelo de linguagem neste computador. É o {name}, {size}, licença {licence}, de {source}. Vai ser guardado em {folder}. Só o ficheiro é transferido: nada sobre si é enviado."

#: src/gloxi/cli.py
msgid ""
"Is llama-server running? For example:\n"
"  llama-server -m model.gguf --port 8080\n"
"or point Gloxi elsewhere with GLOXI_LOCAL_URL."
msgstr ""
"O llama-server está a funcionar? Por exemplo:\n"
"  llama-server -m model.gguf --port 8080\n"
"ou indique ao Gloxi outro endereço com GLOXI_LOCAL_URL."

#: src/gloxi/cli.py src/gloxi/gui/controller.py
msgid "Not downloaded. Gloxi will ask again next time."
msgstr "Não foi transferido. O Gloxi volta a perguntar da próxima vez."

#: src/gloxi/cli.py
msgid "Note: masking is off (mask_cloud = false), so messages sent to the cloud are NOT masked."
msgstr "Atenção: a ocultação está desligada (mask_cloud = false), por isso as mensagens enviadas para a nuvem NÃO são ocultadas."

#: src/gloxi/cli.py
#, python-brace-format
msgid "Open the app: {app}"
msgstr "Abra a aplicação: {app}"

#: src/gloxi/cli.py src/gloxi/gui/controller.py
#, python-brace-format
msgid "Starting {name} on this computer…"
msgstr "A iniciar {name} neste computador…"

#: src/gloxi/cli.py src/gloxi/gui/controller.py
msgid "The VPN needs Vilna and Herkos, and Herkos is not running."
msgstr "A VPN precisa do Vilna e do Herkos, e o Herkos não está a funcionar."

#: src/gloxi/cli.py src/gloxi/gui/controller.py
#, python-brace-format
msgid "The model could not be started: {why}"
msgstr "Não foi possível iniciar o modelo: {why}"

#: src/gloxi/cli.py
msgid "The model is ready."
msgstr "O modelo está pronto."

#: src/gloxi/cli.py src/gloxi/gui/controller.py
msgid "The model is ready. Gloxi will use it from the next start."
msgstr "O modelo está pronto. O Gloxi vai usá-lo a partir do próximo arranque."

#: src/gloxi/cli.py src/gloxi/gui/controller.py
#, python-brace-format
msgid "The model was not downloaded: {why}"
msgstr "O modelo não foi transferido: {why}"

#: src/gloxi/cli.py
msgid "There is no language model yet. Run gloxi in a terminal once to download it."
msgstr "Ainda não há nenhum modelo de linguagem. Execute o gloxi uma vez num terminal para o transferir."

#: src/gloxi/cli.py
#, python-brace-format
msgid "This computer is fast enough for a better model: {name}, {size}, licence {licence}, from {source}. It answers better, in Ukrainian too; Gloxi expects about {speed} tokens per second here. It will be kept in {folder}, next to the current model, and Gloxi will use it from the next start. Only the file is downloaded: nothing about you is sent."
msgstr "Este computador é suficientemente rápido para um modelo melhor: {name}, {size}, licença {licence}, de {source}. Responde melhor, também em ucraniano; o Gloxi espera cerca de {speed} tokens por segundo aqui. Vai ser guardado em {folder}, ao lado do modelo atual, e o Gloxi vai usá-lo a partir do próximo arranque. Só o ficheiro é transferido: nada sobre si é enviado."

#: src/gloxi/cli.py
msgid "Without a language model Gloxi cannot answer. Run gloxi again when you want to download it."
msgstr "Sem um modelo de linguagem, o Gloxi não consegue responder. Execute novamente o gloxi quando o quiser transferir."

#: src/gloxi/cli.py
#, python-brace-format
msgid "[cloud: {host}, masked]"
msgstr "[nuvem: {host}, ocultado]"

#: src/gloxi/cli.py
#, python-brace-format
msgid "[cloud: {host}, not masked]"
msgstr "[nuvem: {host}, não ocultado]"

#: src/gloxi/cli.py
msgid "[local]"
msgstr "[local]"

#: src/gloxi/engine.py
msgid "."
msgstr ","

#: src/gloxi/engine.py
msgid "Google on Hugging Face"
msgstr "Google no Hugging Face"

#: src/gloxi/engine.py
msgid "Mistral AI on Hugging Face"
msgstr "Mistral AI no Hugging Face"

#: src/gloxi/engine.py
msgid "Qwen (Alibaba Cloud) on Hugging Face"
msgstr "Qwen (Alibaba Cloud) no Hugging Face"

#: src/gloxi/engine.py
msgid "the model"
msgstr "o modelo"

#: src/gloxi/engine.py
#, python-brace-format
msgid "{value} GB"
msgstr "{value} GB"

#: src/gloxi/engine.py
#, python-brace-format
msgid "{value} MB"
msgstr "{value} MB"

#: src/gloxi/feedback.py
msgid "A suggestion"
msgstr "Uma sugestão"

#: src/gloxi/feedback.py
msgid "About this computer:"
msgstr "Sobre este computador:"

#: src/gloxi/feedback.py
msgid "All right, nothing was sent."
msgstr "Muito bem, nada foi enviado."

#: src/gloxi/feedback.py src/gloxi/gui/window.py
msgid "Cancel"
msgstr "Cancelar"

#: src/gloxi/feedback.py
msgid "Crash report:"
msgstr "Relatório de falha:"

#: src/gloxi/feedback.py
msgid "Expected:"
msgstr "Esperado:"

#: src/gloxi/feedback.py
msgid "Gloxi stopped with an error recently. Add that crash report?"
msgstr "O Gloxi parou há pouco com um erro. Adiciono esse relatório de falha?"

#: src/gloxi/feedback.py
#, python-brace-format
msgid "Hidden before showing it here: {what}."
msgstr "Ocultado antes de ser mostrado aqui: {what}."

#: src/gloxi/feedback.py
msgid "May I add what this computer is (system, processor, memory, graphics, models), as gloxi check shows it? Nothing personal."
msgstr "Posso adicionar que computador é este (sistema, processador, memória, gráficos, modelos), tal como o gloxi check mostra? Nada pessoal."

#: src/gloxi/feedback.py
msgid "Never mind"
msgstr "Esqueça"

#: src/gloxi/feedback.py
msgid "Open the form"
msgstr "Abrir o formulário"

#: src/gloxi/feedback.py
#, python-brace-format
msgid "Opening the form in your browser. Thank you! If it does not open: {url}"
msgstr "A abrir o formulário no navegador. Obrigado! Se não abrir: {url}"

#: src/gloxi/feedback.py
msgid "Please answer 1 or 2."
msgstr "Responda 1 ou 2."

#: src/gloxi/feedback.py
msgid "Please answer 1, 2 or 3."
msgstr "Responda 1, 2 ou 3."

#: src/gloxi/feedback.py
msgid "Please write a few words, or /cancel to stop."
msgstr "Escreva algumas palavras, ou /cancel para parar."

#: src/gloxi/feedback.py src/gloxi/gui/panel.py
msgid "Something went wrong"
msgstr "Algo correu mal"

#: src/gloxi/feedback.py
msgid "Suggestion:"
msgstr "Sugestão:"

#: src/gloxi/feedback.py
msgid "This is public: anyone can read it on GitHub, and you need a GitHub account to send it. The form opens in your browser, where you can still change everything; it is sent only when you press Create there."
msgstr "Isto é público: qualquer pessoa pode lê-lo no GitHub, e precisa de uma conta GitHub para o enviar. O formulário abre-se no navegador, onde ainda pode alterar tudo; só é enviado quando carregar em Create lá."

#: src/gloxi/feedback.py
#, python-brace-format
msgid "This sounds like a security problem. Please do not post it publicly: report it privately at {url}"
msgstr "Isto parece um problema de segurança. Não o publique: comunique-o em privado em {url}"

#: src/gloxi/feedback.py
msgid "Title:"
msgstr "Título:"

#: src/gloxi/feedback.py
msgid "What did you do or ask, and what happened?"
msgstr "O que fez ou pediu, e o que aconteceu?"

#: src/gloxi/feedback.py
msgid "What did you expect instead? (Enter to skip)"
msgstr "O que esperava em vez disso? (Enter para ignorar)"

#: src/gloxi/feedback.py
msgid "What happened:"
msgstr "O que aconteceu:"

#: src/gloxi/feedback.py
msgid "What would you like to tell us?"
msgstr "O que nos quer contar?"

#: src/gloxi/feedback.py
msgid "What would you suggest? A sentence or two is enough."
msgstr "O que sugere? Basta uma ou duas frases."

#: src/gloxi/feedback.py
msgid "a card number"
msgstr "um número de cartão"

#: src/gloxi/feedback.py
msgid "a date of birth"
msgstr "uma data de nascimento"

#: src/gloxi/feedback.py
msgid "a name"
msgstr "um nome"

#: src/gloxi/feedback.py
msgid "a passport number"
msgstr "um número de passaporte"

#: src/gloxi/feedback.py
msgid "a password or key"
msgstr "uma palavra-passe ou chave"

#: src/gloxi/feedback.py
msgid "a personal ID number"
msgstr "um número de identificação pessoal"

#: src/gloxi/feedback.py
msgid "a phone number"
msgstr "um número de telefone"

#: src/gloxi/feedback.py
msgid "a profile link"
msgstr "uma ligação para um perfil"

