msgstr "{what} (abgelehnt: {message})"

#: src/gloxi/tools.py
#, python-brace-format
msgid "{what} (done)"
msgstr "{what} (erledigt)"

#: src/gloxi/tools.py
#, python-brace-format
msgid "{what} (done; warning: the content {warnings})"
msgstr "{what} (erledigt; Warnung: Der Inhalt {warnings})"

#: src/gloxi/tools.py
#, python-brace-format
msgid "{what} (error: {message})"
msgstr "{what} (Fehler: {message})"
