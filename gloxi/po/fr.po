#: src/gloxi/gui/window.py
msgid "Actions hidden from Gloxi"
msgstr "Actions cachées à Gloxi"

#: src/gloxi/gui/window.py
msgid "Add folder…"
msgstr "Ajouter un dossier…"

#: src/gloxi/gui/window.py
msgid "Ask Gloxi… (/local or /cloud to pick the model)"
msgstr "Demandez à Gloxi… (/local ou /cloud pour choisir le modèle)"

#: src/gloxi/gui/window.py
msgid "Choose a folder for Gloxi"
msgstr "Choisir un dossier pour Gloxi"

#: src/gloxi/gui/window.py
msgid "Download"
msgstr "Télécharger"

#: src/gloxi/gui/window.py
msgid "Download the language model?"
msgstr "Télécharger le modèle de langage ?"

#: src/gloxi/gui/window.py
msgid "Folders Gloxi may use"
msgstr "Dossiers que Gloxi peut utiliser"

#: src/gloxi/gui/window.py
msgid "Gloxi can use only the programs you turn on here. Herkos asks you before turning one on, and every action still goes through it."
msgstr "Gloxi ne peut utiliser que les programmes que vous activez ici. Herkos vous demande avant d’en activer un, et chaque action passe toujours par lui."

#: src/gloxi/gui/window.py
msgid "Gloxi sees only the folders you choose here, and every action in them goes through Herkos, which asks you first."
msgstr "Gloxi ne voit que les dossiers que vous choisissez ici, et chaque action dedans passe par Herkos, qui vous demande d’abord."

#: src/gloxi/gui/window.py
#, python-brace-format
msgid "Herkos could not change it: {why}"
msgstr "Herkos n’a pas pu le modifier : {why}"

#: src/gloxi/gui/window.py
#, python-brace-format
msgid "Herkos could not restart: {why}"
msgstr "Herkos n’a pas pu redémarrer : {why}"

#: src/gloxi/gui/window.py
msgid "Herkos found something suspicious in how the program describes them."
msgstr "Herkos a trouvé quelque chose de suspect dans la façon dont le programme les décrit."

#: src/gloxi/gui/window.py
msgid "It starts the next time Herkos starts."
msgstr "Il démarre au prochain démarrage de Herkos."

#: src/gloxi/gui/window.py
msgid "Model"
msgstr "Modèle"

#: src/gloxi/gui/window.py
msgid "New conversation"
msgstr "Nouvelle conversation"

#: src/gloxi/gui/window.py
msgid "No folders yet: Gloxi cannot see any of your files."
msgstr "Pas encore de dossiers : Gloxi ne voit aucun de vos fichiers."

#: src/gloxi/gui/window.py
msgid "No programs for Gloxi are installed."
msgstr "Aucun programme pour Gloxi n’est installé."

#: src/gloxi/gui/window.py
msgid "Not now"
msgstr "Pas maintenant"

#: src/gloxi/gui/window.py
msgid "Not turned on: you said no in the Herkos window."
msgstr "Non activé : vous avez refusé dans la fenêtre de Herkos."

#: src/gloxi/gui/window.py
msgid "Only the local model: turn the cloud on in the settings to choose another"
msgstr "Seulement le modèle local : activez le cloud dans les paramètres pour en choisir un autre"

#: src/gloxi/gui/window.py
msgid "Programs for Gloxi"
msgstr "Programmes pour Gloxi"

#: src/gloxi/gui/window.py
msgid "Report a problem or suggest something"
msgstr "Signaler un problème ou proposer une idée"

#: src/gloxi/gui/window.py
msgid "Send"
msgstr "Envoyer"

#: src/gloxi/gui/window.py
msgid "Stop sharing this folder"
msgstr "Ne plus partager ce dossier"

#: src/gloxi/programs.py
msgid "Off: Gloxi cannot use it"
msgstr "Désactivé : Gloxi ne peut pas l’utiliser"

#: src/gloxi/programs.py
msgid "On"
msgstr "Activé"

#: src/gloxi/programs.py
msgid "On: starts when Herkos starts again"
msgstr "Activé : démarre au prochain démarrage de Herkos"

#: src/gloxi/programs.py
msgid "You turned this program on in Gloxi's settings"
msgstr "Vous avez activé ce programme dans les paramètres de Gloxi"

#: src/gloxi/router.py
msgid "Note: the cloud model changed some masked values, so they could not be put back. Check the answer before you use it."
msgstr "Remarque : le modèle dans le cloud a modifié certaines valeurs masquées, elles n’ont donc pas pu être rétablies. Vérifiez la réponse avant de l’utiliser."

