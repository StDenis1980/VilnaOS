#: src/gloxi/backup_intro.py
msgid "All right. I will ask once more in a week. You can also type /backup any time."
msgstr "D’accord. Je vous redemanderai dans une semaine. Vous pouvez aussi taper /backup à tout moment."

#: src/gloxi/backup_intro.py
msgid "An external disk"
msgstr "Un disque externe"

#: src/gloxi/backup_intro.py
msgid "And Wi-Fi passwords, online accounts, SSH and GPG keys?"
msgstr "Et les mots de passe Wi-Fi, les comptes en ligne, les clés SSH et GPG ?"

#: src/gloxi/backup_intro.py
#, python-brace-format
msgid "Choose a number from 1 to {n}."
msgstr "Choisissez un nombre de 1 à {n}."

#: src/gloxi/backup_intro.py
msgid "Choose a number from the list, or type an amount in GB, e.g. 120"
msgstr "Choisissez un nombre dans la liste ou tapez une taille en Go, par ex. 120"

#: src/gloxi/backup_intro.py
msgid "Choose myself"
msgstr "Choisir moi-même"

#: src/gloxi/backup_intro.py
msgid "Choose what goes into backups"
msgstr "Choisir ce qui va dans les sauvegardes"

#: src/gloxi/backup_intro.py
msgid "Desktop"
msgstr "Bureau"

#: src/gloxi/backup_intro.py
msgid "Documents"
msgstr "Documents"

#: src/gloxi/backup_intro.py
msgid "Downloads"
msgstr "Téléchargements"

#: src/gloxi/backup_intro.py
msgid "Dropbox, OneDrive, Google Drive"
msgstr "Dropbox, OneDrive, Google Drive"

#: src/gloxi/backup_intro.py
msgid "Every day, recommended"
msgstr "Chaque jour, recommandé"

#: src/gloxi/backup_intro.py
msgid "Every hour"
msgstr "Chaque heure"

#: src/gloxi/backup_intro.py
msgid "Every week"
msgstr "Chaque semaine"

#: src/gloxi/backup_intro.py
msgid "Everything in the home folder"
msgstr "Tout le dossier personnel"

#: src/gloxi/backup_intro.py
#, python-brace-format
msgid "Everything in the home folder, without caches and Downloads ({size})"
msgstr "Tout le dossier personnel, sans les caches ni Téléchargements ({size})"

#: src/gloxi/backup_intro.py
msgid "Gloxi checks that the backup fits"
msgstr "Gloxi vérifie que la sauvegarde tient"

#: src/gloxi/backup_intro.py
msgid "Gloxi checks whether backups are set up"
msgstr "Gloxi vérifie si les sauvegardes sont configurées"

#: src/gloxi/backup_intro.py
msgid "Gloxi measures how much space your folders take"
msgstr "Gloxi mesure la place occupée par vos dossiers"

#: src/gloxi/backup_intro.py
msgid ""
"Have your recovery sheet ready and run this in a terminal:\n"
"  vilna-backup recover <where the backups are>\n"
"Then: vilna-backup restore --in-place"
msgstr ""
"Préparez votre feuille de récupération et lancez ceci dans un terminal :\n"
"  vilna-backup recover <où sont les sauvegardes>\n"
"Puis : vilna-backup restore --in-place"

#: src/gloxi/backup_intro.py
msgid "Herkos sent an answer Gloxi does not understand"
msgstr "Herkos a envoyé une réponse que Gloxi ne comprend pas"

#: src/gloxi/backup_intro.py
msgid "Herkos, the permission service, is not available"
msgstr "Herkos, le service d’autorisations, n’est pas disponible"

#: src/gloxi/backup_intro.py
msgid "How much space are you ready to give to backups?"
msgstr "Quelle place voulez-vous accorder aux sauvegardes ?"

#: src/gloxi/backup_intro.py
msgid "How often?"
msgstr "À quelle fréquence ?"

#: src/gloxi/backup_intro.py
#, python-brace-format
msgid "I could not continue: {why}. We can go on later: type /backup."
msgstr "Je n’ai pas pu continuer : {why}. Nous pourrons reprendre plus tard : tapez /backup."

#: src/gloxi/backup_intro.py
msgid "I had Vilna before: restore from a backup"
msgstr "J’avais déjà Vilna : restaurer depuis une sauvegarde"

#: src/gloxi/backup_intro.py
#, python-brace-format
msgid "I will back up {what} (about {size}) {how} {where}."
msgstr "Je sauvegarderai {what} (environ {size}) {how} {where}."

#: src/gloxi/backup_intro.py
msgid "Keep Gloxi conversations in backups"
msgstr "Garder les conversations avec Gloxi dans les sauvegardes"

#: src/gloxi/backup_intro.py
msgid "Keep your conversations with Gloxi in backups too?"
msgstr "Garder aussi vos conversations avec Gloxi dans les sauvegardes ?"

#: src/gloxi/backup_intro.py
msgid "Later"
msgstr "Plus tard"

#: src/gloxi/backup_intro.py
msgid "Leave large folders out of backups"
msgstr "Exclure les gros dossiers des sauvegardes"

#: src/gloxi/backup_intro.py
msgid "Leave out Gloxi history"
msgstr "Exclure l’historique de Gloxi"

#: src/gloxi/backup_intro.py
msgid "Music"
msgstr "Musique"

#: src/gloxi/backup_intro.py
msgid "My own storage (S3, SFTP)"
msgstr "Mon propre stockage (S3, SFTP)"

#: src/gloxi/backup_intro.py src/gloxi/feedback.py
msgid "No"
msgstr "Non"

#: src/gloxi/backup_intro.py
msgid "No limit"
msgstr "Pas de limite"

#: src/gloxi/backup_intro.py
msgid "No, I will give more space"
msgstr "Non, je donnerai plus de place"

#: src/gloxi/backup_intro.py
#, python-brace-format
msgid "Only settings ({size})"
msgstr "Seulement les paramètres ({size})"

#: src/gloxi/backup_intro.py
msgid "Passwords and accounts are switched on by you only:"
msgstr "Les mots de passe et les comptes, c’est vous seul qui les activez :"

#: src/gloxi/backup_intro.py
msgid "Pictures"
msgstr "Images"

#: src/gloxi/backup_intro.py
msgid "Set how much space backups may take"
msgstr "Définir la place que peuvent occuper les sauvegardes"

#: src/gloxi/backup_intro.py
msgid "Set how often backups are made"
msgstr "Définir la fréquence des sauvegardes"

#: src/gloxi/backup_intro.py
#, python-brace-format
msgid "Settings and documents, recommended ({size})"
msgstr "Paramètres et documents, recommandé ({size})"

#: src/gloxi/backup_intro.py
msgid "Settings are always kept. Which folders to add? Type their numbers, for example: 1 3"
msgstr "Les paramètres sont toujours gardés. Quels dossiers ajouter ? Tapez leurs numéros, par exemple : 1 3"

#: src/gloxi/backup_intro.py
msgid "Settings, passwords, Gloxi and Herkos"
msgstr "Paramètres, mots de passe, Gloxi et Herkos"

#: src/gloxi/backup_intro.py
msgid "Shall I keep backups of your data, so you do not lose it along with the computer?"
msgstr "Dois-je sauvegarder vos données, pour que vous ne les perdiez pas avec l’ordinateur ?"

#: src/gloxi/backup_intro.py
msgid "The Vilna cloud is not open yet in this preview. Choose another place."
msgstr "Le cloud Vilna n’est pas encore ouvert dans cette préversion. Choisissez un autre emplacement."

#: src/gloxi/backup_intro.py
msgid "The last step is yours, because it is about keys: run this in a terminal. It shows the recovery key once; write it on paper and keep it away from the computer. Without it, backups cannot be restored if this computer is lost. The first backup starts right after."
msgstr "La dernière étape vous revient, car elle concerne les clés : lancez ceci dans un terminal. La clé de récupération s’affiche une seule fois ; notez-la sur papier et gardez-la loin de l’ordinateur. Sans elle, les sauvegardes ne peuvent pas être restaurées si cet ordinateur est perdu. La première sauvegarde commence juste après."

#: src/gloxi/backup_intro.py
msgid "These are US companies: they see your account, the size and time of backups (not the contents), and a broken device could delete the backups. They are not in this preview yet. Choose another place."
msgstr "Ce sont des entreprises américaines : elles voient votre compte, la taille et l’heure des sauvegardes (pas leur contenu), et un appareil compromis pourrait effacer les sauvegardes. Elles ne sont pas encore dans cette préversion. Choisissez un autre emplacement."

#: src/gloxi/backup_intro.py
msgid "Type an amount in GB, e.g. 120"
msgstr "Tapez une taille en Go, par ex. 120"

#: src/gloxi/backup_intro.py
msgid "Type the numbers of the folders, for example: 1 3"
msgstr "Tapez les numéros des dossiers, par exemple : 1 3"

#: src/gloxi/backup_intro.py
msgid "Videos"
msgstr "Vidéos"

#: src/gloxi/backup_intro.py
msgid "Vilna cloud (EU)"
msgstr "Cloud Vilna (UE)"

#: src/gloxi/backup_intro.py
msgid "We are not talking about backups now."
msgstr "Nous ne parlons pas de sauvegardes en ce moment."

#: src/gloxi/backup_intro.py
msgid "What shall we keep? This is how much space it takes now:"
msgstr "Que garder ? Voici la place que cela occupe maintenant :"

#: src/gloxi/backup_intro.py
msgid "Where shall we keep them? Everything is encrypted on this computer first."
msgstr "Où les garder ? Tout est d’abord chiffré sur cet ordinateur."

#: src/gloxi/backup_intro.py src/gloxi/feedback.py
msgid "Yes"
msgstr "Oui"

#: src/gloxi/backup_intro.py
msgid "Yes, leave them out"
msgstr "Oui, les exclure"

#: src/gloxi/backup_intro.py
msgid "every day"
msgstr "chaque jour"

#: src/gloxi/backup_intro.py
msgid "every hour"
msgstr "chaque heure"

#: src/gloxi/backup_intro.py
msgid "every week"
msgstr "chaque semaine"

#: src/gloxi/backup_intro.py
msgid "everything in the home folder"
msgstr "tout le dossier personnel"

#: src/gloxi/backup_intro.py
msgid "in your own storage"
msgstr "dans votre propre stockage"

#: src/gloxi/backup_intro.py
msgid "no"
msgstr "non"

#: src/gloxi/backup_intro.py
msgid "on the external disk"
msgstr "sur le disque externe"

#: src/gloxi/backup_intro.py
msgid "settings"
msgstr "les paramètres"

#: src/gloxi/backup_intro.py
msgid "settings and documents"
msgstr "les paramètres et les documents"

#: src/gloxi/backup_intro.py
msgid "settings and the folders you chose"
msgstr "les paramètres et les dossiers choisis"

#: src/gloxi/backup_intro.py src/gloxi/cli.py
msgid "yes"
msgstr "oui"

#: src/gloxi/backup_intro.py
#, python-brace-format
msgid ""
"{size} does not fit into {limit}. Leave out these large folders (about {after} remains)?\n"
"{folders}"
msgstr ""
"{size} ne tient pas dans {limit}. Exclure ces gros dossiers (il reste environ {after}) ?\n"
"{folders}"

#: src/gloxi/backup_intro.py
#, python-brace-format
msgid "{size} does not fit. Choose a larger amount."
msgstr "{size} ne tient pas. Choisissez une taille plus grande."

#: src/gloxi/check.py
msgid "Could not read the memory size; the local model may still work."
msgstr "Impossible de lire la taille de la mémoire ; le modèle local peut quand même fonctionner."

#: src/gloxi/check.py
#, python-brace-format
msgid "Free disk space: {free}. The model needs {size}."
msgstr "Espace disque libre : {free}. Le modèle a besoin de {size}."

#: src/gloxi/check.py
#, python-brace-format
msgid "Gloxi starts {large} because its file is in the models folder, but the speed test has not shown that it is fast enough here. To go back to {small}, delete {file} from {folder}."
msgstr "Gloxi lance {large} car son fichier est dans le dossier des modèles, mais le test de vitesse n’a pas montré qu’il est assez rapide ici. Pour revenir à {small}, supprimez {file} de {folder}."

#: src/gloxi/check.py
#, python-brace-format
msgid "Memory: {ram}. The local model needs at least 8 GB; Gloxi can still answer through the cloud with your own key."
msgstr "Mémoire : {ram}. Le modèle local a besoin d’au moins 8 Go ; Gloxi peut tout de même répondre via le cloud avec votre propre clé."

#: src/gloxi/check.py
msgid "The processor has no AVX2 (it is older than Intel Core 8th generation or Ryzen 2000), so the local model will be slow."
msgstr "Le processeur n’a pas AVX2 (il est plus ancien qu’un Intel Core de 8ᵉ génération ou un Ryzen 2000), le modèle local sera donc lent."

#: src/gloxi/check.py
#, python-brace-format
msgid "This computer can run {name}."
msgstr "Cet ordinateur peut faire tourner {name}."

#: src/gloxi/check.py
#, python-brace-format
msgid "This computer can run {name}. Gloxi will measure once whether the larger model would be fast enough."
msgstr "Cet ordinateur peut faire tourner {name}. Gloxi mesurera une fois si le modèle plus grand serait assez rapide."

#: src/gloxi/check.py
msgid "This computer is below the minimum for the local model."
msgstr "Cet ordinateur est en dessous du minimum pour le modèle local."

#: src/gloxi/check.py
#, python-brace-format
msgid "This computer is fast enough for the larger model, {name}."
msgstr "Cet ordinateur est assez rapide pour le modèle plus grand, {name}."

#: src/gloxi/check.py
msgid "To paste into the feedback form:"
msgstr "À coller dans le formulaire de retour :"

#: src/gloxi/cli.py
msgid "(interrupted)"
msgstr "(interrompu)"

#: src/gloxi/cli.py src/gloxi/gui/controller.py
msgid "Backups need Herkos, and it is not running."
msgstr "Les sauvegardes ont besoin de Herkos, et il ne tourne pas."

#: src/gloxi/cli.py src/gloxi/gui/controller.py
msgid "Checking how fast this computer runs the model (about a minute)…"
msgstr "Mesure de la vitesse de cet ordinateur avec le modèle (environ une minute)…"

#: src/gloxi/cli.py
msgid "Cloud: off. Everything stays on this computer."
msgstr "Cloud : désactivé. Tout reste sur cet ordinateur."

#: src/gloxi/cli.py
#, python-brace-format
msgid "Cloud: on ({mode} mode)."
msgstr "Cloud : activé (mode {mode})."

#: src/gloxi/cli.py
msgid "Commands: /local <text> or /cloud <text> picks the model for one message, /reset clears the conversation, /backup sets up backups, /feedback reports a problem or suggests something, /exit quits."
msgstr "Commandes : /local <texte> ou /cloud <texte> choisit le modèle pour un message, /reset efface la conversation, /backup configure les sauvegardes, /feedback signale un problème ou propose une idée, /exit quitte."

#: src/gloxi/cli.py
msgid "Conversation cleared."
msgstr "Conversation effacée."

#: src/gloxi/cli.py
msgid "Download it now? [y/N] "
msgstr "Le télécharger maintenant ? [o/N] "

#: src/gloxi/cli.py src/gloxi/gui/controller.py
#, python-brace-format
msgid "Downloading the model: {percent}%"
msgstr "Téléchargement du modèle : {percent} %"

#: src/gloxi/cli.py src/gloxi/gui/controller.py
msgid "Gloxi keeps the current model and will not ask again."
msgstr "Gloxi garde le modèle actuel et ne redemandera pas."

#: src/gloxi/cli.py
#, python-brace-format
msgid "Gloxi needs a language model on this computer to answer. It is {name}, {size}, licence {licence}, from {source}. It will be kept in {folder}. Only the file is downloaded: nothing about you is sent."
msgstr "Gloxi a besoin d’un modèle de langage sur cet ordinateur pour répondre. C’est {name}, {size}, licence {licence}, depuis {source}. Il sera gardé dans {folder}. Seul le fichier est téléchargé : rien sur vous n’est envoyé."

#: src/gloxi/cli.py
msgid ""
"Is llama-server running? For example:\n"
"  llama-server -m model.gguf --port 8080\n"
"or point Gloxi elsewhere with GLOXI_LOCAL_URL."
msgstr ""
"llama-server est-il lancé ? Par exemple :\n"
"  llama-server -m model.gguf --port 8080\n"
"ou indiquez une autre adresse à Gloxi avec GLOXI_LOCAL_URL."

#: src/gloxi/cli.py src/gloxi/gui/controller.py
msgid "Not downloaded. Gloxi will ask again next time."
msgstr "Non téléchargé. Gloxi redemandera la prochaine fois."

#: src/gloxi/cli.py
msgid "Note: masking is off (mask_cloud = false), so messages sent to the cloud are NOT masked."
msgstr "Remarque : le masquage est désactivé (mask_cloud = false), les messages envoyés au cloud ne sont donc PAS masqués."

#: src/gloxi/cli.py src/gloxi/gui/controller.py
#, python-brace-format
msgid "Starting {name} on this computer…"
msgstr "Démarrage de {name} sur cet ordinateur…"

#: src/gloxi/cli.py src/gloxi/gui/controller.py
#, python-brace-format
msgid "The model could not be started: {why}"
msgstr "Le modèle n’a pas pu démarrer : {why}"

#: src/gloxi/cli.py
msgid "The model is ready."
msgstr "Le modèle est prêt."

#: src/gloxi/cli.py src/gloxi/gui/controller.py
msgid "The model is ready. Gloxi will use it from the next start."
msgstr "Le modèle est prêt. Gloxi l’utilisera au prochain démarrage."

#: src/gloxi/cli.py src/gloxi/gui/controller.py
#, python-brace-format
msgid "The model was not downloaded: {why}"
msgstr "Le modèle n’a pas été téléchargé : {why}"

#: src/gloxi/cli.py
msgid "There is no language model yet. Run gloxi in a terminal once to download it."
msgstr "Il n’y a pas encore de modèle de langage. Lancez gloxi une fois dans un terminal pour le télécharger."

#: src/gloxi/cli.py
#, python-brace-format
msgid "This computer is fast enough for a better model: {name}, {size}, licence {licence}, from {source}. It answers better, in Ukrainian too; Gloxi expects about {speed} tokens per second here. It will be kept in {folder}, next to the current model, and Gloxi will use it from the next start. Only the file is downloaded: nothing about you is sent."
msgstr "Cet ordinateur est assez rapide pour un meilleur modèle : {name}, {size}, licence {licence}, depuis {source}. Il répond mieux, en ukrainien aussi ; Gloxi attend ici environ {speed} jetons par seconde. Il sera gardé dans {folder}, à côté du modèle actuel, et Gloxi l’utilisera au prochain démarrage. Seul le fichier est téléchargé : rien sur vous n’est envoyé."

#: src/gloxi/cli.py
msgid "Without a language model Gloxi cannot answer. Run gloxi again when you want to download it."
msgstr "Sans modèle de langage, Gloxi ne peut pas répondre. Relancez gloxi quand vous voudrez le télécharger."

#: src/gloxi/cli.py
#, python-brace-format
msgid "[cloud: {host}, masked]"
msgstr "[cloud : {host}, masqué]"

#: src/gloxi/cli.py
#, python-brace-format
msgid "[cloud: {host}, not masked]"
msgstr "[cloud : {host}, non masqué]"

#: src/gloxi/cli.py
msgid "[local]"
msgstr "[local]"

#: src/gloxi/engine.py
msgid "."
msgstr ","

#: src/gloxi/engine.py
msgid "Mistral AI on Hugging Face"
msgstr "Mistral AI sur Hugging Face"

#: src/gloxi/engine.py
msgid "Qwen (Alibaba Cloud) on Hugging Face"
msgstr "Qwen (Alibaba Cloud) sur Hugging Face"

#: src/gloxi/engine.py
msgid "the model"
msgstr "le modèle"

#: src/gloxi/engine.py
#, python-brace-format
msgid "{value} GB"
msgstr "{value} Go"

#: src/gloxi/engine.py
#, python-brace-format
msgid "{value} MB"
msgstr "{value} Mo"

#: src/gloxi/feedback.py
msgid "A suggestion"
msgstr "Une suggestion"

#: src/gloxi/feedback.py
msgid "About this computer:"
msgstr "À propos de cet ordinateur :"

#: src/gloxi/feedback.py
msgid "All right, nothing was sent."
msgstr "D’accord, rien n’a été envoyé."

#: src/gloxi/feedback.py src/gloxi/gui/window.py
msgid "Cancel"
msgstr "Annuler"

#: src/gloxi/feedback.py
msgid "Crash report:"
msgstr "Rapport de plantage :"

#: src/gloxi/feedback.py
msgid "Expected:"
msgstr "Attendu :"

#: src/gloxi/feedback.py
msgid "Gloxi stopped with an error recently. Add that crash report?"
msgstr "Gloxi s’est récemment arrêté sur une erreur. Ajouter ce rapport de plantage ?"

#: src/gloxi/feedback.py
#, python-brace-format
msgid "Hidden before showing it here: {what}."
msgstr "Masqué avant l’affichage ici : {what}."

#: src/gloxi/feedback.py
msgid "May I add what this computer is (system, processor, memory, graphics, models), as gloxi check shows it? Nothing personal."
msgstr "Puis-je ajouter de quel ordinateur il s’agit (système, processeur, mémoire, carte graphique, modèles), comme l’affiche gloxi check ? Rien de personnel."

#: src/gloxi/feedback.py
msgid "Never mind"
msgstr "Laisser tomber"

#: src/gloxi/feedback.py
msgid "Open the form"
msgstr "Ouvrir le formulaire"

#: src/gloxi/feedback.py
#, python-brace-format
msgid "Opening the form in your browser. Thank you! If it does not open: {url}"
msgstr "Ouverture du formulaire dans votre navigateur. Merci ! S’il ne s’ouvre pas : {url}"

#: src/gloxi/feedback.py
msgid "Please answer 1 or 2."
msgstr "Répondez 1 ou 2, s’il vous plaît."

#: src/gloxi/feedback.py
msgid "Please answer 1, 2 or 3."
msgstr "Répondez 1, 2 ou 3, s’il vous plaît."

#: src/gloxi/feedback.py
msgid "Please write a few words, or /cancel to stop."
msgstr "Écrivez quelques mots, ou /cancel pour arrêter."

#: src/gloxi/feedback.py
msgid "Something went wrong"
msgstr "Quelque chose s’est mal passé"

#: src/gloxi/feedback.py
msgid "Suggestion:"
msgstr "Suggestion :"

#: src/gloxi/feedback.py
msgid "This is public: anyone can read it on GitHub, and you need a GitHub account to send it. The form opens in your browser, where you can still change everything; it is sent only when you press Create there."
msgstr "C’est public : tout le monde peut le lire sur GitHub, et il faut un compte GitHub pour l’envoyer. Le formulaire s’ouvre dans votre navigateur, où vous pouvez encore tout modifier ; il n’est envoyé que lorsque vous y appuyez sur Create."

#: src/gloxi/feedback.py
#, python-brace-format
msgid "This sounds like a security problem. Please do not post it publicly: report it privately at {url}"
msgstr "Cela ressemble à un problème de sécurité. Ne le publiez pas : signalez-le en privé sur {url}"

#: src/gloxi/feedback.py
msgid "Title:"
msgstr "Titre :"

#: src/gloxi/feedback.py
msgid "What did you do or ask, and what happened?"
msgstr "Qu’avez-vous fait ou demandé, et que s’est-il passé ?"

#: src/gloxi/feedback.py
msgid "What did you expect instead? (Enter to skip)"
msgstr "Qu’attendiez-vous à la place ? (Entrée pour passer)"

#: src/gloxi/feedback.py
msgid "What happened:"
msgstr "Ce qui s’est passé :"

#: src/gloxi/feedback.py
msgid "What would you like to tell us?"
msgstr "Que voulez-vous nous dire ?"

#: src/gloxi/feedback.py
msgid "What would you suggest? A sentence or two is enough."
msgstr "Que proposez-vous ? Une phrase ou deux suffisent."

#: src/gloxi/feedback.py
msgid "a card number"
msgstr "un numéro de carte"

#: src/gloxi/feedback.py
msgid "a date of birth"
msgstr "une date de naissance"

#: src/gloxi/feedback.py
msgid "a name"
msgstr "un nom"

#: src/gloxi/feedback.py
msgid "a passport number"
msgstr "un numéro de passeport"

#: src/gloxi/feedback.py
msgid "a password or key"
msgstr "un mot de passe ou une clé"

#: src/gloxi/feedback.py
msgid "a personal ID number"
msgstr "un numéro d’identification personnel"

#: src/gloxi/feedback.py
msgid "a phone number"
msgstr "un numéro de téléphone"

#: src/gloxi/feedback.py
msgid "a profile link"
msgstr "un lien de profil"

#: src/gloxi/feedback.py
msgid "a tax number"
msgstr "un numéro fiscal"

#: src/gloxi/feedback.py
msgid "an IP address"
msgstr "une adresse IP"

#: src/gloxi/feedback.py
msgid "an account number"
msgstr "un numéro de compte"

#: src/gloxi/feedback.py
msgid "an address"
msgstr "une adresse postale"

#: src/gloxi/feedback.py
msgid "an e-mail address"
msgstr "une adresse e-mail"

#: src/gloxi/gui/controller.py
msgid "Auto"
msgstr "Auto"

#: src/gloxi/gui/controller.py
msgid "Cannot reach the cloud model."
msgstr "Impossible de joindre le modèle dans le cloud."

#: src/gloxi/gui/controller.py
msgid "Cloud"
msgstr "Cloud"

#: src/gloxi/gui/controller.py
msgid "Cloud off: everything stays on this computer"
msgstr "Cloud désactivé : tout reste sur cet ordinateur"

#: src/gloxi/gui/controller.py
msgid "Cloud on, masking is off: messages are NOT masked"
