msgid ""
msgstr ""
"Project-Id-Version: gloxi\n"
"Report-Msgid-Bugs-To: https://github.com/StDenis1980/VilnaOS/issues\n"
"Language: uk\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"

#: src/gloxi/backup_intro.py
msgid "All right. I will ask once more in a week. You can also type /backup any time."
msgstr "Гаразд. Я спитаю ще раз за тиждень. Також можна будь-коли написати /backup."

#: src/gloxi/backup_intro.py
msgid "An external disk"
msgstr "Зовнішній диск"

#: src/gloxi/backup_intro.py
msgid "And Wi-Fi passwords, online accounts, SSH and GPG keys?"
msgstr "А паролі Wi-Fi, облікові записи в мережі, ключі SSH і GPG?"

#: src/gloxi/backup_intro.py src/gloxi/vpn_intro.py
#, python-brace-format
msgid "Choose a number from 1 to {n}."
msgstr "Виберіть число від 1 до {n}."

#: src/gloxi/backup_intro.py
msgid "Choose a number from the list, or type an amount in GB, e.g. 120"
msgstr "Виберіть число зі списку або введіть обсяг у ГБ, наприклад 120"

#: src/gloxi/backup_intro.py
msgid "Choose myself"
msgstr "Виберу сам"

#: src/gloxi/backup_intro.py
msgid "Choose what goes into backups"
msgstr "Вибрати, що потрапить у резервні копії"

#: src/gloxi/backup_intro.py
msgid "Desktop"
msgstr "Стільниця"

#: src/gloxi/backup_intro.py
msgid "Documents"
msgstr "Документи"

#: src/gloxi/backup_intro.py
msgid "Downloads"
msgstr "Завантаження"

#: src/gloxi/backup_intro.py
msgid "Dropbox, OneDrive, Google Drive"
msgstr "Dropbox, OneDrive, Google Drive"

#: src/gloxi/backup_intro.py
msgid "Every day, recommended"
msgstr "Щодня, рекомендовано"

#: src/gloxi/backup_intro.py
msgid "Every hour"
msgstr "Щогодини"

#: src/gloxi/backup_intro.py
msgid "Every week"
msgstr "Щотижня"

#: src/gloxi/backup_intro.py
msgid "Everything in the home folder"
msgstr "Усе в домашній теці"

#: src/gloxi/backup_intro.py
#, python-brace-format
msgid "Everything in the home folder, without caches and Downloads ({size})"
msgstr "Усе в домашній теці, без кешів і Завантажень ({size})"

#: src/gloxi/backup_intro.py
msgid "Gloxi checks that the backup fits"
msgstr "Gloxi перевіряє, чи вміститься резервна копія"

#: src/gloxi/backup_intro.py
msgid "Gloxi checks whether backups are set up"
msgstr "Gloxi перевіряє, чи налаштовано резервні копії"

#: src/gloxi/backup_intro.py
msgid "Gloxi measures how much space your folders take"
msgstr "Gloxi вимірює, скільки місця займають ваші теки"

#: src/gloxi/backup_intro.py
msgid ""
"Have your recovery sheet ready and run this in a terminal:\n"
"  vilna-backup recover <where the backups are>\n"
"Then: vilna-backup restore --in-place"
msgstr ""
"Приготуйте аркуш відновлення і виконайте в терміналі:\n"
"  vilna-backup recover <де лежать копії>\n"
"Потім: vilna-backup restore --in-place"

#: src/gloxi/backup_intro.py src/gloxi/vpn_intro.py
msgid "Herkos sent an answer Gloxi does not understand"
msgstr "Herkos надіслав відповідь, якої Gloxi не розуміє"

#: src/gloxi/backup_intro.py src/gloxi/vpn_intro.py
msgid "Herkos, the permission service, is not available"
msgstr "Herkos, служба дозволів, недоступна"

#: src/gloxi/backup_intro.py
msgid "How much space are you ready to give to backups?"
msgstr "Скільки місця ви готові віддати під резервні копії?"

#: src/gloxi/backup_intro.py
msgid "How often?"
msgstr "Як часто?"

#: src/gloxi/backup_intro.py
#, python-brace-format
msgid "I could not continue: {why}. We can go on later: type /backup."
msgstr "Не вдалося продовжити: {why}. Можемо повернутися пізніше: напишіть /backup."

#: src/gloxi/backup_intro.py
msgid "I had Vilna before: restore from a backup"
msgstr "У мене вже була Vilna: відновити з копії"

#: src/gloxi/backup_intro.py
#, python-brace-format
msgid "I will back up {what} (about {size}) {how} {where}."
msgstr "Я зберігатиму {what} (близько {size}) {how} {where}."

#: src/gloxi/backup_intro.py
msgid "Keep Gloxi conversations in backups"
msgstr "Зберігати розмови з Gloxi в резервних копіях"

#: src/gloxi/backup_intro.py
msgid "Keep your conversations with Gloxi in backups too?"
msgstr "Зберігати в резервних копіях і ваші розмови з Gloxi?"

#: src/gloxi/backup_intro.py src/gloxi/vpn_intro.py
msgid "Later"
msgstr "Пізніше"

#: src/gloxi/backup_intro.py
msgid "Leave large folders out of backups"
msgstr "Не включати великі теки в резервні копії"

#: src/gloxi/backup_intro.py
msgid "Leave out Gloxi history"
msgstr "Без історії Gloxi"

#: src/gloxi/backup_intro.py
msgid "Music"
msgstr "Музика"

#: src/gloxi/backup_intro.py
msgid "My own storage (S3, SFTP)"
msgstr "Власне сховище (S3, SFTP)"

#: src/gloxi/backup_intro.py src/gloxi/feedback.py src/gloxi/vpn_intro.py
msgid "No"
msgstr "Ні"

#: src/gloxi/backup_intro.py
msgid "No limit"
msgstr "Без обмеження"

#: src/gloxi/backup_intro.py
msgid "No, I will give more space"
msgstr "Ні, дам більше місця"

#: src/gloxi/backup_intro.py
#, python-brace-format
msgid "Only settings ({size})"
msgstr "Лише налаштування ({size})"

#: src/gloxi/backup_intro.py
msgid "Passwords and accounts are switched on by you only:"
msgstr "Паролі й облікові записи вмикаєте тільки ви:"

#: src/gloxi/backup_intro.py
msgid "Pictures"
msgstr "Зображення"

#: src/gloxi/backup_intro.py
msgid "Set how much space backups may take"
msgstr "Задати, скільки місця можуть займати копії"

#: src/gloxi/backup_intro.py
msgid "Set how often backups are made"
msgstr "Задати, як часто робити копії"

#: src/gloxi/backup_intro.py
#, python-brace-format
msgid "Settings and documents, recommended ({size})"
msgstr "Налаштування і документи, рекомендовано ({size})"

#: src/gloxi/backup_intro.py
msgid "Settings are always kept. Which folders to add? Type their numbers, for example: 1 3"
msgstr "Налаштування зберігаються завжди. Які теки додати? Введіть їхні номери, наприклад: 1 3"

#: src/gloxi/backup_intro.py
msgid "Settings, passwords, Gloxi and Herkos"
msgstr "Налаштування, паролі, Gloxi і Herkos"

#: src/gloxi/backup_intro.py
msgid "Shall I keep backups of your data, so you do not lose it along with the computer?"
msgstr "Робити резервні копії ваших даних, щоб ви не втратили їх разом із комп'ютером?"

#: src/gloxi/backup_intro.py
msgid "The Vilna cloud is not open yet in this preview. Choose another place."
msgstr "Vilna хмара ще не відкрита в цій попередній версії. Виберіть інше місце."

#: src/gloxi/backup_intro.py
msgid "The last step is yours, because it is about keys: run this in a terminal. It shows the recovery key once; write it on paper and keep it away from the computer. Without it, backups cannot be restored if this computer is lost. The first backup starts right after."
msgstr "Останній крок за вами, бо він стосується ключів: виконайте це в терміналі. Ключ відновлення буде показано один раз; запишіть його на папері й зберігайте окремо від комп'ютера. Без нього копії не відновити, якщо цей комп'ютер буде втрачено. Перша копія почнеться одразу після цього."

#: src/gloxi/backup_intro.py
msgid "These are US companies: they see your account, the size and time of backups (not the contents), and a broken device could delete the backups. They are not in this preview yet. Choose another place."
msgstr "Це компанії зі США: вони бачать ваш обліковий запис, розмір і час копій (не вміст), а зламаний пристрій може видалити копії. У цій попередній версії їх ще немає. Виберіть інше місце."

#: src/gloxi/backup_intro.py
msgid "Type an amount in GB, e.g. 120"
msgstr "Введіть обсяг у ГБ, наприклад 120"

#: src/gloxi/backup_intro.py
msgid "Type the numbers of the folders, for example: 1 3"
msgstr "Введіть номери тек, наприклад: 1 3"

#: src/gloxi/backup_intro.py
msgid "Videos"
msgstr "Відео"

#: src/gloxi/backup_intro.py
msgid "Vilna cloud (EU)"
msgstr "Vilna хмара (ЄС)"

#: src/gloxi/backup_intro.py
msgid "We are not talking about backups now."
msgstr "Зараз ми не говоримо про резервні копії."

#: src/gloxi/backup_intro.py
msgid "What shall we keep? This is how much space it takes now:"
msgstr "Що зберігати? Ось скільки місця це займає зараз:"

#: src/gloxi/backup_intro.py
msgid "Where shall we keep them? Everything is encrypted on this computer first."
msgstr "Де їх зберігати? Усе спершу шифрується на цьому комп'ютері."

#: src/gloxi/backup_intro.py src/gloxi/feedback.py
msgid "Yes"
msgstr "Так"

#: src/gloxi/backup_intro.py
msgid "Yes, leave them out"
msgstr "Так, не включати"

#: src/gloxi/backup_intro.py
msgid "every day"
msgstr "щодня"

#: src/gloxi/backup_intro.py
msgid "every hour"
msgstr "щогодини"

#: src/gloxi/backup_intro.py
msgid "every week"
msgstr "щотижня"

#: src/gloxi/backup_intro.py
msgid "everything in the home folder"
msgstr "усе в домашній теці"

#: src/gloxi/backup_intro.py
msgid "in your own storage"
msgstr "у вашому власному сховищі"

#: src/gloxi/backup_intro.py
msgid "no"
msgstr "ні"

#: src/gloxi/backup_intro.py
msgid "on the external disk"
msgstr "на зовнішньому диску"

#: src/gloxi/backup_intro.py
msgid "settings"
msgstr "налаштування"

#: src/gloxi/backup_intro.py
msgid "settings and documents"
msgstr "налаштування і документи"

#: src/gloxi/backup_intro.py
msgid "settings and the folders you chose"
msgstr "налаштування і вибрані вами теки"

#: src/gloxi/backup_intro.py src/gloxi/cli.py src/gloxi/voice/cli.py
msgid "yes"
msgstr "так"

#: src/gloxi/backup_intro.py
#, python-brace-format
msgid ""
"{size} does not fit into {limit}. Leave out these large folders (about {after} remains)?\n"
"{folders}"
msgstr ""
"{size} не вміщується в {limit}. Не включати ці великі теки (залишиться близько {after})?\n"
"{folders}"

#: src/gloxi/backup_intro.py
#, python-brace-format
msgid "{size} does not fit. Choose a larger amount."
msgstr "{size} не вміщується. Виберіть більший обсяг."

#: src/gloxi/check.py
msgid "Could not read the memory size; the local model may still work."
msgstr "Не вдалося прочитати обсяг пам'яті; локальна модель усе одно може працювати."

#: src/gloxi/check.py
#, python-brace-format
msgid "Free disk space: {free}. The model needs {size}."
msgstr "Вільно на диску: {free}. Моделі потрібно {size}."

#: src/gloxi/check.py
#, python-brace-format
msgid "Gloxi starts {large} because its file is in the models folder, but the speed test has not shown that it is fast enough here. To go back to {small}, delete {file} from {folder}."
msgstr "Gloxi запускає {large}, бо її файл лежить у теці моделей, але тест швидкості не показав, що вона тут достатньо швидка. Щоб повернутися до {small}, видаліть {file} з {folder}."

#: src/gloxi/check.py
#, python-brace-format
msgid "Memory: {ram}. The local model needs at least 8 GB; Gloxi can still answer through the cloud with your own key."
msgstr "Пам'ять: {ram}. Локальній моделі потрібно щонайменше 8 ГБ; Gloxi все одно може відповідати через хмару з вашим ключем."

#: src/gloxi/check.py
msgid "The processor has no AVX2 (it is older than Intel Core 8th generation or Ryzen 2000), so the local model will be slow."
msgstr "Процесор не має AVX2 (він старший за Intel Core 8-го покоління чи Ryzen 2000), тому локальна модель працюватиме повільно."

#: src/gloxi/check.py
#, python-brace-format
msgid "This computer can run {name}."
msgstr "Цей комп'ютер потягне {name}."

#: src/gloxi/check.py
#, python-brace-format
msgid "This computer can run {name}. Gloxi will measure once whether the larger model would be fast enough."
msgstr "Цей комп'ютер потягне {name}. Gloxi один раз виміряє, чи буде достатньо швидкою більша модель."

#: src/gloxi/check.py
msgid "This computer is below the minimum for the local model."
msgstr "Цей комп'ютер слабший за мінімум для локальної моделі."

#: src/gloxi/check.py
#, python-brace-format
msgid "This computer is fast enough for the larger model, {name}."
msgstr "Цей комп'ютер достатньо швидкий для більшої моделі, {name}."

#: src/gloxi/check.py
msgid "To paste into the feedback form:"
msgstr "Щоб вставити у форму відгуку:"

#: src/gloxi/cli.py
msgid "(interrupted)"
msgstr "(перервано)"

#: src/gloxi/cli.py src/gloxi/gui/controller.py
msgid "Backups need Herkos, and it is not running."
msgstr "Для резервних копій потрібен Herkos, а він не запущений."

#: src/gloxi/cli.py src/gloxi/gui/controller.py
msgid "Checking how fast this computer runs the model (about a minute)…"
msgstr "Перевіряю, як швидко цей комп'ютер працює з моделлю (близько хвилини)…"

#: src/gloxi/cli.py
msgid "Cloud: off. Everything stays on this computer."
msgstr "Хмара: вимкнена. Усе залишається на цьому комп'ютері."

#: src/gloxi/cli.py
#, python-brace-format
msgid "Cloud: on ({mode} mode)."
msgstr "Хмара: увімкнена (режим {mode})."

#: src/gloxi/cli.py
msgid "Commands: /local <text> or /cloud <text> picks the model for one message, /reset clears the conversation, /backup sets up backups, /vpn sets up a VPN, /feedback reports a problem or suggests something, /exit quits."
msgstr "Команди: /local <текст> чи /cloud <текст> обирає модель для одного повідомлення, /reset очищає розмову, /backup налаштовує резервні копії, /vpn налаштовує VPN, /feedback — повідомити про проблему чи запропонувати щось, /exit — вихід."

#: src/gloxi/cli.py
msgid "Conversation cleared."
msgstr "Розмову очищено."

#: src/gloxi/cli.py src/gloxi/voice/cli.py
msgid "Download it now? [y/N] "
msgstr "Завантажити зараз? [т/Н] "

#: src/gloxi/cli.py src/gloxi/gui/controller.py
#, python-brace-format
msgid "Downloading the model: {percent}%"
msgstr "Завантаження моделі: {percent}%"

#: src/gloxi/cli.py src/gloxi/gui/controller.py
msgid "Gloxi keeps the current model and will not ask again."
msgstr "Gloxi лишає поточну модель і більше не питатиме."

#: src/gloxi/cli.py
#, python-brace-format
msgid "Gloxi needs a language model on this computer to answer. It is {name}, {size}, licence {licence}, from {source}. It will be kept in {folder}. Only the file is downloaded: nothing about you is sent."
msgstr "Щоб відповідати, Gloxi потрібна мовна модель на цьому комп'ютері. Це {name}, {size}, ліцензія {licence}, джерело: {source}. Її буде збережено в {folder}. Завантажується лише файл: нічого про вас не надсилається."

#: src/gloxi/cli.py
msgid ""
"Is llama-server running? For example:\n"
"  llama-server -m model.gguf --port 8080\n"
"or point Gloxi elsewhere with GLOXI_LOCAL_URL."
msgstr ""
"Чи запущено llama-server? Наприклад:\n"
"  llama-server -m model.gguf --port 8080\n"
"або вкажіть Gloxi іншу адресу через GLOXI_LOCAL_URL."

#: src/gloxi/cli.py src/gloxi/gui/controller.py
msgid "Not downloaded. Gloxi will ask again next time."
msgstr "Не завантажено. Gloxi спитає ще раз наступного разу."

#: src/gloxi/cli.py
msgid "Note: masking is off (mask_cloud = false), so messages sent to the cloud are NOT masked."
msgstr "Увага: маскування вимкнено (mask_cloud = false), тож повідомлення до хмари НЕ маскуються."

#: src/gloxi/cli.py
#, python-brace-format
msgid "Open the app: {app}"
msgstr "Відкрийте застосунок: {app}"

#: src/gloxi/cli.py src/gloxi/gui/controller.py
#, python-brace-format
msgid "Starting {name} on this computer…"
msgstr "Запуск {name} на цьому комп'ютері…"

#: src/gloxi/cli.py src/gloxi/gui/controller.py
msgid "The VPN needs Vilna and Herkos, and Herkos is not running."
msgstr "Для VPN потрібні Vilna і Herkos, а Herkos не запущений."

#: src/gloxi/cli.py src/gloxi/gui/controller.py
#, python-brace-format
msgid "The model could not be started: {why}"
msgstr "Не вдалося запустити модель: {why}"

#: src/gloxi/cli.py
msgid "The model is ready."
msgstr "Модель готова."

#: src/gloxi/cli.py src/gloxi/gui/controller.py
msgid "The model is ready. Gloxi will use it from the next start."
msgstr "Модель готова. Gloxi використовуватиме її з наступного запуску."

#: src/gloxi/cli.py src/gloxi/gui/controller.py
#, python-brace-format
msgid "The model was not downloaded: {why}"
msgstr "Модель не завантажено: {why}"

#: src/gloxi/cli.py
msgid "There is no language model yet. Run gloxi in a terminal once to download it."
msgstr "Мовної моделі ще немає. Запустіть gloxi один раз у терміналі, щоб завантажити її."

#: src/gloxi/cli.py
#, python-brace-format
msgid "This computer is fast enough for a better model: {name}, {size}, licence {licence}, from {source}. It answers better, in Ukrainian too; Gloxi expects about {speed} tokens per second here. It will be kept in {folder}, next to the current model, and Gloxi will use it from the next start. Only the file is downloaded: nothing about you is sent."
msgstr "Цей комп'ютер достатньо швидкий для кращої моделі: {name}, {size}, ліцензія {licence}, від {source}. Вона краще відповідає, зокрема українською; Gloxi очікує тут близько {speed} токенів за секунду. Її буде збережено в {folder}, поруч із поточною моделлю, і Gloxi використовуватиме її з наступного запуску. Завантажується лише файл: нічого про вас не надсилається."

#: src/gloxi/cli.py
msgid "Without a language model Gloxi cannot answer. Run gloxi again when you want to download it."
msgstr "Без мовної моделі Gloxi не може відповідати. Запустіть gloxi ще раз, коли захочете її завантажити."

#: src/gloxi/cli.py
#, python-brace-format
msgid "[cloud: {host}, masked]"
msgstr "[хмара: {host}, з маскуванням]"

#: src/gloxi/cli.py
#, python-brace-format
msgid "[cloud: {host}, not masked]"
msgstr "[хмара: {host}, без маскування]"

#: src/gloxi/cli.py
msgid "[local]"
msgstr "[локально]"

#: src/gloxi/engine.py
msgid "."
msgstr ","

#: src/gloxi/engine.py
msgid "Mistral AI on Hugging Face"
msgstr "Mistral AI на Hugging Face"

#: src/gloxi/engine.py
msgid "Qwen (Alibaba Cloud) on Hugging Face"
msgstr "Qwen (Alibaba Cloud) на Hugging Face"

#: src/gloxi/engine.py
msgid "the model"
msgstr "моделі"

#: src/gloxi/engine.py
#, python-brace-format
msgid "{value} GB"
msgstr "{value} ГБ"

#: src/gloxi/engine.py
#, python-brace-format
msgid "{value} MB"
msgstr "{value} МБ"

#: src/gloxi/feedback.py
msgid "A suggestion"
msgstr "Пропозиція"

#: src/gloxi/feedback.py
msgid "About this computer:"
msgstr "Про цей комп'ютер:"

#: src/gloxi/feedback.py
msgid "All right, nothing was sent."
msgstr "Добре, нічого не надіслано."

#: src/gloxi/feedback.py src/gloxi/gui/window.py
msgid "Cancel"
msgstr "Скасувати"

#: src/gloxi/feedback.py
msgid "Crash report:"
msgstr "Звіт про збій:"

#: src/gloxi/feedback.py
msgid "Expected:"
msgstr "Очікувалося:"

#: src/gloxi/feedback.py
msgid "Gloxi stopped with an error recently. Add that crash report?"
msgstr "Нещодавно Gloxi зупинився з помилкою. Додати звіт про цей збій?"

#: src/gloxi/feedback.py
#, python-brace-format
msgid "Hidden before showing it here: {what}."
msgstr "Перш ніж показати, приховано: {what}."

#: src/gloxi/feedback.py
msgid "May I add what this computer is (system, processor, memory, graphics, models), as gloxi check shows it? Nothing personal."
msgstr "Додати, що це за комп'ютер (система, процесор, пам'ять, відеокарта, моделі), як показує gloxi check? Нічого особистого."

#: src/gloxi/feedback.py
msgid "Never mind"
msgstr "Нічого, скасувати"

