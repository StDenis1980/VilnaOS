#: src/gloxi/backup_intro.py
msgid "All right. I will ask once more in a week. You can also type /backup any time."
msgstr "Va bene. Te lo chiederò di nuovo tra una settimana. Puoi anche scrivere /backup in qualsiasi momento."

#: src/gloxi/backup_intro.py
msgid "An external disk"
msgstr "Un disco esterno"

#: src/gloxi/backup_intro.py
msgid "And Wi-Fi passwords, online accounts, SSH and GPG keys?"
msgstr "E le password del Wi-Fi, gli account online, le chiavi SSH e GPG?"

#: src/gloxi/backup_intro.py
#, python-brace-format
msgid "Choose a number from 1 to {n}."
msgstr "Scegli un numero da 1 a {n}."

#: src/gloxi/backup_intro.py
msgid "Choose a number from the list, or type an amount in GB, e.g. 120"
msgstr "Scegli un numero dall’elenco o scrivi una quantità in GB, ad es. 120"

#: src/gloxi/backup_intro.py
msgid "Choose myself"
msgstr "Scelgo io"

#: src/gloxi/backup_intro.py
msgid "Choose what goes into backups"
msgstr "Scegliere cosa va nei backup"

#: src/gloxi/backup_intro.py
msgid "Desktop"
msgstr "Scrivania"

#: src/gloxi/backup_intro.py
msgid "Documents"
msgstr "Documenti"

#: src/gloxi/backup_intro.py
msgid "Downloads"
msgstr "Scaricati"

#: src/gloxi/backup_intro.py
msgid "Dropbox, OneDrive, Google Drive"
msgstr "Dropbox, OneDrive, Google Drive"

#: src/gloxi/backup_intro.py
msgid "Every day, recommended"
msgstr "Ogni giorno, consigliato"

#: src/gloxi/backup_intro.py
msgid "Every hour"
msgstr "Ogni ora"

#: src/gloxi/backup_intro.py
msgid "Every week"
msgstr "Ogni settimana"

#: src/gloxi/backup_intro.py
msgid "Everything in the home folder"
msgstr "Tutto nella cartella home"

#: src/gloxi/backup_intro.py
#, python-brace-format
msgid "Everything in the home folder, without caches and Downloads ({size})"
msgstr "Tutto nella cartella home, senza cache e Scaricati ({size})"

#: src/gloxi/backup_intro.py
msgid "Gloxi checks that the backup fits"
msgstr "Gloxi controlla che il backup ci stia"

#: src/gloxi/backup_intro.py
msgid "Gloxi checks whether backups are set up"
msgstr "Gloxi controlla se i backup sono configurati"

#: src/gloxi/backup_intro.py
msgid "Gloxi measures how much space your folders take"
msgstr "Gloxi misura quanto spazio occupano le tue cartelle"

#: src/gloxi/backup_intro.py
msgid ""
"Have your recovery sheet ready and run this in a terminal:\n"
"  vilna-backup recover <where the backups are>\n"
"Then: vilna-backup restore --in-place"
msgstr ""
"Tieni pronto il foglio di recupero ed esegui questo in un terminale:\n"
"  vilna-backup recover <dove sono i backup>\n"
"Poi: vilna-backup restore --in-place"

#: src/gloxi/backup_intro.py
msgid "Herkos sent an answer Gloxi does not understand"
msgstr "Herkos ha inviato una risposta che Gloxi non capisce"

#: src/gloxi/backup_intro.py
msgid "Herkos, the permission service, is not available"
msgstr "Herkos, il servizio dei permessi, non è disponibile"

#: src/gloxi/backup_intro.py
msgid "How much space are you ready to give to backups?"
msgstr "Quanto spazio vuoi dedicare ai backup?"

#: src/gloxi/backup_intro.py
msgid "How often?"
msgstr "Ogni quanto?"

#: src/gloxi/backup_intro.py
#, python-brace-format
msgid "I could not continue: {why}. We can go on later: type /backup."
msgstr "Non sono riuscito a continuare: {why}. Possiamo riprendere più tardi: scrivi /backup."

#: src/gloxi/backup_intro.py
msgid "I had Vilna before: restore from a backup"
msgstr "Avevo già Vilna: ripristina da un backup"

#: src/gloxi/backup_intro.py
#, python-brace-format
msgid "I will back up {what} (about {size}) {how} {where}."
msgstr "Salverò {what} (circa {size}) {how} {where}."

#: src/gloxi/backup_intro.py
msgid "Keep Gloxi conversations in backups"
msgstr "Includere le conversazioni con Gloxi nei backup"

#: src/gloxi/backup_intro.py
msgid "Keep your conversations with Gloxi in backups too?"
msgstr "Includere nei backup anche le tue conversazioni con Gloxi?"

#: src/gloxi/backup_intro.py
msgid "Later"
msgstr "Più tardi"

#: src/gloxi/backup_intro.py
msgid "Leave large folders out of backups"
msgstr "Escludere le cartelle grandi dai backup"

#: src/gloxi/backup_intro.py
msgid "Leave out Gloxi history"
msgstr "Escludere la cronologia di Gloxi"

#: src/gloxi/backup_intro.py
msgid "Music"
msgstr "Musica"

#: src/gloxi/backup_intro.py
msgid "My own storage (S3, SFTP)"
msgstr "Il mio spazio di archiviazione (S3, SFTP)"

#: src/gloxi/backup_intro.py src/gloxi/feedback.py
msgid "No"
msgstr "No"

#: src/gloxi/backup_intro.py
msgid "No limit"
msgstr "Nessun limite"

#: src/gloxi/backup_intro.py
msgid "No, I will give more space"
msgstr "No, darò più spazio"

#: src/gloxi/backup_intro.py
#, python-brace-format
msgid "Only settings ({size})"
msgstr "Solo le impostazioni ({size})"

#: src/gloxi/backup_intro.py
msgid "Passwords and accounts are switched on by you only:"
msgstr "Password e account li attivi solo tu:"

#: src/gloxi/backup_intro.py
msgid "Pictures"
msgstr "Immagini"

#: src/gloxi/backup_intro.py
msgid "Set how much space backups may take"
msgstr "Impostare quanto spazio possono occupare i backup"

#: src/gloxi/backup_intro.py
msgid "Set how often backups are made"
msgstr "Impostare ogni quanto si fanno i backup"

#: src/gloxi/backup_intro.py
#, python-brace-format
msgid "Settings and documents, recommended ({size})"
msgstr "Impostazioni e documenti, consigliato ({size})"

#: src/gloxi/backup_intro.py
msgid "Settings are always kept. Which folders to add? Type their numbers, for example: 1 3"
msgstr "Le impostazioni sono sempre incluse. Quali cartelle aggiungo? Scrivi i loro numeri, per esempio: 1 3"

#: src/gloxi/backup_intro.py
msgid "Settings, passwords, Gloxi and Herkos"
msgstr "Impostazioni, password, Gloxi e Herkos"

#: src/gloxi/backup_intro.py
msgid "Shall I keep backups of your data, so you do not lose it along with the computer?"
msgstr "Faccio il backup dei tuoi dati, così non li perdi insieme al computer?"

#: src/gloxi/backup_intro.py
msgid "The Vilna cloud is not open yet in this preview. Choose another place."
msgstr "Il cloud Vilna non è ancora aperto in questa anteprima. Scegli un altro posto."

#: src/gloxi/backup_intro.py
msgid "The last step is yours, because it is about keys: run this in a terminal. It shows the recovery key once; write it on paper and keep it away from the computer. Without it, backups cannot be restored if this computer is lost. The first backup starts right after."
msgstr "L’ultimo passo tocca a te, perché riguarda le chiavi: esegui questo in un terminale. Mostra la chiave di recupero una sola volta; scrivila su carta e tienila lontano dal computer. Senza di essa i backup non si possono ripristinare se perdi questo computer. Il primo backup parte subito dopo."

#: src/gloxi/backup_intro.py
msgid "These are US companies: they see your account, the size and time of backups (not the contents), and a broken device could delete the backups. They are not in this preview yet. Choose another place."
msgstr "Sono aziende statunitensi: vedono il tuo account, la dimensione e l’ora dei backup (non il contenuto), e un dispositivo compromesso potrebbe cancellare i backup. Non sono ancora in questa anteprima. Scegli un altro posto."

#: src/gloxi/backup_intro.py
msgid "Type an amount in GB, e.g. 120"
msgstr "Scrivi una quantità in GB, ad es. 120"

#: src/gloxi/backup_intro.py
msgid "Type the numbers of the folders, for example: 1 3"
msgstr "Scrivi i numeri delle cartelle, per esempio: 1 3"

#: src/gloxi/backup_intro.py
msgid "Videos"
msgstr "Video"

#: src/gloxi/backup_intro.py
msgid "Vilna cloud (EU)"
msgstr "Cloud Vilna (UE)"

#: src/gloxi/backup_intro.py
msgid "We are not talking about backups now."
msgstr "Non stiamo parlando di backup adesso."

#: src/gloxi/backup_intro.py
msgid "What shall we keep? This is how much space it takes now:"
msgstr "Cosa teniamo? Ecco quanto spazio occupa ora:"

#: src/gloxi/backup_intro.py
msgid "Where shall we keep them? Everything is encrypted on this computer first."
msgstr "Dove li teniamo? Tutto viene prima cifrato su questo computer."

#: src/gloxi/backup_intro.py src/gloxi/feedback.py
msgid "Yes"
msgstr "Sì"

#: src/gloxi/backup_intro.py
msgid "Yes, leave them out"
msgstr "Sì, escludile"

#: src/gloxi/backup_intro.py
msgid "every day"
msgstr "ogni giorno"

#: src/gloxi/backup_intro.py
msgid "every hour"
msgstr "ogni ora"

#: src/gloxi/backup_intro.py
msgid "every week"
msgstr "ogni settimana"

#: src/gloxi/backup_intro.py
msgid "everything in the home folder"
msgstr "tutto nella cartella home"

#: src/gloxi/backup_intro.py
msgid "in your own storage"
msgstr "nel tuo spazio di archiviazione"

#: src/gloxi/backup_intro.py
msgid "no"
msgstr "no"

#: src/gloxi/backup_intro.py
msgid "on the external disk"
msgstr "sul disco esterno"

#: src/gloxi/backup_intro.py
msgid "settings"
msgstr "le impostazioni"

#: src/gloxi/backup_intro.py
msgid "settings and documents"
msgstr "le impostazioni e i documenti"

#: src/gloxi/backup_intro.py
msgid "settings and the folders you chose"
msgstr "le impostazioni e le cartelle scelte da te"

#: src/gloxi/backup_intro.py src/gloxi/cli.py
msgid "yes"
msgstr "sì"

#: src/gloxi/backup_intro.py
#, python-brace-format
msgid ""
"{size} does not fit into {limit}. Leave out these large folders (about {after} remains)?\n"
"{folders}"
msgstr ""
"{size} non sta in {limit}. Escludo queste cartelle grandi (restano circa {after})?\n"
"{folders}"

#: src/gloxi/backup_intro.py
#, python-brace-format
msgid "{size} does not fit. Choose a larger amount."
msgstr "{size} non ci sta. Scegli una quantità maggiore."

#: src/gloxi/check.py
msgid "Could not read the memory size; the local model may still work."
msgstr "Impossibile leggere la dimensione della memoria; il modello locale potrebbe funzionare comunque."

#: src/gloxi/check.py
#, python-brace-format
msgid "Free disk space: {free}. The model needs {size}."
msgstr "Spazio libero su disco: {free}. Il modello richiede {size}."

#: src/gloxi/check.py
#, python-brace-format
msgid "Gloxi starts {large} because its file is in the models folder, but the speed test has not shown that it is fast enough here. To go back to {small}, delete {file} from {folder}."
msgstr "Gloxi avvia {large} perché il suo file è nella cartella dei modelli, ma il test di velocità non ha mostrato che qui sia abbastanza veloce. Per tornare a {small}, elimina {file} da {folder}."

#: src/gloxi/check.py
#, python-brace-format
msgid "Memory: {ram}. The local model needs at least 8 GB; Gloxi can still answer through the cloud with your own key."
msgstr "Memoria: {ram}. Il modello locale richiede almeno 8 GB; Gloxi può comunque rispondere tramite il cloud con la tua chiave."

#: src/gloxi/check.py
msgid "The processor has no AVX2 (it is older than Intel Core 8th generation or Ryzen 2000), so the local model will be slow."
msgstr "Il processore non ha AVX2 (è più vecchio di un Intel Core di 8ª generazione o di un Ryzen 2000), quindi il modello locale sarà lento."

#: src/gloxi/check.py
#, python-brace-format
msgid "This computer can run {name}."
msgstr "Questo computer può eseguire {name}."

#: src/gloxi/check.py
#, python-brace-format
msgid "This computer can run {name}. Gloxi will measure once whether the larger model would be fast enough."
msgstr "Questo computer può eseguire {name}. Gloxi misurerà una volta se il modello più grande sarebbe abbastanza veloce."

#: src/gloxi/check.py
msgid "This computer is below the minimum for the local model."
msgstr "Questo computer è sotto il minimo per il modello locale."

#: src/gloxi/check.py
#, python-brace-format
msgid "This computer is fast enough for the larger model, {name}."
msgstr "Questo computer è abbastanza veloce per il modello più grande, {name}."

#: src/gloxi/check.py
msgid "To paste into the feedback form:"
msgstr "Da incollare nel modulo di feedback:"

#: src/gloxi/cli.py
msgid "(interrupted)"
msgstr "(interrotto)"

#: src/gloxi/cli.py src/gloxi/gui/controller.py
msgid "Backups need Herkos, and it is not running."
msgstr "I backup hanno bisogno di Herkos, che non è in esecuzione."

#: src/gloxi/cli.py src/gloxi/gui/controller.py
msgid "Checking how fast this computer runs the model (about a minute)…"
msgstr "Verifico quanto velocemente questo computer esegue il modello (circa un minuto)…"

#: src/gloxi/cli.py
msgid "Cloud: off. Everything stays on this computer."
msgstr "Cloud: disattivato. Tutto resta su questo computer."

#: src/gloxi/cli.py
#, python-brace-format
msgid "Cloud: on ({mode} mode)."
msgstr "Cloud: attivato (modalità {mode})."

#: src/gloxi/cli.py
msgid "Commands: /local <text> or /cloud <text> picks the model for one message, /reset clears the conversation, /backup sets up backups, /feedback reports a problem or suggests something, /exit quits."
msgstr "Comandi: /local <testo> o /cloud <testo> sceglie il modello per un messaggio, /reset cancella la conversazione, /backup configura i backup, /feedback segnala un problema o suggerisce qualcosa, /exit esce."

#: src/gloxi/cli.py
msgid "Conversation cleared."
msgstr "Conversazione cancellata."

#: src/gloxi/cli.py
msgid "Download it now? [y/N] "
msgstr "Scaricarlo ora? [s/N] "

#: src/gloxi/cli.py src/gloxi/gui/controller.py
#, python-brace-format
msgid "Downloading the model: {percent}%"
msgstr "Download del modello: {percent}%"

#: src/gloxi/cli.py src/gloxi/gui/controller.py
msgid "Gloxi keeps the current model and will not ask again."
msgstr "Gloxi mantiene il modello attuale e non lo chiederà più."

#: src/gloxi/cli.py
#, python-brace-format
msgid "Gloxi needs a language model on this computer to answer. It is {name}, {size}, licence {licence}, from {source}. It will be kept in {folder}. Only the file is downloaded: nothing about you is sent."
msgstr "Per rispondere Gloxi ha bisogno di un modello linguistico su questo computer. È {name}, {size}, licenza {licence}, da {source}. Verrà conservato in {folder}. Si scarica solo il file: non viene inviato nulla su di te."

#: src/gloxi/cli.py
msgid ""
"Is llama-server running? For example:\n"
"  llama-server -m model.gguf --port 8080\n"
"or point Gloxi elsewhere with GLOXI_LOCAL_URL."
msgstr ""
"llama-server è in esecuzione? Per esempio:\n"
"  llama-server -m model.gguf --port 8080\n"
"oppure indica a Gloxi un altro indirizzo con GLOXI_LOCAL_URL."

#: src/gloxi/cli.py src/gloxi/gui/controller.py
msgid "Not downloaded. Gloxi will ask again next time."
msgstr "Non scaricato. Gloxi lo chiederà di nuovo la prossima volta."

#: src/gloxi/cli.py
msgid "Note: masking is off (mask_cloud = false), so messages sent to the cloud are NOT masked."
msgstr "Nota: il mascheramento è disattivato (mask_cloud = false), quindi i messaggi inviati al cloud NON sono mascherati."

#: src/gloxi/cli.py src/gloxi/gui/controller.py
#, python-brace-format
msgid "Starting {name} on this computer…"
msgstr "Avvio di {name} su questo computer…"

#: src/gloxi/cli.py src/gloxi/gui/controller.py
#, python-brace-format
msgid "The model could not be started: {why}"
msgstr "Impossibile avviare il modello: {why}"

#: src/gloxi/cli.py
msgid "The model is ready."
msgstr "Il modello è pronto."

#: src/gloxi/cli.py src/gloxi/gui/controller.py
msgid "The model is ready. Gloxi will use it from the next start."
msgstr "Il modello è pronto. Gloxi lo userà dal prossimo avvio."

#: src/gloxi/cli.py src/gloxi/gui/controller.py
#, python-brace-format
msgid "The model was not downloaded: {why}"
msgstr "Il modello non è stato scaricato: {why}"

#: src/gloxi/cli.py
msgid "There is no language model yet. Run gloxi in a terminal once to download it."
msgstr "Non c’è ancora un modello linguistico. Esegui gloxi una volta in un terminale per scaricarlo."

#: src/gloxi/cli.py
#, python-brace-format
msgid "This computer is fast enough for a better model: {name}, {size}, licence {licence}, from {source}. It answers better, in Ukrainian too; Gloxi expects about {speed} tokens per second here. It will be kept in {folder}, next to the current model, and Gloxi will use it from the next start. Only the file is downloaded: nothing about you is sent."
msgstr "Questo computer è abbastanza veloce per un modello migliore: {name}, {size}, licenza {licence}, da {source}. Risponde meglio, anche in ucraino; qui Gloxi prevede circa {speed} token al secondo. Verrà conservato in {folder}, accanto al modello attuale, e Gloxi lo userà dal prossimo avvio. Si scarica solo il file: non viene inviato nulla su di te."

#: src/gloxi/cli.py
msgid "Without a language model Gloxi cannot answer. Run gloxi again when you want to download it."
msgstr "Senza un modello linguistico Gloxi non può rispondere. Esegui di nuovo gloxi quando vuoi scaricarlo."

#: src/gloxi/cli.py
#, python-brace-format
msgid "[cloud: {host}, masked]"
msgstr "[cloud: {host}, mascherato]"

#: src/gloxi/cli.py
#, python-brace-format
msgid "[cloud: {host}, not masked]"
msgstr "[cloud: {host}, non mascherato]"

#: src/gloxi/cli.py
msgid "[local]"
msgstr "[locale]"

#: src/gloxi/engine.py
msgid "."
msgstr ","

#: src/gloxi/engine.py
msgid "Mistral AI on Hugging Face"
msgstr "Mistral AI su Hugging Face"

#: src/gloxi/engine.py
msgid "Qwen (Alibaba Cloud) on Hugging Face"
msgstr "Qwen (Alibaba Cloud) su Hugging Face"

#: src/gloxi/engine.py
msgid "the model"
msgstr "il modello"

#: src/gloxi/engine.py
#, python-brace-format
msgid "{value} GB"
msgstr "{value} GB"

#: src/gloxi/engine.py
#, python-brace-format
msgid "{value} MB"
msgstr "{value} MB"

#: src/gloxi/feedback.py
msgid "A suggestion"
msgstr "Un suggerimento"

#: src/gloxi/feedback.py
msgid "About this computer:"
msgstr "Su questo computer:"

#: src/gloxi/feedback.py
msgid "All right, nothing was sent."
msgstr "Va bene, non è stato inviato nulla."

#: src/gloxi/feedback.py src/gloxi/gui/window.py
msgid "Cancel"
msgstr "Annulla"

#: src/gloxi/feedback.py
msgid "Crash report:"
msgstr "Rapporto di arresto anomalo:"

#: src/gloxi/feedback.py
msgid "Expected:"
msgstr "Previsto:"

#: src/gloxi/feedback.py
msgid "Gloxi stopped with an error recently. Add that crash report?"
msgstr "Gloxi si è fermato di recente con un errore. Aggiungo quel rapporto?"

#: src/gloxi/feedback.py
#, python-brace-format
msgid "Hidden before showing it here: {what}."
msgstr "Nascosto prima di mostrarlo qui: {what}."

#: src/gloxi/feedback.py
msgid "May I add what this computer is (system, processor, memory, graphics, models), as gloxi check shows it? Nothing personal."
msgstr "Posso aggiungere che computer è questo (sistema, processore, memoria, grafica, modelli), come lo mostra gloxi check? Niente di personale."

#: src/gloxi/feedback.py
msgid "Never mind"
msgstr "Lascia perdere"

#: src/gloxi/feedback.py
msgid "Open the form"
msgstr "Apri il modulo"

#: src/gloxi/feedback.py
#, python-brace-format
msgid "Opening the form in your browser. Thank you! If it does not open: {url}"
msgstr "Apro il modulo nel browser. Grazie! Se non si apre: {url}"

#: src/gloxi/feedback.py
msgid "Please answer 1 or 2."
msgstr "Rispondi 1 o 2."

#: src/gloxi/feedback.py
msgid "Please answer 1, 2 or 3."
msgstr "Rispondi 1, 2 o 3."

#: src/gloxi/feedback.py
msgid "Please write a few words, or /cancel to stop."
msgstr "Scrivi qualche parola, oppure /cancel per fermarti."

#: src/gloxi/feedback.py
msgid "Something went wrong"
msgstr "Qualcosa è andato storto"

#: src/gloxi/feedback.py
msgid "Suggestion:"
msgstr "Suggerimento:"

#: src/gloxi/feedback.py
msgid "This is public: anyone can read it on GitHub, and you need a GitHub account to send it. The form opens in your browser, where you can still change everything; it is sent only when you press Create there."
msgstr "È pubblico: chiunque può leggerlo su GitHub, e per inviarlo serve un account GitHub. Il modulo si apre nel browser, dove puoi ancora cambiare tutto; viene inviato solo quando premi Create lì."

#: src/gloxi/feedback.py
#, python-brace-format
msgid "This sounds like a security problem. Please do not post it publicly: report it privately at {url}"
msgstr "Sembra un problema di sicurezza. Non pubblicarlo: segnalalo in privato su {url}"

#: src/gloxi/feedback.py
msgid "Title:"
msgstr "Titolo:"

#: src/gloxi/feedback.py
msgid "What did you do or ask, and what happened?"
msgstr "Cosa hai fatto o chiesto, e cosa è successo?"

#: src/gloxi/feedback.py
msgid "What did you expect instead? (Enter to skip)"
msgstr "Cosa ti aspettavi invece? (Invio per saltare)"

#: src/gloxi/feedback.py
msgid "What happened:"
msgstr "Cosa è successo:"

#: src/gloxi/feedback.py
msgid "What would you like to tell us?"
msgstr "Cosa vuoi dirci?"

#: src/gloxi/feedback.py
msgid "What would you suggest? A sentence or two is enough."
msgstr "Cosa suggerisci? Bastano una o due frasi."

#: src/gloxi/feedback.py
msgid "a card number"
msgstr "un numero di carta"

#: src/gloxi/feedback.py
msgid "a date of birth"
msgstr "una data di nascita"

#: src/gloxi/feedback.py
msgid "a name"
msgstr "un nome"

#: src/gloxi/feedback.py
msgid "a passport number"
msgstr "un numero di passaporto"

#: src/gloxi/feedback.py
msgid "a password or key"
msgstr "una password o una chiave"

#: src/gloxi/feedback.py
msgid "a personal ID number"
msgstr "un numero di identificazione personale"

#: src/gloxi/feedback.py
msgid "a phone number"
msgstr "un numero di telefono"

#: src/gloxi/feedback.py
msgid "a profile link"
msgstr "un link a un profilo"

#: src/gloxi/feedback.py
msgid "a tax number"
msgstr "un codice fiscale"

#: src/gloxi/feedback.py
msgid "an IP address"
msgstr "un indirizzo IP"

#: src/gloxi/feedback.py
msgid "an account number"
msgstr "un numero di conto"

#: src/gloxi/feedback.py
msgid "an address"
msgstr "un indirizzo"

#: src/gloxi/feedback.py
msgid "an e-mail address"
msgstr "un indirizzo e-mail"

#: src/gloxi/gui/controller.py
msgid "Auto"
msgstr "Auto"

#: src/gloxi/gui/controller.py
msgid "Cannot reach the cloud model."
msgstr "Impossibile raggiungere il modello nel cloud."

#: src/gloxi/gui/controller.py
msgid "Cloud"
msgstr "Cloud"

#: src/gloxi/gui/controller.py
msgid "Cloud off: everything stays on this computer"
msgstr "Cloud disattivato: tutto resta su questo computer"

#: src/gloxi/gui/controller.py
msgid "Cloud on, masking is off: messages are NOT masked"
msgstr "Cloud attivato, mascheramento disattivato: i messaggi NON sono mascherati"

#: src/gloxi/gui/controller.py
msgid "Cloud on, private data is masked"
msgstr "Cloud attivato, i dati privati sono mascherati"

#: src/gloxi/gui/controller.py
#, python-brace-format
msgid "Cloud: {host}, masked"
msgstr "Cloud: {host}, mascherato"

#: src/gloxi/gui/controller.py
#, python-brace-format
msgid "Cloud: {host}, not masked"
msgstr "Cloud: {host}, non mascherato"

#: src/gloxi/gui/controller.py
msgid "Gloxi, backups"
msgstr "Gloxi, backup"

#: src/gloxi/gui/controller.py
msgid "Gloxi, feedback"
msgstr "Gloxi, feedback"

#: src/gloxi/gui/controller.py
msgid "Local"
msgstr "Locale"

#: src/gloxi/gui/controller.py
msgid "On this computer"
msgstr "Su questo computer"

#: src/gloxi/gui/controller.py
msgid "Short messages stay on this computer, long ones go to the cloud"
msgstr "I messaggi brevi restano su questo computer, quelli lunghi vanno nel cloud"

#: src/gloxi/gui/controller.py src/gloxi/gui/window.py
msgid "The cloud is turned off in the settings."
msgstr "Il cloud è disattivato nelle impostazioni."

#: src/gloxi/gui/controller.py
msgid "The local model is not running. Start llama-server and try again."
msgstr "Il modello locale non è in esecuzione. Avvia llama-server e riprova."

#: src/gloxi/gui/controller.py
#, python-brace-format
msgid "The model returned an error: {error}"
msgstr "Il modello ha restituito un errore: {error}"

#: src/gloxi/gui/controller.py
#, python-brace-format
msgid "{model} at {host}, NOT masked"
msgstr "{model} su {host}, NON mascherato"

#: src/gloxi/gui/controller.py
#, python-brace-format
msgid "{model} at {host}, private data masked"
msgstr "{model} su {host}, dati privati mascherati"

#: src/gloxi/gui/controller.py
#, python-brace-format
msgid "{model}, on this computer"
msgstr "{model}, su questo computer"

#: src/gloxi/gui/window.py
msgid "Actions hidden from Gloxi"
msgstr "Azioni nascoste a Gloxi"

#: src/gloxi/gui/window.py
msgid "Add folder…"
msgstr "Aggiungi cartella…"

#: src/gloxi/gui/window.py
msgid "Ask Gloxi… (/local or /cloud to pick the model)"
msgstr "Chiedi a Gloxi… (/local o /cloud per scegliere il modello)"

#: src/gloxi/gui/window.py
msgid "Choose a folder for Gloxi"
msgstr "Scegli una cartella per Gloxi"

#: src/gloxi/gui/window.py
msgid "Download"
msgstr "Scarica"

#: src/gloxi/gui/window.py
msgid "Download the language model?"
msgstr "Scaricare il modello linguistico?"

#: src/gloxi/gui/window.py
msgid "Folders Gloxi may use"
msgstr "Cartelle che Gloxi può usare"

#: src/gloxi/gui/window.py
msgid "Gloxi can use only the programs you turn on here. Herkos asks you before turning one on, and every action still goes through it."
msgstr "Gloxi può usare solo i programmi che attivi qui. Herkos ti chiede conferma prima di attivarne uno, e ogni azione passa comunque da Herkos."

#: src/gloxi/gui/window.py
msgid "Gloxi sees only the folders you choose here, and every action in them goes through Herkos, which asks you first."
msgstr "Gloxi vede solo le cartelle che scegli qui, e ogni azione al loro interno passa da Herkos, che prima ti chiede."

#: src/gloxi/gui/window.py
#, python-brace-format
msgid "Herkos could not change it: {why}"
msgstr "Herkos non è riuscito a cambiarlo: {why}"

#: src/gloxi/gui/window.py
#, python-brace-format
msgid "Herkos could not restart: {why}"
msgstr "Herkos non è riuscito a riavviarsi: {why}"

#: src/gloxi/gui/window.py
msgid "Herkos found something suspicious in how the program describes them."
msgstr "Herkos ha trovato qualcosa di sospetto nel modo in cui il programma li descrive."

#: src/gloxi/gui/window.py
msgid "It starts the next time Herkos starts."
msgstr "Parte al prossimo avvio di Herkos."

#: src/gloxi/gui/window.py
msgid "Model"
msgstr "Modello"

#: src/gloxi/gui/window.py
msgid "New conversation"
msgstr "Nuova conversazione"

#: src/gloxi/gui/window.py
msgid "No folders yet: Gloxi cannot see any of your files."
msgstr "Ancora nessuna cartella: Gloxi non vede nessuno dei tuoi file."

#: src/gloxi/gui/window.py
msgid "No programs for Gloxi are installed."
msgstr "Non ci sono programmi per Gloxi installati."

#: src/gloxi/gui/window.py
msgid "Not now"
msgstr "Non ora"

#: src/gloxi/gui/window.py
msgid "Not turned on: you said no in the Herkos window."
msgstr "Non attivato: hai detto di no nella finestra di Herkos."

#: src/gloxi/gui/window.py
msgid "Only the local model: turn the cloud on in the settings to choose another"
msgstr "Solo il modello locale: attiva il cloud nelle impostazioni per sceglierne un altro"

#: src/gloxi/gui/window.py
msgid "Programs for Gloxi"
msgstr "Programmi per Gloxi"

#: src/gloxi/gui/window.py
msgid "Report a problem or suggest something"
msgstr "Segnala un problema o suggerisci qualcosa"

#: src/gloxi/gui/window.py
msgid "Send"
msgstr "Invia"

#: src/gloxi/gui/window.py
msgid "Stop sharing this folder"
msgstr "Smetti di condividere questa cartella"

#: src/gloxi/programs.py
msgid "Off: Gloxi cannot use it"
msgstr "Disattivato: Gloxi non può usarlo"

#: src/gloxi/programs.py
msgid "On"
msgstr "Attivato"

#: src/gloxi/programs.py
msgid "On: starts when Herkos starts again"
msgstr "Attivato: parte al prossimo avvio di Herkos"

#: src/gloxi/programs.py
msgid "You turned this program on in Gloxi's settings"
msgstr "Hai attivato questo programma nelle impostazioni di Gloxi"

#: src/gloxi/router.py
msgid "Note: the cloud model changed some masked values, so they could not be put back. Check the answer before you use it."
msgstr "Nota: il modello nel cloud ha cambiato alcuni valori mascherati, quindi non è stato possibile ripristinarli. Controlla la risposta prima di usarla."

#: src/gloxi/tools.py
#, python-brace-format
msgid "{what} (denied: {message})"
msgstr "{what} (negato: {message})"

#: src/gloxi/tools.py
#, python-brace-format
msgid "{what} (done)"
msgstr "{what} (fatto)"

#: src/gloxi/tools.py
#, python-brace-format
msgid "{what} (done; warning: the content {warnings})"
msgstr "{what} (fatto; attenzione: il contenuto {warnings})"

#: src/gloxi/tools.py
#, python-brace-format
msgid "{what} (error: {message})"
msgstr "{what} (errore: {message})"
