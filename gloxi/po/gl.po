#: src/gloxi/ai_notice.py
msgid "I am Gloxi, an AI assistant: a language model writes my answers, and they can be wrong."
msgstr "Son Gloxi, un asistente de IA: as miñas respostas escríbeas un modelo de linguaxe e poden ser erróneas."

#: src/gloxi/ai_notice.py
msgid "Written by AI"
msgstr "Escrito por unha IA"

#: src/gloxi/backup_intro.py
msgid "All right. I will ask once more in a week. You can also type /backup any time."
msgstr "De acordo. Volvereiche preguntar dentro dunha semana. Tamén podes escribir /backup cando queiras."

#: src/gloxi/backup_intro.py
msgid "An external disk"
msgstr "Un disco externo"

#: src/gloxi/backup_intro.py
msgid "And Wi-Fi passwords, online accounts, SSH and GPG keys?"
msgstr "E os contrasinais da wifi, as contas en liña e as claves SSH e GPG?"

#: src/gloxi/backup_intro.py src/gloxi/vpn_intro.py
#, python-brace-format
msgid "Choose a number from 1 to {n}."
msgstr "Escolle un número do 1 ao {n}."

#: src/gloxi/backup_intro.py
msgid "Choose a number from the list, or type an amount in GB, e.g. 120"
msgstr "Escolle un número da lista ou escribe unha cantidade en GB, p. ex. 120"

#: src/gloxi/backup_intro.py
msgid "Choose myself"
msgstr "Escoller eu"

#: src/gloxi/backup_intro.py
msgid "Choose what goes into backups"
msgstr "Escoller que entra nas copias"

#: src/gloxi/backup_intro.py
msgid "Desktop"
msgstr "Escritorio"

#: src/gloxi/backup_intro.py
msgid "Documents"
msgstr "Documentos"

#: src/gloxi/backup_intro.py
msgid "Downloads"
msgstr "Descargas"

#: src/gloxi/backup_intro.py
msgid "Dropbox, OneDrive, Google Drive"
msgstr "Dropbox, OneDrive, Google Drive"

#: src/gloxi/backup_intro.py
msgid "Every day, recommended"
msgstr "Cada día, recomendado"

#: src/gloxi/backup_intro.py
msgid "Every hour"
msgstr "Cada hora"

#: src/gloxi/backup_intro.py
msgid "Every week"
msgstr "Cada semana"

#: src/gloxi/backup_intro.py
msgid "Everything in the home folder"
msgstr "Todo o do cartafol persoal"

#: src/gloxi/backup_intro.py
#, python-brace-format
msgid "Everything in the home folder, without caches and Downloads ({size})"
msgstr "Todo o do cartafol persoal, sen cachés nin Descargas ({size})"

#: src/gloxi/backup_intro.py
msgid "Gloxi checks that the backup fits"
msgstr "Gloxi comproba que a copia cabe"

#: src/gloxi/backup_intro.py
msgid "Gloxi checks whether backups are set up"
msgstr "Gloxi comproba se as copias están configuradas"

#: src/gloxi/backup_intro.py
msgid "Gloxi measures how much space your folders take"
msgstr "Gloxi mide canto espazo ocupan os teus cartafoles"

#: src/gloxi/backup_intro.py
msgid ""
"Have your recovery sheet ready and run this in a terminal:\n"
"  vilna-backup recover <where the backups are>\n"
"Then: vilna-backup restore --in-place"
msgstr ""
"Ten a man a túa folla de recuperación e executa isto nun terminal:\n"
"  vilna-backup recover <onde están as copias>\n"
"Despois: vilna-backup restore --in-place"

#: src/gloxi/backup_intro.py src/gloxi/vpn_intro.py
msgid "Herkos sent an answer Gloxi does not understand"
msgstr "Herkos enviou unha resposta que Gloxi non entende"

#: src/gloxi/backup_intro.py src/gloxi/vpn_intro.py
msgid "Herkos, the permission service, is not available"
msgstr "Herkos, o servizo de permisos, non está dispoñible"

#: src/gloxi/backup_intro.py
msgid "How much space are you ready to give to backups?"
msgstr "Canto espazo queres dedicar ás copias?"

#: src/gloxi/backup_intro.py
msgid "How often?"
msgstr "Con que frecuencia?"

#: src/gloxi/backup_intro.py
#, python-brace-format
msgid "I could not continue: {why}. We can go on later: type /backup."
msgstr "Non puiden continuar: {why}. Podemos seguir máis tarde: escribe /backup."

#: src/gloxi/backup_intro.py
msgid "I had Vilna before: restore from a backup"
msgstr "Xa tiña Vilna: restaurar desde unha copia"

#: src/gloxi/backup_intro.py
#, python-brace-format
msgid "I will back up {what} (about {size}) {how} {where}."
msgstr "Farei copia de {what} (uns {size}) {how} {where}."

#: src/gloxi/backup_intro.py
msgid "Keep Gloxi conversations in backups"
msgstr "Incluír as conversas con Gloxi nas copias"

#: src/gloxi/backup_intro.py
msgid "Keep your conversations with Gloxi in backups too?"
msgstr "Incluír tamén as túas conversas con Gloxi nas copias?"

#: src/gloxi/backup_intro.py src/gloxi/vpn_intro.py
msgid "Later"
msgstr "Máis tarde"

#: src/gloxi/backup_intro.py
msgid "Leave large folders out of backups"
msgstr "Deixar os cartafoles grandes fóra das copias"

#: src/gloxi/backup_intro.py
msgid "Leave out Gloxi history"
msgstr "Deixar fóra o historial de Gloxi"

#: src/gloxi/backup_intro.py
msgid "Music"
msgstr "Música"

#: src/gloxi/backup_intro.py
msgid "My own storage (S3, SFTP)"
msgstr "O meu propio almacenamento (S3, SFTP)"

#: src/gloxi/backup_intro.py src/gloxi/feedback.py src/gloxi/vpn_intro.py
msgid "No"
msgstr "Non"

#: src/gloxi/backup_intro.py
msgid "No limit"
msgstr "Sen límite"

#: src/gloxi/backup_intro.py
msgid "No, I will give more space"
msgstr "Non, darei máis espazo"

#: src/gloxi/backup_intro.py
#, python-brace-format
msgid "Only settings ({size})"
msgstr "Só a configuración ({size})"

#: src/gloxi/backup_intro.py
msgid "Passwords and accounts are switched on by you only:"
msgstr "Os contrasinais e as contas só os activas ti:"

#: src/gloxi/backup_intro.py
msgid "Pictures"
msgstr "Imaxes"

#: src/gloxi/backup_intro.py
msgid "Set how much space backups may take"
msgstr "Fixar canto espazo poden ocupar as copias"

#: src/gloxi/backup_intro.py
msgid "Set how often backups are made"
msgstr "Fixar cada canto se fan as copias"

#: src/gloxi/backup_intro.py
#, python-brace-format
msgid "Settings and documents, recommended ({size})"
msgstr "Configuración e documentos, recomendado ({size})"

#: src/gloxi/backup_intro.py
msgid "Settings are always kept. Which folders to add? Type their numbers, for example: 1 3"
msgstr "A configuración sempre se garda. Que cartafoles engado? Escribe os seus números, por exemplo: 1 3"

#: src/gloxi/backup_intro.py
msgid "Settings, passwords, Gloxi and Herkos"
msgstr "Configuración, contrasinais, Gloxi e Herkos"

#: src/gloxi/backup_intro.py
msgid "Shall I keep backups of your data, so you do not lose it along with the computer?"
msgstr "Fago copias dos teus datos para que non os perdas xunto co ordenador?"

#: src/gloxi/backup_intro.py
msgid "The Vilna cloud is not open yet in this preview. Choose another place."
msgstr "A nube Vilna aínda non está dispoñible nesta versión preliminar. Escolle outro lugar."

#: src/gloxi/backup_intro.py
msgid "The last step is yours, because it is about keys: run this in a terminal. It shows the recovery key once; write it on paper and keep it away from the computer. Without it, backups cannot be restored if this computer is lost. The first backup starts right after."
msgstr "O último paso é teu, porque ten que ver con claves: executa isto nun terminal. Mostra a clave de recuperación unha soa vez; anótaa nun papel e gárdaa lonxe do ordenador. Sen ela, as copias non se poden restaurar se perdes este ordenador. A primeira copia comeza xusto despois."

#: src/gloxi/backup_intro.py
msgid "These are US companies: they see your account, the size and time of backups (not the contents), and a broken device could delete the backups. They are not in this preview yet. Choose another place."
msgstr "Son empresas estadounidenses: ven a túa conta, o tamaño e a hora das copias (non o contido), e un dispositivo comprometido podería borrar as copias. Aínda non están nesta versión preliminar. Escolle outro lugar."

#: src/gloxi/backup_intro.py
msgid "Type an amount in GB, e.g. 120"
msgstr "Escribe unha cantidade en GB, p. ex. 120"

#: src/gloxi/backup_intro.py
msgid "Type the numbers of the folders, for example: 1 3"
msgstr "Escribe os números dos cartafoles, por exemplo: 1 3"

#: src/gloxi/backup_intro.py
msgid "Videos"
msgstr "Vídeos"

#: src/gloxi/backup_intro.py
msgid "Vilna cloud (EU)"
msgstr "Nube Vilna (UE)"

#: src/gloxi/backup_intro.py
msgid "We are not talking about backups now."
msgstr "Agora non estamos falando de copias."

#: src/gloxi/backup_intro.py
msgid "What shall we keep? This is how much space it takes now:"
msgstr "Que gardamos? Isto é o que ocupa agora:"

#: src/gloxi/backup_intro.py
msgid "Where shall we keep them? Everything is encrypted on this computer first."
msgstr "Onde as gardamos? Todo se cifra primeiro neste ordenador."

#: src/gloxi/backup_intro.py src/gloxi/feedback.py
msgid "Yes"
msgstr "Si"

#: src/gloxi/backup_intro.py
msgid "Yes, leave them out"
msgstr "Si, deixalos fóra"

#: src/gloxi/backup_intro.py
msgid "every day"
msgstr "cada día"

#: src/gloxi/backup_intro.py
msgid "every hour"
msgstr "cada hora"

#: src/gloxi/backup_intro.py
msgid "every week"
msgstr "cada semana"

#: src/gloxi/backup_intro.py
msgid "everything in the home folder"
msgstr "todo o do cartafol persoal"

#: src/gloxi/backup_intro.py
msgid "in your own storage"
msgstr "no teu propio almacenamento"

#: src/gloxi/backup_intro.py
msgid "no"
msgstr "non"

#: src/gloxi/backup_intro.py
msgid "on the external disk"
msgstr "no disco externo"

#: src/gloxi/backup_intro.py
msgid "settings"
msgstr "a configuración"

#: src/gloxi/backup_intro.py
msgid "settings and documents"
msgstr "a configuración e os documentos"

#: src/gloxi/backup_intro.py
msgid "settings and the folders you chose"
msgstr "a configuración e os cartafoles que escolliches"

#: src/gloxi/backup_intro.py src/gloxi/cli.py src/gloxi/voice/cli.py
msgid "yes"
msgstr "si"

#: src/gloxi/backup_intro.py
#, python-brace-format
msgid ""
"{size} does not fit into {limit}. Leave out these large folders (about {after} remains)?\n"
"{folders}"
msgstr ""
"{size} non cabe en {limit}. Deixo fóra estes cartafoles grandes (quedarían uns {after})?\n"
"{folders}"

#: src/gloxi/backup_intro.py
#, python-brace-format
msgid "{size} does not fit. Choose a larger amount."
msgstr "{size} non cabe. Escolle unha cantidade maior."

#: src/gloxi/check.py
msgid "Could not read the memory size; the local model may still work."
msgstr "Non se puido ler o tamaño da memoria; pode que o modelo local funcione igualmente."

#: src/gloxi/check.py
#, python-brace-format
msgid "Free disk space: {free}. The model needs {size}."
msgstr "Espazo libre no disco: {free}. O modelo necesita {size}."

#: src/gloxi/check.py
#, python-brace-format
msgid "Gloxi starts {large} because its file is in the models folder, but the speed test has not shown that it is fast enough here. To go back to {small}, delete {file} from {folder}."
msgstr "Gloxi inicia {large} porque o seu ficheiro está no cartafol de modelos, pero a proba de velocidade non demostrou que sexa abondo rápido aquí. Para volver a {small}, borra {file} de {folder}."

#: src/gloxi/check.py
#, python-brace-format
msgid "Memory: {ram}. The local model needs at least 8 GB; Gloxi can still answer through the cloud with your own key."
msgstr "Memoria: {ram}. O modelo local necesita polo menos 8 GB; Gloxi aínda pode responder a través da nube coa túa propia clave."

#: src/gloxi/check.py
msgid "The processor has no AVX2 (it is older than Intel Core 8th generation or Ryzen 2000), so the local model will be slow."
msgstr "O procesador non ten AVX2 (é anterior a Intel Core de 8.ª xeración ou Ryzen 2000), así que o modelo local irá lento."

#: src/gloxi/check.py
#, python-brace-format
msgid "This computer can run {name}."
msgstr "Este ordenador pode executar {name}."

#: src/gloxi/check.py
#, python-brace-format
msgid "This computer can run {name}. Gloxi will measure once whether the larger model would be fast enough."
msgstr "Este ordenador pode executar {name}. Gloxi medirá unha vez se o modelo máis grande sería abondo rápido."

#: src/gloxi/check.py
msgid "This computer is below the minimum for the local model."
msgstr "Este ordenador está por debaixo do mínimo para o modelo local."

#: src/gloxi/check.py
#, python-brace-format
msgid "This computer is fast enough for the larger model, {name}."
msgstr "Este ordenador é abondo rápido para o modelo máis grande, {name}."

#: src/gloxi/check.py
msgid "To paste into the feedback form:"
msgstr "Para pegar no formulario de opinión:"

#: src/gloxi/cli.py
msgid "(interrupted)"
msgstr "(interrompido)"

#: src/gloxi/cli.py src/gloxi/gui/controller.py
msgid "Backups need Herkos, and it is not running."
msgstr "As copias necesitan Herkos, e non está en marcha."

#: src/gloxi/cli.py src/gloxi/gui/controller.py
msgid "Checking how fast this computer runs the model (about a minute)…"
msgstr "Comprobando que rápido executa o modelo este ordenador (arredor dun minuto)…"

#: src/gloxi/cli.py
msgid "Cloud: off. Everything stays on this computer."
msgstr "Nube: desactivada. Todo queda neste ordenador."

#: src/gloxi/cli.py
#, python-brace-format
msgid "Cloud: on ({mode} mode)."
msgstr "Nube: activada (modo {mode})."

#: src/gloxi/cli.py
msgid "Commands: /local <text> or /cloud <text> picks the model for one message, /reset clears the conversation, /backup sets up backups, /vpn sets up a VPN, /feedback reports a problem or suggests something, /exit quits."
msgstr "Ordes: /local <texto> ou /cloud <texto> escolle o modelo para unha mensaxe, /reset borra a conversa, /backup configura as copias de seguranza, /vpn configura unha VPN, /feedback informa dun problema ou suxire algo, /exit sae."

#: src/gloxi/cli.py
msgid "Conversation cleared."
msgstr "Conversa borrada."

#: src/gloxi/cli.py src/gloxi/voice/cli.py
msgid "Download it now? [y/N] "
msgstr "Descargalo agora? [s/N] "

#: src/gloxi/cli.py src/gloxi/gui/controller.py
#, python-brace-format
msgid "Downloading the model: {percent}%"
msgstr "Descargando o modelo: {percent} %"

#: src/gloxi/cli.py src/gloxi/gui/controller.py
msgid "Gloxi keeps the current model and will not ask again."
msgstr "Gloxi mantén o modelo actual e non volverá preguntar."

#: src/gloxi/cli.py
#, python-brace-format
msgid "Gloxi needs a language model on this computer to answer. It is {name}, {size}, licence {licence}, from {source}. It will be kept in {folder}. Only the file is downloaded: nothing about you is sent."
msgstr "Para responder, Gloxi necesita un modelo de linguaxe neste ordenador. É {name}, {size}, licenza {licence}, de {source}. Gardarase en {folder}. Só se descarga o ficheiro: non se envía nada sobre ti."

#: src/gloxi/cli.py
msgid ""
"Is llama-server running? For example:\n"
"  llama-server -m model.gguf --port 8080\n"
"or point Gloxi elsewhere with GLOXI_LOCAL_URL."
msgstr ""
"Está en marcha llama-server? Por exemplo:\n"
"  llama-server -m model.gguf --port 8080\n"
"ou indícalle a Gloxi outro enderezo con GLOXI_LOCAL_URL."

#: src/gloxi/cli.py src/gloxi/gui/controller.py
msgid "Not downloaded. Gloxi will ask again next time."
msgstr "Non se descargou. Gloxi volverá preguntar a próxima vez."

#: src/gloxi/cli.py
msgid "Note: masking is off (mask_cloud = false), so messages sent to the cloud are NOT masked."
msgstr "Atención: o enmascaramento está desactivado (mask_cloud = false), así que as mensaxes enviadas á nube NON se enmascaran."

#: src/gloxi/cli.py
#, python-brace-format
msgid "Open the app: {app}"
msgstr "Abre a aplicación: {app}"

#: src/gloxi/cli.py src/gloxi/gui/controller.py
#, python-brace-format
msgid "Starting {name} on this computer…"
msgstr "Iniciando {name} neste ordenador…"

#: src/gloxi/cli.py src/gloxi/gui/controller.py
msgid "The VPN needs Vilna and Herkos, and Herkos is not running."
msgstr "A VPN necesita Vilna e Herkos, e Herkos non está en marcha."

#: src/gloxi/cli.py src/gloxi/gui/controller.py
#, python-brace-format
msgid "The model could not be started: {why}"
msgstr "Non se puido iniciar o modelo: {why}"

#: src/gloxi/cli.py
msgid "The model is ready."
msgstr "O modelo está listo."

#: src/gloxi/cli.py src/gloxi/gui/controller.py
msgid "The model is ready. Gloxi will use it from the next start."
msgstr "O modelo está listo. Gloxi usarao a partir do próximo inicio."

#: src/gloxi/cli.py src/gloxi/gui/controller.py
#, python-brace-format
msgid "The model was not downloaded: {why}"
msgstr "Non se descargou o modelo: {why}"

#: src/gloxi/cli.py
msgid "There is no language model yet. Run gloxi in a terminal once to download it."
msgstr "Aínda non hai ningún modelo de linguaxe. Executa gloxi unha vez nun terminal para descargalo."

#: src/gloxi/cli.py
#, python-brace-format
msgid "This computer is fast enough for a better model: {name}, {size}, licence {licence}, from {source}. It answers better, in Ukrainian too; Gloxi expects about {speed} tokens per second here. It will be kept in {folder}, next to the current model, and Gloxi will use it from the next start. Only the file is downloaded: nothing about you is sent."
msgstr "Este ordenador é abondo rápido para un modelo mellor: {name}, {size}, licenza {licence}, de {source}. Responde mellor, tamén en ucraíno; Gloxi espera uns {speed} tokens por segundo aquí. Gardarase en {folder}, xunto ao modelo actual, e Gloxi usarao a partir do próximo inicio. Só se descarga o ficheiro: non se envía nada sobre ti."

#: src/gloxi/cli.py
msgid "Without a language model Gloxi cannot answer. Run gloxi again when you want to download it."
msgstr "Sen un modelo de linguaxe Gloxi non pode responder. Volve executar gloxi cando queiras descargalo."

#: src/gloxi/cli.py
#, python-brace-format
msgid "[cloud: {host}, masked]"
msgstr "[nube: {host}, enmascarado]"

#: src/gloxi/cli.py
#, python-brace-format
msgid "[cloud: {host}, not masked]"
msgstr "[nube: {host}, sen enmascarar]"

#: src/gloxi/cli.py
msgid "[local]"
msgstr "[local]"

#: src/gloxi/engine.py
msgid "."
msgstr ","

#: src/gloxi/engine.py
msgid "Google on Hugging Face"
msgstr "Google en Hugging Face"

#: src/gloxi/engine.py
msgid "Mistral AI on Hugging Face"
msgstr "Mistral AI en Hugging Face"

#: src/gloxi/engine.py
msgid "Qwen (Alibaba Cloud) on Hugging Face"
msgstr "Qwen (Alibaba Cloud) en Hugging Face"

#: src/gloxi/engine.py
msgid "the model"
msgstr "o modelo"

#: src/gloxi/engine.py
#, python-brace-format
msgid "{value} GB"
msgstr "{value} GB"

#: src/gloxi/engine.py
#, python-brace-format
msgid "{value} MB"
msgstr "{value} MB"

#: src/gloxi/feedback.py
msgid "A suggestion"
msgstr "Unha suxestión"

#: src/gloxi/feedback.py
msgid "About this computer:"
msgstr "Sobre este ordenador:"

#: src/gloxi/feedback.py
msgid "All right, nothing was sent."
msgstr "De acordo, non se enviou nada."

#: src/gloxi/feedback.py src/gloxi/gui/window.py
msgid "Cancel"
msgstr "Cancelar"

#: src/gloxi/feedback.py
msgid "Crash report:"
msgstr "Informe de fallo:"

#: src/gloxi/feedback.py
msgid "Expected:"
msgstr "Esperado:"

#: src/gloxi/feedback.py
msgid "Gloxi stopped with an error recently. Add that crash report?"
msgstr "Gloxi detívose hai pouco cun erro. Engado ese informe de fallo?"

#: src/gloxi/feedback.py
#, python-brace-format
msgid "Hidden before showing it here: {what}."
msgstr "Ocultouse antes de mostralo aquí: {what}."

#: src/gloxi/feedback.py
msgid "May I add what this computer is (system, processor, memory, graphics, models), as gloxi check shows it? Nothing personal."
msgstr "Podo engadir que ordenador é este (sistema, procesador, memoria, gráficos, modelos), tal como o mostra gloxi check? Nada persoal."

#: src/gloxi/feedback.py
msgid "Never mind"
msgstr "Déixao"

#: src/gloxi/feedback.py
msgid "Open the form"
msgstr "Abrir o formulario"

#: src/gloxi/feedback.py
#, python-brace-format
msgid "Opening the form in your browser. Thank you! If it does not open: {url}"
msgstr "Abrindo o formulario no teu navegador. Grazas! Se non se abre: {url}"

#: src/gloxi/feedback.py
msgid "Please answer 1 or 2."
msgstr "Responde 1 ou 2."

#: src/gloxi/feedback.py
msgid "Please answer 1, 2 or 3."
msgstr "Responde 1, 2 ou 3."

#: src/gloxi/feedback.py
msgid "Please write a few words, or /cancel to stop."
msgstr "Escribe unhas palabras, ou /cancel para parar."

#: src/gloxi/feedback.py src/gloxi/gui/panel.py
msgid "Something went wrong"
msgstr "Algo saíu mal"

#: src/gloxi/feedback.py
msgid "Suggestion:"
msgstr "Suxestión:"

#: src/gloxi/feedback.py
msgid "This is public: anyone can read it on GitHub, and you need a GitHub account to send it. The form opens in your browser, where you can still change everything; it is sent only when you press Create there."
msgstr "Isto é público: calquera pode lelo en GitHub, e necesitas unha conta de GitHub para envialo. O formulario ábrese no teu navegador, onde aínda podes cambialo todo; só se envía cando premes Create alí."

#: src/gloxi/feedback.py
#, python-brace-format
msgid "This sounds like a security problem. Please do not post it publicly: report it privately at {url}"
msgstr "Parece un problema de seguranza. Non o publiques: infórmao en privado en {url}"

#: src/gloxi/feedback.py
msgid "Title:"
msgstr "Título:"

#: src/gloxi/feedback.py
msgid "What did you do or ask, and what happened?"
msgstr "Que fixeches ou pediches, e que pasou?"

#: src/gloxi/feedback.py
msgid "What did you expect instead? (Enter to skip)"
msgstr "Que esperabas no seu lugar? (Intro para omitir)"

#: src/gloxi/feedback.py
msgid "What happened:"
msgstr "Que pasou:"

#: src/gloxi/feedback.py
msgid "What would you like to tell us?"
msgstr "Que nos queres contar?"

#: src/gloxi/feedback.py
msgid "What would you suggest? A sentence or two is enough."
msgstr "Que suxires? Abonda con unha ou dúas frases."

#: src/gloxi/feedback.py
msgid "a card number"
msgstr "un número de tarxeta"

#: src/gloxi/feedback.py
msgid "a date of birth"
msgstr "unha data de nacemento"

#: src/gloxi/feedback.py
msgid "a name"
msgstr "un nome"

#: src/gloxi/feedback.py
msgid "a passport number"
msgstr "un número de pasaporte"

#: src/gloxi/feedback.py
msgid "a password or key"
msgstr "un contrasinal ou clave"

#: src/gloxi/feedback.py
msgid "a personal ID number"
msgstr "un número de identificación persoal"

#: src/gloxi/feedback.py
msgid "a phone number"
msgstr "un número de teléfono"

#: src/gloxi/feedback.py
msgid "a profile link"
msgstr "unha ligazón a un perfil"

#: src/gloxi/feedback.py
msgid "a tax number"
msgstr "un número fiscal"

#: src/gloxi/feedback.py
msgid "an IP address"
