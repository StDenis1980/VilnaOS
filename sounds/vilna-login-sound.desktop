[Desktop Entry]
Type=Application
Name=Vilna login sound
Comment=Plays the desktop-login sound of the sound theme once after login
# canberra-gtk-play ignores GNOME's switch for event sounds, so check it
# first; a sound switched off in the theme (.disabled) is skipped by
# libcanberra itself.
Exec=sh -c 'gsettings get org.gnome.desktop.sound event-sounds | grep -qx true && exec canberra-gtk-play -i desktop-login -d Vilna'
OnlyShowIn=GNOME;
NoDisplay=true
X-GNOME-Autostart-Phase=Application
