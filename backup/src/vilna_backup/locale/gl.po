msgstr "hoxe ás {time}"

msgid "yesterday at {time}"
msgstr "onte ás {time}"

msgid "Last backup {when} · {size} · {schedule}"
msgstr "Última copia {when} · {size} · {schedule}"

msgid "Choose a folder on the external disk."
msgstr "Escolle un cartafol no disco externo."

msgid "Type the server address: sftp:user@host:/folder, s3:https://… or rest:https://…"
msgstr "Escribe o enderezo do servidor: sftp:user@host:/folder, s3:https://… ou rest:https://…"

msgid "For a folder on this computer, choose the external disk."
msgstr "Para un cartafol neste ordenador, escolle o disco externo."

msgid "This server needs a login and a password."
msgstr "Este servidor necesita un usuario e un contrasinal."

msgid "≈ {size}"
msgstr "≈ {size}"

msgid "{percent} % done"
msgstr "{percent} % feito"

msgid "No backup yet · {schedule}"
msgstr "Aínda non hai copias · {schedule}"

