msgstr "Desligado"

msgid "today at {time}"
msgstr "hoje às {time}"

msgid "yesterday at {time}"
msgstr "ontem às {time}"

msgid "Last backup {when} · {size} · {schedule}"
msgstr "Última cópia {when} · {size} · {schedule}"

msgid "Choose a folder on the external disk."
msgstr "Escolha uma pasta no disco externo."

msgid "Type the server address: sftp:user@host:/folder, s3:https://… or rest:https://…"
msgstr "Escreva o endereço do servidor: sftp:user@host:/folder, s3:https://… ou rest:https://…"

msgid "For a folder on this computer, choose the external disk."
msgstr "Para uma pasta neste computador, escolha o disco externo."

msgid "This server needs a login and a password."
msgstr "Este servidor precisa de um utilizador e de uma palavra-passe."

msgid "≈ {size}"
msgstr "≈ {size}"

msgid "{percent} % done"
msgstr "{percent} % concluído"

