msgstr "Também Documentos, Ambiente de trabalho e Imagens"

msgid "Everything except caches and Downloads"
msgstr "Tudo exceto caches e Transferências"

msgid "Folders chosen with Gloxi or in the terminal"
msgstr "Pastas escolhidas com o Gloxi ou no terminal"

msgid "Every hour"
msgstr "A cada hora"

msgid "Every day"
msgstr "Todos os dias"

msgid "Every week"
msgstr "Todas as semanas"

