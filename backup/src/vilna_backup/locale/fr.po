msgid ""
msgstr ""
"Language: fr\n"
"Content-Type: text/plain; charset=UTF-8\n"

msgid "B"
msgstr "o"

msgid "kB"
msgstr "ko"

msgid "MB"
msgstr "Mo"

msgid "GB"
msgstr "Go"

msgid "TB"
msgstr "To"

msgid "Backups are on"
msgstr "Les sauvegardes sont activées"

msgid "Choose where to keep the backups."
msgstr "Choisissez où garder les sauvegardes."

msgid "recommended"
msgstr "recommandé"

msgid "{day} {month} at {time}"
msgstr "{day} {month} à {time}"

msgid "Backing up…"
msgstr "Sauvegarde en cours…"

msgid "Backups are off"
msgstr "Les sauvegardes sont désactivées"

msgid "Turn them on to keep your files safe."
msgstr "Activez-les pour protéger vos fichiers."

msgid "The last backup failed"
msgstr "La dernière sauvegarde a échoué"

msgid "Settings only"
msgstr "Paramètres seulement"

msgid "Settings and documents"
msgstr "Paramètres et documents"

msgid "The whole home folder"
msgstr "Tout le dossier personnel"

msgid "Chosen by you"
msgstr "Choisis par vous"

msgid "Settings, Gloxi, Herkos, passwords"
msgstr "Paramètres, Gloxi, Herkos, mots de passe"

msgid "Also Documents, Desktop and Pictures"
msgstr "Ainsi que Documents, Bureau et Images"

msgid "Everything except caches and Downloads"
msgstr "Tout sauf les caches et Téléchargements"

msgid "Folders chosen with Gloxi or in the terminal"
msgstr "Dossiers choisis avec Gloxi ou dans le terminal"

msgid "Every hour"
msgstr "Chaque heure"

msgid "Every day"
msgstr "Chaque jour"

msgid "Every week"
msgstr "Chaque semaine"

msgid "Off"
msgstr "Désactivé"

msgid "today at {time}"
msgstr "aujourd’hui à {time}"

msgid "yesterday at {time}"
msgstr "hier à {time}"

msgid "Last backup {when} · {size} · {schedule}"
msgstr "Dernière sauvegarde {when} · {size} · {schedule}"

msgid "Choose a folder on the external disk."
msgstr "Choisissez un dossier sur le disque externe."

msgid "Type the server address: sftp:user@host:/folder, s3:https://… or rest:https://…"
msgstr "Tapez l’adresse du serveur : sftp:user@host:/folder, s3:https://… ou rest:https://…"

msgid "For a folder on this computer, choose the external disk."
msgstr "Pour un dossier sur cet ordinateur, choisissez le disque externe."

msgid "This server needs a login and a password."
msgstr "Ce serveur demande un identifiant et un mot de passe."

msgid "≈ {size}"
msgstr "≈ {size}"

msgid "{percent} % done"
msgstr "{percent} % effectué"

msgid "No backup yet · {schedule}"
msgstr "Pas encore de sauvegarde · {schedule}"

msgid "{when}: {message}"
msgstr "{when} : {message}"

msgid "."
msgstr ","

msgid "{n} files"
msgstr "{n} fichiers"

msgid "The server address is not right: {why}"
msgstr "L’adresse du serveur n’est pas correcte : {why}"

msgid "Vilna cloud"
msgstr "Cloud Vilna"

msgid "In the EU · coming later"
msgstr "Dans l’UE · bientôt"

msgid "External disk"
msgstr "Disque externe"

msgid "No folder chosen yet"
msgstr "Aucun dossier choisi pour l’instant"

msgid "Your own server"
msgstr "Votre propre serveur"

msgid "SFTP, S3 or REST"
msgstr "SFTP, S3 ou REST"

msgid "Turn on backups"
msgstr "Activer les sauvegardes"

msgid "Recovery sheet"
msgstr "Feuille de récupération"

msgid "Backups"
msgstr "Sauvegardes"

msgid "What to keep in backups?"
msgstr "Que garder dans les sauvegardes ?"

msgid "Where"
msgstr "Où"

msgid "Choose…"
msgstr "Choisir…"

msgid "Address, e.g. sftp:me@host:/backups"
msgstr "Adresse, par ex. sftp:moi@host:/backups"

msgid "Login (S3 and REST)"
msgstr "Identifiant (S3 et REST)"

msgid "Password (S3 and REST)"
msgstr "Mot de passe (S3 et REST)"

msgid "How often"
msgstr "Fréquence"

msgid "Back up"
msgstr "Sauvegarder"

msgid "Backups are encrypted on this computer. Without the key nobody can read them, not even us."
msgstr "Les sauvegardes sont chiffrées sur cet ordinateur. Sans la clé, personne ne peut les lire, pas même nous."

msgid "Later"
msgstr "Plus tard"

msgid "Next"
msgstr "Suivant"

msgid "Folder for backups on the external disk"
msgstr "Dossier des sauvegardes sur le disque externe"

msgid "Type the key from your sheet"
msgstr "Tapez la clé de votre feuille"

msgid "Start again with another place"
msgstr "Recommencer avec un autre emplacement"

msgid "Confirm and turn on"
msgstr "Confirmer et activer"

msgid "Write this key down on paper and keep it away from the computer. If this computer is lost, only this key opens your backups. We do not know it and cannot send it again."
msgstr "Notez cette clé sur papier et gardez-la loin de l’ordinateur. Si cet ordinateur est perdu, seule cette clé ouvre vos sauvegardes. Nous ne la connaissons pas et ne pouvons pas la renvoyer."

msgid "The key is shown only now. The letters I, L, O and U are never used."
msgstr "La clé n’est affichée que maintenant. Les lettres I, L, O et U ne sont jamais utilisées."

msgid "Backups stay off until you type the recovery key back from your sheet. It was shown once, when the place was set up."
msgstr "Les sauvegardes restent désactivées tant que vous n’avez pas retapé la clé de récupération de votre feuille. Elle a été affichée une fois, lors de la configuration de l’emplacement."

msgid "No sheet? Start again with another place: a new key will be made."
msgstr "Pas de feuille ? Recommencez avec un autre emplacement : une nouvelle clé sera créée."

msgid "Backups are on. The first backup has started."
msgstr "Les sauvegardes sont activées. La première sauvegarde a commencé."

msgid "Back up now"
msgstr "Sauvegarder maintenant"

msgid "Settings"
msgstr "Paramètres"

msgid "What to keep"
msgstr "Quoi garder"

msgid "Restore puts the files into a new folder; nothing is replaced."
msgstr "La restauration place les fichiers dans un nouveau dossier ; rien n’est remplacé."

msgid "Encrypted on this computer. Without the key nobody can read them, not even us."
msgstr "Chiffrées sur cet ordinateur. Sans la clé, personne ne peut les lire, pas même nous."

msgid "Cannot read the state of backups"
msgstr "Impossible de lire l’état des sauvegardes"

msgid "Where to put the restored files"
msgstr "Où mettre les fichiers restaurés"

msgid "Cannot list the backups"
msgstr "Impossible de lister les sauvegardes"

msgid "Restore…"
msgstr "Restaurer…"

msgid "No backups yet"
msgstr "Pas encore de sauvegardes"

msgid "A backup is already running."
msgstr "Une sauvegarde est déjà en cours."

msgid "Restored from backup {stamp}"
msgstr "Restauré depuis la sauvegarde {stamp}"

msgid "Restoring {title}…"
msgstr "Restauration de {title}…"

msgid "Could not set up the backups: {why}"
msgstr "Impossible de configurer les sauvegardes : {why}"

msgid "This is not the key: {why}"
msgstr "Ce n’est pas la clé : {why}"

msgid "Could not start: {why}"
msgstr "Impossible de démarrer : {why}"

msgid "Restored {n} files into {folder}"
msgstr "{n} fichiers restaurés dans {folder}"

msgid "Could not restore: {why}"
msgstr "Impossible de restaurer : {why}"

