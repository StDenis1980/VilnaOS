msgid "Backups are on"
msgstr "Babeskopiak aktibatuta daude"

msgid "Choose where to keep the backups."
msgstr "Aukeratu non gorde babeskopiak."

msgid "recommended"
msgstr "gomendatua"

msgid "{day} {month} at {time}"
msgstr "{month}ren {day}a, {time}"

msgid "Backing up…"
msgstr "Babeskopia egiten…"

msgid "Backups are off"
msgstr "Babeskopiak desaktibatuta daude"

msgid "Turn them on to keep your files safe."
msgstr "Aktibatu zure fitxategiak seguru izateko."

msgid "The last backup failed"
msgstr "Azken babeskopiak huts egin du"

msgid "Settings only"
msgstr "Ezarpenak soilik"

msgid "Settings and documents"
msgstr "Ezarpenak eta dokumentuak"

msgid "The whole home folder"
msgstr "Karpeta pertsonal osoa"

msgid "Chosen by you"
msgstr "Zuk aukeratua"

msgid "Settings, Gloxi, Herkos, passwords"
msgstr "Ezarpenak, Gloxi, Herkos, pasahitzak"

msgid "Also Documents, Desktop and Pictures"
msgstr "Baita Dokumentuak, Mahaigaina eta Irudiak ere"

msgid "Everything except caches and Downloads"
msgstr "Guztia, cacheak eta Deskargak izan ezik"

msgid "Folders chosen with Gloxi or in the terminal"
msgstr "Gloxirekin edo terminalean aukeratutako karpetak"

msgid "Every hour"
msgstr "Orduro"

msgid "Every day"
msgstr "Egunero"

msgid "Every week"
msgstr "Astero"

