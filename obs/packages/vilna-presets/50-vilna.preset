# Vilna service defaults, see systemd.preset(5).
# The first matching line in any preset file wins, so this file (50-)
# overrides the openSUSE and Aeon presets (90- and later).

# Network services that open ports: installed but off by default
# (decision of 2026-11-02, image/docs/composition.md, section 5).
# Users turn them on in Settings; Gloxi may do it only as an R3 action.
disable avahi-daemon.service
disable avahi-daemon.socket
disable smb.service
disable nmb.service
disable sshd.service
disable sshd.socket

# Network: Aeon's presets do not enable NetworkManager, and a fresh
# image runs preset-all on first boot, so without this line there is
# no network (and the first-boot Flatpak install fails).
enable NetworkManager.service
enable NetworkManager-wait-online.service
# Encrypted DNS (ADR 0027): NetworkManager hands DNS to systemd-resolved.
enable systemd-resolved.service
# The VPN kill switch; it does nothing until the person turns it on.
enable vilna-netguard.service

# Vilna components (no effect until the units are installed).
# herkosd starts on demand through its socket. Each person's Gloxi
# (gloxi@<uid>.socket) is enabled by vilna-people-sync, which runs on
# every boot and whenever /etc/passwd changes (ADR 0025); the shared
# local model starts with the system.
enable herkosd.socket
enable vilna-people-sync.service
enable vilna-people-sync.path
enable vilna-llm.service
enable vilna-flatpak-defaults.service
# A new person's home: useradd makes it a btrfs subvolume (ADR 0026), but
# under SELinux cannot give it to the person; vilna-home-setup does.
enable vilna-home-setup.path
enable vilna-home-setup.service
