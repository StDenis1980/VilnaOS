diff --git a/src/gs-search-page.c b/src/gs-search-page.c
index 4f96ea6..a76e4d6 100644
--- a/src/gs-search-page.c
+++ b/src/gs-search-page.c
@@ -16,6 +16,7 @@
 #include "gs-shell.h"
 #include "gs-common.h"
 #include "gs-app-row.h"
+#include "vilna-layout-search.h"
 
 #define GS_SEARCH_PAGE_MAX_RESULTS	50
 
@@ -32,6 +33,8 @@ struct _GsSearchPage
 	GsShell			*shell;
 	gchar			*appid_to_show;
 	gchar			*value;
+	gchar			**layout_alternatives;
+	guint			 layout_next;
 	guint			 waiting_id;
 	guint			 max_results;
 	guint			 stamp;
@@ -101,6 +104,8 @@ typedef struct {
 	guint stamp;
 } GetSearchData;
 
+static void gs_search_page_run_query (GsSearchPage *self, const gchar *text);
+
 static void
 gs_search_page_get_search_cb (GObject *source_object,
                               GAsyncResult *res,
@@ -141,6 +146,18 @@ gs_search_page_get_search_cb (GObject *source_object,
 
 	/* no results */
 	if (gs_app_list_length (list) == 0) {
+		/* Vilna: maybe typed in another keyboard layout, such as
+		 * "ашкуащч" for "firefox"; try what the same keys type there */
+		if (self->layout_alternatives == NULL)
+			self->layout_alternatives = vilna_layout_search_alternatives (self->value);
+		if (self->layout_alternatives[self->layout_next] != NULL) {
+			const gchar *text = self->layout_alternatives[self->layout_next++];
+			g_debug ("no search results for “%s”, trying “%s” from another keyboard layout",
+				 self->value, text);
+			gs_search_page_run_query (self, text);
+			return;
+		}
+
 		g_debug ("no search results to show");
 		if (self->value && self->value[0])
 			gtk_stack_set_visible_child_name (GTK_STACK (self->stack_search), "no-results");
@@ -269,11 +286,6 @@ gs_search_page_sort_cb (GsApp *app1, GsApp *app2, gpointer user_data)
 static void
 gs_search_page_load (GsSearchPage *self)
 {
-	g_autoptr(GsPluginJob) plugin_job = NULL;
-	g_autoptr(GsAppQuery) query = NULL;
-	const gchar *keywords[2] = { NULL, };
-	g_autofree GetSearchData *search_data = NULL;
-
 	self->changed = FALSE;
 
 	/* cancel any pending searches */
@@ -292,12 +304,26 @@ gs_search_page_load (GsSearchPage *self)
 	else
 		self->waiting_id = g_timeout_add (250, gs_search_page_waiting_show_cb, self);
 
+	/* Vilna: the other keyboard layouts are tried only on no results */
+	g_clear_pointer (&self->layout_alternatives, g_strfreev);
+	self->layout_next = 0;
+	gs_search_page_run_query (self, self->value);
+}
+
+static void
+gs_search_page_run_query (GsSearchPage *self, const gchar *text)
+{
+	g_autoptr(GsPluginJob) plugin_job = NULL;
+	g_autoptr(GsAppQuery) query = NULL;
+	const gchar *keywords[2] = { NULL, };
+	g_autofree GetSearchData *search_data = NULL;
+
 	/* search for apps */
 	search_data = g_new0 (GetSearchData, 1);
 	search_data->self = self;
 	search_data->stamp = self->stamp;
 
-	keywords[0] = self->value;
+	keywords[0] = text;
 	query = gs_app_query_new ("keywords", keywords,
 				  "refine-require-flags", GS_PLUGIN_REFINE_REQUIRE_FLAGS_ICON |
 							  GS_PLUGIN_REFINE_REQUIRE_FLAGS_VERSION |
@@ -542,6 +568,7 @@ gs_search_page_finalize (GObject *object)
 
 	g_free (self->appid_to_show);
 	g_free (self->value);
+	g_strfreev (self->layout_alternatives);
 
 	G_OBJECT_CLASS (gs_search_page_parent_class)->finalize (object);
 }
