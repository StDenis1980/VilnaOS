<!-- Ptyxis, the Vilna terminal (docs/design/desktop/README.md), from the
     GNOME release tarball, at the latest GNOME release (50.1, its
     SHA-256 as in ptyxis-50.1.sha256sum on download.gnome.org). OBS fetches it
     and checks the SHA-256; CI fetches it with obs/tools/fetch_sources.py.
     A new version: change Version in ptyxis.spec, the path, the file name
     and the checksum here, and check that vilna-right-click-paste.patch
     still applies (the rpm job in .github/workflows/obs.yml builds it). -->
<services>
  <service name="download_url">
    <param name="protocol">https</param>
    <param name="host">download.gnome.org</param>
    <param name="path">/sources/ptyxis/50/ptyxis-50.1.tar.xz</param>
    <param name="filename">ptyxis-50.1.tar.xz</param>
  </service>
  <service name="verify_file">
    <param name="file">_service:download_url:ptyxis-50.1.tar.xz</param>
    <param name="verifier">sha256</param>
    <param name="checksum">73f4b76480644b2840415859a51d20cd7487b0619714f8defcd38212c3ddcffe</param>
  </service>
</services>
