# Vilna defaults for GNOME (replace Aeon's 30_Aeon, override openSUSE's
# 20_openSUSE-branding overrides). Design: light by default (decision 2026-11-09), the system
# accent colour (image/docs/composition.md, Vilna design brief).

[org.gnome.desktop.interface]
color-scheme='default'
clock-show-weekday=true
show-battery-percentage=true
font-antialiasing='rgba'
# Vilna icons (vilna-icon-theme): Vilna Classic by default (decision of
# Denys, 26.11.2026) — folders, trash and drives drawn as real objects; it
# inherits the flat Vilna theme for the Gloxi and Herkos symbolic icons,
# everything else comes from Adwaita. icon-theme='Vilna' is the flat set.
icon-theme='Vilna-Classic'

# Vilna wallpapers (vilna-backgrounds): Сонце by default, the light and
# dark pictures switch with the style. config.sh fails the image build if
# these files are missing.
[org.gnome.desktop.background]
picture-uri='file:///usr/share/backgrounds/vilna/vilna-sonce-light.jpg'
picture-uri-dark='file:///usr/share/backgrounds/vilna/vilna-sonce-dark.jpg'
primary-color='#F7F0E3'
secondary-color='#0D1830'

[org.gnome.desktop.screensaver]
picture-uri='file:///usr/share/backgrounds/vilna/vilna-sonce-dark.jpg'

# The screen goes dark (and locks) after 15 minutes without input, not
# GNOME's 5: in the VM test of Build15.6 it went dark in the first
# session while the person was still reading, and a Herkos confirmation
# waiting on screen was lost. Settings ▸ Power changes it as before.
[org.gnome.desktop.session]
idle-delay=uint32 900

# The login screen is always dark (GNOME Shell's gdm mode): the logo for
# dark backgrounds and the word Vilna in one row, 40 px high, at the
# bottom (distribution-logos-Vilna 0.4). Its background comes from the
# Vilna GNOME Shell extension.
[org.gnome.login-screen]
logo='/usr/share/pixmaps/distribution-logos/vilna-logo-login.svg'

# The Vilna GNOME Shell extension, for everyone and for the login screen
# (GDM reads the same defaults): Latin layout in password fields, Gloxi
# above other windows, the login screen background, the dock's colours.
# Dash to Dock is the dock (docs/design/desktop/README.md); it runs only
# in the person's session, not on the login screen.
[org.gnome.shell]
enabled-extensions=['vilna@stdenis1980.github.io', 'dash-to-dock@micxgx.gmail.com']
favorite-apps=['io.github.stdenis1980.Gloxi.desktop', 'org.mozilla.firefox.desktop', 'org.gnome.Nautilus.desktop', 'io.github.stdenis1980.ibercorreo.desktop', 'io.github.stdenis1980.tintatexto.desktop', 'org.gnome.Ptyxis.desktop', 'org.gnome.Software.desktop']

# The dock (Dash to Dock, gnome-shell-extension-dash-to-dock): at the
# bottom, 48 px icons, pinned Gloxi, Firefox, Files, Tinta Correo, Tinta
# Texto, the terminal and Software (favorite-apps above; one that is not
# installed is skipped). The Vilna extension's Dock page changes the
# place, the size (32-80 px), the hiding, the transparency of the glass
# (8 % by default, like the terminal) and the springy icons. It stays on an
# empty desktop and slides away when the focused app's window covers it.
# Its look comes from the Vilna extension's stylesheet, so upstream's
# theme and colour options stay off. A click shows the app, a second
# click minimises it, with several windows the previews open. The
# session starts on the desktop, not in the overview.
# Gloxi as the side panel the Shell draws (Vilna extension, gloxi-dock),
# with Dmytro's owl and the button in the top bar, instead of the GTK
# window at the right edge (decision of Denys, 26.11.2026). Super+G opens
# and closes it.
[org.gnome.shell.extensions.vilna]
gloxi-dock=true

[org.gnome.shell.extensions.dash-to-dock]
dock-position='BOTTOM'
dock-fixed=false
intellihide=true
intellihide-mode='FOCUS_APPLICATION_WINDOWS'
dash-max-icon-size=48
apply-custom-theme=false
custom-background-color=false
transparency-mode='DEFAULT'
running-indicator-style='DOTS'
running-indicator-dominant-color=false
unity-backlit-items=false
click-action='focus-minimize-or-previews'
show-trash=true
show-mounts=true
show-mounts-only-mounted=true
show-apps-at-top=false
disable-overview-on-startup=true
animation-time=0.28

[org.gnome.software]
install-bundles-system-wide=false
enable-repos-dialog=false

[org.gnome.desktop.peripherals.touchpad]
tap-to-click=true

[org.gnome.desktop.wm.preferences]
audible-bell=false

[org.gnome.desktop.sound]
event-sounds=true
theme-name='vilna-wood'

[org.gnome.settings-daemon.plugins.housekeeping]
ignore-paths=['/boot/efi']

# Super+Return (and GNOME's Ctrl+Alt+T) open the terminal through
# gnome-settings-daemon's own «Launch terminal» key, which starts the
# program of org.gnome.desktop.default-applications.terminal below. Not a
# custom keybinding: those live at paths of a relocatable schema that an
# override cannot fill (in the VM test of Build12.26 binding and command
# stayed empty).
[org.gnome.settings-daemon.plugins.media-keys]
terminal=['<Super>Return', '<Primary><Alt>t']

[org.gnome.desktop.default-applications.terminal]
exec='ptyxis'
exec-arg='--'

# The terminal is Ptyxis, not GNOME Console: Console has no setting for
# a see-through background (Denys asked for one, 2026-11-24). Everyone
# starts in one profile, «Vilna»: the Vilna palette (vilna.palette,
# copied to the person's palettes by user-tmpfiles.d/vilna-ptyxis.conf;
# without it Ptyxis falls back to its GNOME palette) and the background
# at 92 %, so the wallpaper shows through a little and the text keeps
# 4.5:1 (tools/check_terminal.py). The window follows the light/dark
# style. Ptyxis ▸ Preferences ▸ Profiles changes all of it per person.
[org.gnome.Ptyxis]
profile-uuids=['vilna']
default-profile-uuid='vilna'
interface-style='system'

[org.gnome.Ptyxis.Profile]
label='Vilna'
palette='vilna'
opacity=0.92

# A right click pastes, as Denys asked (2026-11-25); Shift + right click
# opens the context menu. Ptyxis has no such setting: the Vilna build of
# Ptyxis (obs/packages/ptyxis, vilna-right-click-paste.patch) adds it as
# org.vilna.Ptyxis, off unless set here.
[org.vilna.Ptyxis]
right-click-paste=true

# Ptyxis's letter shortcuts also answer to the Ukrainian layout. GTK 4
# matches a shortcut by the letter the key types, and with Українська on
# Ctrl+Shift+C types «С», so copy, paste, new tab and the rest did nothing
# (Denys, Build12.29, 2026-11-25). Each shortcut is therefore
# «Latin|Cyrillic on the same key» (a GTK alternative trigger); the
# Cyrillic letters are those of the ua layout, the same as ru for these
# keys. tools/check_terminal.py checks that every letter shortcut has
# its Cyrillic twin. Changing one in Ptyxis ▸ Preferences replaces both.
[org.gnome.Ptyxis.Shortcuts]
copy-clipboard='<ctrl><shift>c|<ctrl><shift>Cyrillic_es'
paste-clipboard='<ctrl><shift>v|<ctrl><shift>Cyrillic_em'
new-tab='<ctrl><shift>t|<ctrl><shift>Cyrillic_ie'
new-window='<ctrl><shift>n|<ctrl><shift>Cyrillic_te'
split-auto='<ctrl><alt>a|<ctrl><alt>Cyrillic_ef'
split-horizontal='<ctrl><alt>d|<ctrl><alt>Cyrillic_ve'
split-vertical='<ctrl><alt>r|<ctrl><alt>Cyrillic_ka'
tab-overview='<ctrl><shift>o|<ctrl><shift>Cyrillic_shcha'
go-to-terminal='<ctrl><shift>p|<ctrl><shift>Cyrillic_ze'
search='<ctrl><shift>f|<ctrl><shift>Cyrillic_a'
select-all='<ctrl><shift>a|<ctrl><shift>Cyrillic_ef'
close-tab='<ctrl><shift>w|<ctrl><shift>Cyrillic_tse'
close-window='<ctrl><shift>q|<ctrl><shift>Cyrillic_shorti'
undo-close-tab='<ctrl><shift><alt>t|<ctrl><shift><alt>Cyrillic_ie'

[org.freedesktop.Tracker.Miner.Files]
index-removable-devices=false
