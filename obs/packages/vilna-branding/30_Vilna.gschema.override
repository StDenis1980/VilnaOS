# Vilna defaults for GNOME (replace Aeon's 30_Aeon, override openSUSE's
# 20_openSUSE-branding overrides). Design: light by default (decision 2026-11-09), the system
# accent colour (image/docs/composition.md, Vilna design brief).

[org.gnome.desktop.interface]
color-scheme='default'
clock-show-weekday=true
show-battery-percentage=true
font-antialiasing='rgba'

# Vilna wallpapers (vilna-backgrounds): Сонце by default, the light and
# dark pictures switch with the style. config.sh fails the image build if
# these files are missing.
[org.gnome.desktop.background]
picture-uri='file:///usr/share/backgrounds/vilna/vilna-sonce-light.jpg'
picture-uri-dark='file:///usr/share/backgrounds/vilna/vilna-sonce-dark.jpg'
primary-color='#F7F0E3'
secondary-color='#0D1830'

[org.gnome.desktop.screensaver]
picture-uri='file:///usr/share/backgrounds/vilna/vilna-sonce-dark.jpg'

[org.gnome.login-screen]
logo='/usr/share/icons/hicolor/scalable/apps/vilna-logo.svg'

[org.gnome.shell]
favorite-apps=['io.github.stdenis1980.Gloxi.desktop', 'org.mozilla.firefox.desktop', 'org.gnome.Nautilus.desktop', 'org.gnome.Software.desktop']

[org.gnome.software]
install-bundles-system-wide=false
enable-repos-dialog=false

[org.gnome.desktop.peripherals.touchpad]
tap-to-click=true

[org.gnome.desktop.wm.preferences]
audible-bell=false

[org.gnome.desktop.sound]
event-sounds=true
theme-name='freedesktop'

[org.gnome.settings-daemon.plugins.housekeeping]
ignore-paths=['/boot/efi']

[org.gnome.settings-daemon.plugins.media-keys]
custom-keybindings=['/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/custom0/']

[org.gnome.settings-daemon.plugins.media-keys.custom-keybindings.custom0]
binding='<Super>Return'
command='kgx'
name='Console'

[org.gnome.desktop.applications.terminal.exec-arg]
exec='kgx'
exec-arg='-e'

[org.freedesktop.Tracker.Miner.Files]
index-removable-devices=false
