<!-- Template: obs/tools/obs_sync.py replaces @PROJECT@ and @USER@ -->
<project name="@PROJECT@">
  <title>Vilna</title>
  <description>Vilna OS packages: branding, Gloxi, Herkos and friends.
Built against openSUSE Tumbleweed (the base of openSUSE Aeon).
Source: https://github.com/StDenis1980/VilnaOS (obs/)</description>
  <person userid="@USER@" role="maintainer"/>
  <publish>
    <enable/>
  </publish>
  <useforbuild>
    <enable/>
  </useforbuild>
  <repository name="openSUSE_Tumbleweed">
    <path project="openSUSE:Factory" repository="snapshot"/>
    <arch>x86_64</arch>
  </repository>
  <!-- KIWI images (obs/images/) from the packages built above -->
  <repository name="images">
    <path project="@PROJECT@" repository="openSUSE_Tumbleweed"/>
    <arch>x86_64</arch>
  </repository>
</project>
