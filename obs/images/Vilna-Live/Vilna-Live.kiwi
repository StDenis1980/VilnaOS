<?xml version="1.0" encoding="utf-8"?>
<!-- SPDX-License-Identifier: GPL-3.0-or-later -->
<!-- OBS-ExclusiveArch: x86_64 -->
<!--
  Vilna OS live image: an ISO for a USB stick (image/README.md,
  image/docs/installer.md, section 2). It boots the same system as the
  disk image Vilna (the vilna_base pattern) from a read-only squashfs
  with a RAM overlay, logs the "live" user in and starts the installer
  (vilna-installer) on the whole screen. Nothing is written to the
  computer's disks; changes are gone after a restart.

  So far the installer has only its first screen (step 0): it writes the
  start of the plan to $XDG_RUNTIME_DIR/vilna-installer/plan.json and
  ends, and the live desktop stays to try Vilna. The conversation with
  Gloxi, the plan check, Herkos's confirmation and the install engine
  come next (alpha work list, items 15 to 17).

  grub2 with shim, as the openSUSE live images: KIWI builds the ISO's
  EFI image from it, and Secure Boot works with the signed shim. The
  installed system keeps systemd-boot (the Vilna image).
-->
<image schemaversion="7.6" name="Vilna-Live">
  <description type="system">
    <author>Vilna contributors</author>
    <contact>https://github.com/StDenis1980/VilnaOS/issues</contact>
    <specification>Vilna OS live image with the installer</specification>
  </description>
  <preferences>
    <version>0.0.1</version>
    <packagemanager>zypper</packagemanager>
    <bootsplash-theme>vilna</bootsplash-theme>
    <rpm-excludedocs>false</rpm-excludedocs>
    <rpm-check-signatures>false</rpm-check-signatures>
    <locale>en_US</locale>
    <timezone>UTC</timezone>
    <!-- flags="overlay": the kiwi-live dracut module, squashfs root with
         an overlayfs in RAM. SELinux is permissive in the live session
         (enforcing=0): the squashfs and its RAM overlay were never
         checked enforcing on Vilna; the installed system stays
         enforcing. -->
    <!-- squashfscompression="zstd": the live root and the model weights
         unpack several times faster than with KIWI's default xz, for a
         slightly larger ISO (+190 MB). VM test of Build7.2 against
         Build6.4 (2026-11-12): first GNOME frame 15 s instead of 35,
         installer window 16 s instead of 46, model ready 41 s instead
         of 299-326. -->
    <type
      image="iso"
      primary="true"
      flags="overlay"
      firmware="uefi"
      mediacheck="false"
      squashfscompression="zstd"
      volid="VILNA_LIVE"
      publisher="Vilna"
      kernelcmdline="quiet splash loglevel=3 rd.udev.log_level=3 systemd.show_status=false rd.systemd.show_status=false security=selinux selinux=1 enforcing=0"
    >
      <!-- A visible text menu for 5 seconds, drawn and read on the
           firmware console: arrows pick the entry (KIWI's failsafe one
           too), E edits the kernel line, Enter boots. The hidden menu
           with KIWI's graphical terminal left only "Please press 't' to
           show the boot menu on this console" on a real UEFI laptop
           (KLX, Ventoy, Build10.11), and E did nothing (2026-11-17).
           Both consoles are named: without input_console KIWI uses
           output_console for input too, and console="gfxterm" once wrote
           "terminal_input gfxterm", which grub rejects (VM test of
           2026-11-09). -->
      <bootloader name="grub2" timeout="5" timeout_style="menu" output_console="console" input_console="console"/>
    </type>
  </preferences>
  <!-- OBS gives the image the repositories of the build repository:
       this project's openSUSE_Tumbleweed and openSUSE Tumbleweed itself. -->
  <repository type="rpm-md">
    <source path="obsrepositories:/"/>
  </repository>
  <packages type="image">
    <!-- The same system as the disk image Vilna -->
    <namedCollection name="vilna_base"/>
    <package name="vilna-installer"/>
    <!-- The system the installer writes to disk: the image
         tik-osimage-Vilna (obs/images/tik-osimage-Vilna), which OBS
         wraps into this RPM in the same "images" repository. -->
    <package name="tik-osimage-Vilna"/>
    <!-- A browser in the live session: for a Wi-Fi network with a login
         page and for reading help while installing. The installed
         system takes Firefox from Flathub on first boot
         (vilna-flatpak-defaults), but in the live image a Flatpak lands
         in the RAM overlay (+1.7 GB on KLX, 2026-11-17), while an RPM
         stays in the squashfs and is read from the stick. Live image
         only, decision of Denys of 2026-11-17. The two translation
         packages cover the ten languages (ADR 0009): uk, ro and lt are
         in -other. -->
    <package name="MozillaFirefox"/>
    <!-- MozillaFirefox needs some MozillaFirefox-branding and both the
         openSUSE and the upstream one provide it: without a choice OBS
         leaves the image "unresolvable" (2026-11-18). The openSUSE one
         is what openSUSE's own images take, so the Factory image rules
         allow it; live session only. -->
    <package name="MozillaFirefox-branding-openSUSE"/>
    <package name="MozillaFirefox-translations-common"/>
    <package name="MozillaFirefox-translations-other"/>
    <!-- Boot of a live ISO -->
    <package name="kernel-default"/>
    <package name="dracut-kiwi-live"/>
    <package name="grub2"/>
    <package name="grub2-x86_64-efi"/>
    <package name="shim"/>
  </packages>
  <packages type="bootstrap">
    <package name="filesystem"/>
    <package name="glibc-locale-base"/>
    <package name="ca-certificates-mozilla"/>
    <package name="Vilna-release"/>
  </packages>
</image>
