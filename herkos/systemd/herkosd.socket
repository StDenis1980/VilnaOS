# SPDX-License-Identifier: GPL-3.0-or-later
# The socket of the system Herkos (ADR 0005, ADR 0013). Anybody may connect:
# herkosd answers only the uids listed in /etc/herkos/system.toml (each
# person's Gloxi, and the person's session agent) and ignores the rest.
[Unit]
Description=Herkos permission gate socket

[Socket]
ListenStream=/run/herkos/herkos.sock
SocketMode=0666
DirectoryMode=0755
Accept=no

[Install]
WantedBy=sockets.target
