# The system Herkos: one service for everybody, as the system user herkos.
# Permissions and the Mitos journal of each person live in
# /var/lib/herkos/<uid>/, where no process of the person can reach them.
[Unit]
Description=Herkos permission gate of Vilna OS
Documentation=https://github.com/StDenis1980/VilnaOS/tree/main/herkos
Requires=herkosd.socket
After=herkosd.socket

[Service]
Type=simple
# As root ("+"), and never fatal ("-"): a snapper config for each person's
# home that is a btrfs subvolume, so Mitos can snapshot it (ADR 0026).
ExecStartPre=-+/usr/libexec/herkos/herkosd mitos-setup
ExecStart=/usr/libexec/herkos/herkosd system
# The listening socket arrives as stdin (herkosd forbids unsafe code, and
# adopting fd 3 would need it); stdout and stderr go to the journal.
StandardInput=socket
StandardOutput=journal
StandardError=journal
User=herkos
Group=herkos
StateDirectory=herkos
StateDirectoryMode=0700
# Where the tools started for each person connect (units.rs).
RuntimeDirectory=herkos-tools
RuntimeDirectoryMode=0711
UMask=0077
Restart=on-failure
# The key of the shared local model for the Keros check (vilna-llm.service,
# ADR 0025): without it llama-server refuses every check (Build14.9).
# herkos reads it as a member of the group gloxi (herkos.sysusers).
Environment=HERKOS_KEROS_KEY_FILE=/var/lib/vilna-llm/key

# Hardening: herkosd reads the settings and passwd, writes only its own
# state. It cannot become anybody: tools that act as a person are template
# units it may only start (vilna-mcp-*@<uid>.service, 50-herkos.rules).
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
CapabilityBoundingSet=
AmbientCapabilities=
# Unix sockets for Gloxi and the agents; loopback TCP for the Keros model.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressDeny=any
IPAddressAllow=localhost
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources

[Install]
Also=herkosd.socket
