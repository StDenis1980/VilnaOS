# The mail tool (ADR 0030) for the person with uid %i, started by the system
# Herkos (50-herkos.rules). It runs as the person: it takes the accounts and
# their sign-in from GNOME Online Accounts over the session bus, and talks
# to the mail servers over the network (encrypted, see mcp/mail/imap.py).
[Unit]
Description=Mail tool of Herkos for uid %i
ConditionPathExists=/run/herkos-tools/%i/mail.sock

[Service]
Type=simple
User=%i
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/%i/bus
Environment=XDG_RUNTIME_DIR=/run/user/%i
ExecStart=/usr/bin/vilna-mcp-mail
StandardInput=file:/run/herkos-tools/%i/mail.sock
StandardOutput=file:/run/herkos-tools/%i/mail.sock
StandardError=journal
# The tool stops when herkosd closes the connection; no restarts behind its back.
Restart=no

# Sandbox: no files to write; the session bus and the network, nothing else.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
PrivateDevices=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
