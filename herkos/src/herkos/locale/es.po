# Window and terminal
msgid "Herkos: permission"
msgstr "Herkos: permiso"

msgid "Herkos: Gloxi asks for permission"
msgstr "Herkos: Gloxi pide permiso"

msgid "Gloxi's reason: "
msgstr "Motivo de Gloxi: "

msgid "… and {n} more"
msgstr "… y {n} más"

msgid "Can be undone."
msgstr "Se puede deshacer."

msgid "Cannot be undone."
msgstr "No se puede deshacer."

msgid "Riskier than usual: {why}."
msgstr "Más arriesgado de lo habitual: {why}."

msgid "Untrusted content came from: {src}"
msgstr "Contenido no fiable procedente de: {src}"

msgid "Exactly this will be done:"
msgstr "Se hará exactamente esto:"

msgid "Deny"
msgstr "Denegar"

msgid "Allow once"
msgstr "Permitir una vez"

msgid "Allow for this session"
msgstr "Permitir durante esta sesión"

msgid "Always allow"
msgstr "Permitir siempre"

msgid "[o] allow once"
msgstr "[o] permitir una vez"

msgid "[s] allow for this session"
msgstr "[s] permitir durante esta sesión"

msgid "[a] always allow"
msgstr "[a] permitir siempre"

msgid "[n] deny"
msgstr "[n] denegar"

msgid "Allowed."
msgstr "Permitido."

msgid "Denied."
msgstr "Denegado."

msgid "No answer: denied."
msgstr "Sin respuesta: denegado."

# Why an action is riskier (policy)
msgid "the tool has no Herkos manifest"
msgstr "la herramienta no tiene manifiesto de Herkos"

msgid "the program changed this action since it was allowed"
msgstr "el programa cambió esta acción desde que se permitió"

msgid "the program describes this action at too great a length"
msgstr "el programa describe esta acción con demasiada extensión"

msgid "Let Gloxi use this program: {program}"
msgstr "Dejar que Gloxi use este programa: {program}"

msgid "the tool describes this operation as riskier"
msgstr "la herramienta describe esta operación como más arriesgada"

msgid "untrusted content is in the conversation"
msgstr "hay contenido no fiable en la conversación"

msgid "content read earlier {kinds}"
msgstr "el contenido leído antes {kinds}"

msgid "it touches something outside the allowed folders"
msgstr "afecta a algo fuera de las carpetas permitidas"

msgid "it touches more than {n} items at once"
msgstr "afecta a más de {n} elementos a la vez"

msgid "it cannot be undone"
msgstr "no se puede deshacer"

msgid "Herkos cannot tell which of the program's commands this runs"
msgstr "Herkos no puede saber qué orden del programa ejecuta esto"

msgid "the manifest gives no level for the program's command {commands}"
msgstr "el manifiesto no da nivel para la orden {commands} del programa"

msgid "data leaves this device"
msgstr "los datos salen de este dispositivo"

msgid "it sends data to an address that came from untrusted content"
msgstr "envía datos a una dirección que vino de contenido no fiable"

# Keros findings
msgid "asks the assistant to ignore its instructions"
msgstr "pide al asistente que ignore sus instrucciones"

msgid "tries to give the assistant a new role or new instructions"
msgstr "intenta dar al asistente un nuevo papel o nuevas instrucciones"

msgid "contains chat-template or system markers"
msgstr "contiene marcas de plantilla de chat o de sistema"

msgid "contains text hidden from people (HTML/CSS)"
msgstr "contiene texto oculto a las personas (HTML/CSS)"

msgid "contains a link that could carry data away"
msgstr "contiene un enlace que podría sacar datos"

msgid "contains invisible or direction-changing characters"
msgstr "contiene caracteres invisibles o que cambian la dirección del texto"

msgid "the local check found text addressed to the assistant"
msgstr "la comprobación local encontró texto dirigido al asistente"

# Tool operations (manifest summaries)
msgid "List a folder"
msgstr "Listar una carpeta"

msgid "Search files by name and text"
msgstr "Buscar archivos por nombre y texto"

msgid "Read a file"
msgstr "Leer un archivo"

msgid "Create a file"
msgstr "Crear un archivo"

msgid "Change a file"
msgstr "Cambiar un archivo"

msgid "Delete a file"
msgstr "Borrar un archivo"

msgid "Undo an earlier change to a file"
msgstr "Deshacer un cambio anterior en un archivo"

# Backups (org.vilna.mcp.backup)
msgid "See whether backups are on and how the last one went"
msgstr "Ver si las copias están activadas y cómo fue la última"

msgid "List the backups"
msgstr "Listar las copias"

msgid "See how much space the folders take"
msgstr "Ver cuánto espacio ocupan las carpetas"

msgid "Make a backup now"
msgstr "Hacer una copia ahora"

msgid "Change how often backups are made"
msgstr "Cambiar cada cuánto se hacen las copias"

msgid "Change what goes into backups"
msgstr "Cambiar qué entra en las copias"

msgid "Bring a backup back into a new folder"
msgstr "Recuperar una copia en una carpeta nueva"

msgid "Choose where backups are kept"
msgstr "Elegir dónde se guardan las copias"

msgid "Bring files back over the current ones"
msgstr "Recuperar archivos sobre los actuales"

msgid "Delete backups"
msgstr "Borrar copias"

msgid "Move backups to another place"
msgstr "Mover las copias a otro lugar"

msgid "Replace the backup keys"
msgstr "Sustituir las claves de las copias"

msgid "Protect backups after a device was stolen"
msgstr "Proteger las copias tras el robo de un dispositivo"

