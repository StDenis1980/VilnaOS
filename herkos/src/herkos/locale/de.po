# Window and terminal
msgid "Herkos: permission"
msgstr "Herkos: Berechtigung"

msgid "Herkos: Gloxi asks for permission"
msgstr "Herkos: Gloxi bittet um Erlaubnis"

msgid "Gloxi's reason: "
msgstr "Begründung von Gloxi: "

msgid "… and {n} more"
msgstr "… und {n} weitere"

msgid "Can be undone."
msgstr "Kann rückgängig gemacht werden."

msgid "Cannot be undone."
msgstr "Kann nicht rückgängig gemacht werden."

msgid "Riskier than usual: {why}."
msgstr "Riskanter als üblich: {why}."

msgid "Untrusted content came from: {src}"
msgstr "Nicht vertrauenswürdiger Inhalt kam von: {src}"

msgid "Exactly this will be done:"
msgstr "Genau das wird ausgeführt:"

msgid "Deny"
msgstr "Ablehnen"

msgid "Allow once"
msgstr "Einmal erlauben"

msgid "Allow for this session"
msgstr "Für diese Sitzung erlauben"

msgid "Always allow"
msgstr "Immer erlauben"

msgid "[o] allow once"
msgstr "[o] einmal erlauben"

msgid "[s] allow for this session"
msgstr "[s] für diese Sitzung erlauben"

msgid "[a] always allow"
msgstr "[a] immer erlauben"

msgid "[n] deny"
msgstr "[n] ablehnen"

msgid "Allowed."
msgstr "Erlaubt."

msgid "Denied."
msgstr "Abgelehnt."

msgid "No answer: denied."
msgstr "Keine Antwort: abgelehnt."

# Why an action is riskier (policy)
msgid "the tool has no Herkos manifest"
msgstr "das Werkzeug hat kein Herkos-Manifest"

msgid "the program changed this action since it was allowed"
msgstr "das Programm hat diese Aktion geändert, seit sie erlaubt wurde"

msgid "the program describes this action at too great a length"
msgstr "das Programm beschreibt diese Aktion zu ausführlich"

msgid "Let Gloxi use this program: {program}"
msgstr "Gloxi dieses Programm verwenden lassen: {program}"

msgid "the tool describes this operation as riskier"
msgstr "das Werkzeug stuft diesen Vorgang als riskanter ein"

msgid "untrusted content is in the conversation"
msgstr "nicht vertrauenswürdiger Inhalt ist in der Unterhaltung"

msgid "content read earlier {kinds}"
msgstr "früher gelesener Inhalt {kinds}"

msgid "it touches something outside the allowed folders"
msgstr "es betrifft etwas außerhalb der erlaubten Ordner"

msgid "it touches more than {n} items at once"
msgstr "es betrifft mehr als {n} Elemente auf einmal"

msgid "it cannot be undone"
msgstr "es kann nicht rückgängig gemacht werden"

msgid "Herkos cannot tell which of the program's commands this runs"
msgstr "Herkos kann nicht erkennen, welchen Befehl des Programms dies ausführt"

msgid "the manifest gives no level for the program's command {commands}"
msgstr "das Manifest gibt keine Stufe für den Befehl {commands} des Programms an"

msgid "data leaves this device"
msgstr "Daten verlassen dieses Gerät"

msgid "it sends data to an address that came from untrusted content"
msgstr "es sendet Daten an eine Adresse aus nicht vertrauenswürdigem Inhalt"

# Keros findings
msgid "asks the assistant to ignore its instructions"
msgstr "fordert den Assistenten auf, seine Anweisungen zu ignorieren"

msgid "tries to give the assistant a new role or new instructions"
msgstr "versucht, dem Assistenten eine neue Rolle oder neue Anweisungen zu geben"

msgid "contains chat-template or system markers"
msgstr "enthält Chat-Vorlagen- oder Systemmarkierungen"

msgid "contains text hidden from people (HTML/CSS)"
msgstr "enthält für Menschen verborgenen Text (HTML/CSS)"

msgid "contains a link that could carry data away"
msgstr "enthält einen Link, der Daten abfließen lassen könnte"

msgid "contains invisible or direction-changing characters"
msgstr "enthält unsichtbare oder richtungsändernde Zeichen"

msgid "the local check found text addressed to the assistant"
msgstr "die lokale Prüfung hat Text gefunden, der an den Assistenten gerichtet ist"

# Tool operations (manifest summaries)
msgid "List a folder"
msgstr "Einen Ordner auflisten"

msgid "Search files by name and text"
msgstr "Dateien nach Name und Text durchsuchen"

msgid "Read a file"
msgstr "Eine Datei lesen"

msgid "Create a file"
msgstr "Eine Datei anlegen"

msgid "Change a file"
msgstr "Eine Datei ändern"

msgid "Delete a file"
msgstr "Eine Datei löschen"

msgid "Undo an earlier change to a file"
msgstr "Eine frühere Änderung an einer Datei rückgängig machen"

# Backups (org.vilna.mcp.backup)
msgid "See whether backups are on and how the last one went"
msgstr "Ansehen, ob Sicherungen eingeschaltet sind und wie die letzte verlief"

msgid "List the backups"
msgstr "Die Sicherungen auflisten"

msgid "See how much space the folders take"
msgstr "Ansehen, wie viel Platz die Ordner belegen"

msgid "Make a backup now"
msgstr "Jetzt eine Sicherung erstellen"

msgid "Change how often backups are made"
msgstr "Ändern, wie oft gesichert wird"

msgid "Change what goes into backups"
msgstr "Ändern, was gesichert wird"

msgid "Bring a backup back into a new folder"
msgstr "Eine Sicherung in einen neuen Ordner zurückholen"

msgid "Choose where backups are kept"
msgstr "Wählen, wo die Sicherungen liegen"

msgid "Bring files back over the current ones"
msgstr "Dateien über die aktuellen zurückholen"

msgid "Delete backups"
msgstr "Sicherungen löschen"

msgid "Move backups to another place"
msgstr "Sicherungen an einen anderen Ort verschieben"

msgid "Replace the backup keys"
msgstr "Die Sicherungsschlüssel ersetzen"

msgid "Protect backups after a device was stolen"
msgstr "Sicherungen nach dem Diebstahl eines Geräts schützen"

