# Window and terminal
msgid "Herkos: permission"
msgstr "Herkos: leidimas"

msgid "Herkos: Gloxi asks for permission"
msgstr "Herkos: Gloxi prašo leidimo"

msgid "Gloxi's reason: "
msgstr "Gloxi paaiškinimas: "

msgid "… and {n} more"
msgstr "… ir dar {n}"

msgid "Can be undone."
msgstr "Galima atšaukti."

msgid "Cannot be undone."
msgstr "Atšaukti negalima."

msgid "Riskier than usual: {why}."
msgstr "Rizikingiau nei įprastai: {why}."

msgid "Untrusted content came from: {src}"
msgstr "Nepatikimas turinys gautas iš: {src}"

msgid "Exactly this will be done:"
msgstr "Bus atlikta būtent tai:"

msgid "Deny"
msgstr "Atmesti"

msgid "Allow once"
msgstr "Leisti vieną kartą"

msgid "Allow for this session"
msgstr "Leisti šiam seansui"

msgid "Always allow"
msgstr "Leisti visada"

msgid "[o] allow once"
msgstr "[o] leisti vieną kartą"

msgid "[s] allow for this session"
msgstr "[s] leisti šiam seansui"

msgid "[a] always allow"
msgstr "[a] leisti visada"

msgid "[n] deny"
msgstr "[n] atmesti"

msgid "Allowed."
msgstr "Leista."

msgid "Denied."
msgstr "Atmesta."

msgid "No answer: denied."
msgstr "Nėra atsakymo: atmesta."

# Why an action is riskier (policy)
msgid "the tool has no Herkos manifest"
msgstr "įrankis neturi Herkos manifesto"

msgid "the program changed this action since it was allowed"
msgstr "programa pakeitė šį veiksmą po to, kai jis buvo leistas"

msgid "the program describes this action at too great a length"
msgstr "programa aprašo šį veiksmą per ilgai"

msgid "Let Gloxi use this program: {program}"
msgstr "Leisti Gloxi naudoti šią programą: {program}"

msgid "the tool describes this operation as riskier"
msgstr "įrankis šią operaciją apibūdina kaip rizikingesnę"

msgid "untrusted content is in the conversation"
msgstr "pokalbyje yra nepatikimo turinio"

msgid "content read earlier {kinds}"
msgstr "anksčiau perskaitytas turinys {kinds}"

msgid "it touches something outside the allowed folders"
msgstr "tai paliečia kažką už leistų aplankų ribų"

msgid "it touches more than {n} items at once"
msgstr "tai paliečia daugiau nei {n} elementų iš karto"

msgid "it cannot be undone"
msgstr "to atšaukti negalima"

msgid "Herkos cannot tell which of the program's commands this runs"
msgstr "Herkos negali nustatyti, kurią programos komandą tai vykdo"

msgid "the manifest gives no level for the program's command {commands}"
msgstr "manifestas nenurodo lygio programos komandai {commands}"

msgid "data leaves this device"
msgstr "duomenys palieka šį įrenginį"

msgid "it sends data to an address that came from untrusted content"
msgstr "siunčia duomenis adresu, gautu iš nepatikimo turinio"

# Keros findings
msgid "asks the assistant to ignore its instructions"
msgstr "prašo asistento nepaisyti savo nurodymų"

msgid "tries to give the assistant a new role or new instructions"
msgstr "bando suteikti asistentui naują vaidmenį ar naujus nurodymus"

msgid "contains chat-template or system markers"
msgstr "turi pokalbio šablono ar sistemos žymių"

msgid "contains text hidden from people (HTML/CSS)"
msgstr "turi žmonėms paslėpto teksto (HTML/CSS)"

msgid "contains a link that could carry data away"
msgstr "turi nuorodą, kuria galėtų nutekėti duomenys"

msgid "contains invisible or direction-changing characters"
msgstr "turi nematomų ar teksto kryptį keičiančių simbolių"

msgid "the local check found text addressed to the assistant"
msgstr "vietinė patikra rado asistentui skirto teksto"

# Tool operations (manifest summaries)
msgid "List a folder"
msgstr "Parodyti aplanko turinį"

msgid "Search files by name and text"
msgstr "Ieškoti failų pagal pavadinimą ir tekstą"

msgid "Read a file"
msgstr "Perskaityti failą"

msgid "Create a file"
msgstr "Sukurti failą"

msgid "Change a file"
msgstr "Pakeisti failą"

msgid "Delete a file"
msgstr "Ištrinti failą"

msgid "Undo an earlier change to a file"
msgstr "Atšaukti ankstesnį failo pakeitimą"

# Backups (org.vilna.mcp.backup)
msgid "See whether backups are on and how the last one went"
msgstr "Pažiūrėti, ar atsarginės kopijos įjungtos ir kaip pavyko paskutinė"

msgid "List the backups"
msgstr "Parodyti atsargines kopijas"

msgid "See how much space the folders take"
msgstr "Pažiūrėti, kiek vietos užima aplankai"

msgid "Make a backup now"
msgstr "Padaryti kopiją dabar"

msgid "Change how often backups are made"
msgstr "Pakeisti, kaip dažnai daromos kopijos"

msgid "Change what goes into backups"
msgstr "Pakeisti, kas įtraukiama į kopijas"

msgid "Bring a backup back into a new folder"
msgstr "Atkurti kopiją į naują aplanką"

msgid "Choose where backups are kept"
msgstr "Pasirinkti, kur laikomos kopijos"

msgid "Bring files back over the current ones"
msgstr "Atkurti failus vietoje dabartinių"

msgid "Delete backups"
msgstr "Ištrinti kopijas"

msgid "Move backups to another place"
msgstr "Perkelti kopijas į kitą vietą"

msgid "Replace the backup keys"
msgstr "Pakeisti kopijų raktus"

msgid "Protect backups after a device was stolen"
msgstr "Apsaugoti kopijas po įrenginio vagystės"

