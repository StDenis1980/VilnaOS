# Window and terminal
msgid "Herkos: permission"
msgstr "Herkos : autorisation"

msgid "Herkos: Gloxi asks for permission"
msgstr "Herkos : Gloxi demande une autorisation"

msgid "Gloxi's reason: "
msgstr "Raison donnée par Gloxi : "

msgid "… and {n} more"
msgstr "… et {n} de plus"

msgid "Can be undone."
msgstr "Peut être annulé."

msgid "Cannot be undone."
msgstr "Ne peut pas être annulé."

msgid "Riskier than usual: {why}."
msgstr "Plus risqué que d’habitude : {why}."

msgid "Untrusted content came from: {src}"
msgstr "Du contenu non fiable vient de : {src}"

msgid "Exactly this will be done:"
msgstr "Voici exactement ce qui sera fait :"

msgid "Deny"
msgstr "Refuser"

msgid "Allow once"
msgstr "Autoriser une fois"

msgid "Allow for this session"
msgstr "Autoriser pour cette session"

msgid "Always allow"
msgstr "Toujours autoriser"

msgid "[o] allow once"
msgstr "[o] autoriser une fois"

msgid "[s] allow for this session"
msgstr "[s] autoriser pour cette session"

msgid "[a] always allow"
msgstr "[a] toujours autoriser"

msgid "[n] deny"
msgstr "[n] refuser"

msgid "Allowed."
msgstr "Autorisé."

msgid "Denied."
msgstr "Refusé."

msgid "No answer: denied."
msgstr "Pas de réponse : refusé."

# Why an action is riskier (policy)
msgid "the tool has no Herkos manifest"
msgstr "l’outil n’a pas de manifeste Herkos"

msgid "the program changed this action since it was allowed"
msgstr "le programme a modifié cette action depuis qu’elle a été autorisée"

msgid "the program describes this action at too great a length"
msgstr "le programme décrit cette action trop longuement"

msgid "Let Gloxi use this program: {program}"
msgstr "Laisser Gloxi utiliser ce programme : {program}"

msgid "the tool describes this operation as riskier"
msgstr "l’outil décrit cette opération comme plus risquée"

msgid "untrusted content is in the conversation"
msgstr "du contenu non fiable est dans la conversation"

msgid "content read earlier {kinds}"
msgstr "le contenu lu plus tôt {kinds}"

msgid "it touches something outside the allowed folders"
msgstr "cela touche quelque chose hors des dossiers autorisés"

msgid "it touches more than {n} items at once"
msgstr "cela touche plus de {n} éléments à la fois"

msgid "it cannot be undone"
msgstr "cela ne peut pas être annulé"

msgid "Herkos cannot tell which of the program's commands this runs"
msgstr "Herkos ne peut pas savoir quelle commande du programme ceci exécute"

msgid "the manifest gives no level for the program's command {commands}"
msgstr "le manifeste ne donne pas de niveau pour la commande {commands} du programme"

msgid "data leaves this device"
msgstr "des données quittent cet appareil"

msgid "it sends data to an address that came from untrusted content"
msgstr "cela envoie des données à une adresse venue d’un contenu non fiable"

# Keros findings
msgid "asks the assistant to ignore its instructions"
msgstr "demande à l’assistant d’ignorer ses instructions"

msgid "tries to give the assistant a new role or new instructions"
msgstr "tente de donner à l’assistant un nouveau rôle ou de nouvelles instructions"

msgid "contains chat-template or system markers"
msgstr "contient des marqueurs de modèle de conversation ou de système"

msgid "contains text hidden from people (HTML/CSS)"
msgstr "contient du texte caché aux personnes (HTML/CSS)"

msgid "contains a link that could carry data away"
msgstr "contient un lien qui pourrait emporter des données"

msgid "contains invisible or direction-changing characters"
msgstr "contient des caractères invisibles ou qui changent le sens de l’écriture"

msgid "the local check found text addressed to the assistant"
msgstr "la vérification locale a trouvé du texte adressé à l’assistant"

# Tool operations (manifest summaries)
msgid "List a folder"
msgstr "Lister un dossier"

msgid "Search files by name and text"
msgstr "Chercher des fichiers par nom et par texte"

msgid "Read a file"
msgstr "Lire un fichier"

msgid "Create a file"
msgstr "Créer un fichier"

msgid "Change a file"
msgstr "Modifier un fichier"

msgid "Delete a file"
msgstr "Supprimer un fichier"

msgid "Undo an earlier change to a file"
msgstr "Annuler une modification antérieure d’un fichier"

# Backups (org.vilna.mcp.backup)
msgid "See whether backups are on and how the last one went"
msgstr "Voir si les sauvegardes sont activées et comment s’est passée la dernière"

msgid "List the backups"
msgstr "Lister les sauvegardes"

msgid "See how much space the folders take"
msgstr "Voir la place occupée par les dossiers"

msgid "Make a backup now"
msgstr "Faire une sauvegarde maintenant"

msgid "Change how often backups are made"
msgstr "Modifier la fréquence des sauvegardes"

msgid "Change what goes into backups"
msgstr "Modifier ce qui va dans les sauvegardes"

msgid "Bring a backup back into a new folder"
msgstr "Récupérer une sauvegarde dans un nouveau dossier"

msgid "Choose where backups are kept"
msgstr "Choisir où garder les sauvegardes"

msgid "Bring files back over the current ones"
msgstr "Récupérer des fichiers par-dessus les actuels"

msgid "Delete backups"
msgstr "Supprimer des sauvegardes"

msgid "Move backups to another place"
msgstr "Déplacer les sauvegardes ailleurs"

msgid "Replace the backup keys"
msgstr "Remplacer les clés des sauvegardes"

msgid "Protect backups after a device was stolen"
msgstr "Protéger les sauvegardes après le vol d’un appareil"

