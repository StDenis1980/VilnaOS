# Window and terminal
msgid "Herkos: permission"
msgstr "Herkos: uprawnienie"

msgid "Herkos: Gloxi asks for permission"
msgstr "Herkos: Gloxi prosi o pozwolenie"

msgid "Gloxi's reason: "
msgstr "Uzasadnienie Gloxi: "

msgid "… and {n} more"
msgstr "… i jeszcze {n}"

msgid "Can be undone."
msgstr "Można cofnąć."

msgid "Cannot be undone."
msgstr "Nie można cofnąć."

msgid "Riskier than usual: {why}."
msgstr "Bardziej ryzykowne niż zwykle: {why}."

msgid "Untrusted content came from: {src}"
msgstr "Niezaufana treść pochodzi z: {src}"

msgid "Exactly this will be done:"
msgstr "Zostanie wykonane dokładnie to:"

msgid "Deny"
msgstr "Odmów"

msgid "Allow once"
msgstr "Zezwól raz"

msgid "Allow for this session"
msgstr "Zezwól na tę sesję"

msgid "Always allow"
msgstr "Zezwalaj zawsze"

msgid "[o] allow once"
msgstr "[o] zezwól raz"

msgid "[s] allow for this session"
msgstr "[s] zezwól na tę sesję"

msgid "[a] always allow"
msgstr "[a] zezwalaj zawsze"

msgid "[n] deny"
msgstr "[n] odmów"

msgid "Allowed."
msgstr "Zezwolono."

msgid "Denied."
msgstr "Odmówiono."

msgid "No answer: denied."
msgstr "Brak odpowiedzi: odmówiono."

# Why an action is riskier (policy)
msgid "the tool has no Herkos manifest"
msgstr "narzędzie nie ma manifestu Herkosa"

msgid "the program changed this action since it was allowed"
msgstr "program zmienił to działanie, odkąd zostało dozwolone"

msgid "the program describes this action at too great a length"
msgstr "program opisuje to działanie zbyt obszernie"

msgid "Let Gloxi use this program: {program}"
msgstr "Pozwól Gloxi używać tego programu: {program}"

msgid "the tool describes this operation as riskier"
msgstr "narzędzie opisuje tę operację jako bardziej ryzykowną"

msgid "untrusted content is in the conversation"
msgstr "w rozmowie jest niezaufana treść"

msgid "content read earlier {kinds}"
msgstr "wcześniej przeczytana treść {kinds}"

msgid "it touches something outside the allowed folders"
msgstr "dotyczy czegoś poza dozwolonymi folderami"

msgid "it touches more than {n} items at once"
msgstr "dotyczy naraz więcej niż {n} elementów"

msgid "it cannot be undone"
msgstr "nie można tego cofnąć"

msgid "Herkos cannot tell which of the program's commands this runs"
msgstr "Herkos nie potrafi ustalić, które polecenie programu to uruchamia"

msgid "the manifest gives no level for the program's command {commands}"
msgstr "manifest nie podaje poziomu dla polecenia programu {commands}"

msgid "data leaves this device"
msgstr "dane opuszczają to urządzenie"

msgid "it sends data to an address that came from untrusted content"
msgstr "wysyła dane pod adres pochodzący z niezaufanej treści"

# Keros findings
msgid "asks the assistant to ignore its instructions"
msgstr "prosi asystenta o zignorowanie jego instrukcji"

msgid "tries to give the assistant a new role or new instructions"
msgstr "próbuje nadać asystentowi nową rolę lub nowe instrukcje"

msgid "contains chat-template or system markers"
msgstr "zawiera znaczniki szablonu czatu lub systemu"

msgid "contains text hidden from people (HTML/CSS)"
msgstr "zawiera tekst ukryty przed ludźmi (HTML/CSS)"

msgid "contains a link that could carry data away"
msgstr "zawiera link, który mógłby wynieść dane"

msgid "contains invisible or direction-changing characters"
msgstr "zawiera niewidoczne znaki lub znaki zmieniające kierunek tekstu"

msgid "the local check found text addressed to the assistant"
msgstr "lokalna kontrola znalazła tekst skierowany do asystenta"

# Tool operations (manifest summaries)
msgid "List a folder"
msgstr "Wyświetlić zawartość folderu"

msgid "Search files by name and text"
msgstr "Szukać plików po nazwie i treści"

msgid "Read a file"
msgstr "Przeczytać plik"

msgid "Create a file"
msgstr "Utworzyć plik"

msgid "Change a file"
msgstr "Zmienić plik"

msgid "Delete a file"
msgstr "Usunąć plik"

msgid "Undo an earlier change to a file"
msgstr "Cofnąć wcześniejszą zmianę w pliku"

# Backups (org.vilna.mcp.backup)
msgid "See whether backups are on and how the last one went"
msgstr "Sprawdzić, czy kopie są włączone i jak poszła ostatnia"

msgid "List the backups"
msgstr "Wyświetlić listę kopii"

msgid "See how much space the folders take"
msgstr "Sprawdzić, ile miejsca zajmują foldery"

msgid "Make a backup now"
msgstr "Zrobić kopię teraz"

msgid "Change how often backups are made"
msgstr "Zmienić, jak często są robione kopie"

msgid "Change what goes into backups"
msgstr "Zmienić, co trafia do kopii"

msgid "Bring a backup back into a new folder"
msgstr "Przywrócić kopię do nowego folderu"

msgid "Choose where backups are kept"
msgstr "Wybrać, gdzie przechowywać kopie"

msgid "Bring files back over the current ones"
msgstr "Przywrócić pliki w miejsce obecnych"

msgid "Delete backups"
msgstr "Usunąć kopie"

msgid "Move backups to another place"
msgstr "Przenieść kopie w inne miejsce"

msgid "Replace the backup keys"
msgstr "Wymienić klucze kopii"

msgid "Protect backups after a device was stolen"
msgstr "Chronić kopie po kradzieży urządzenia"

