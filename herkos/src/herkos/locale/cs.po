# Window and terminal
msgid "Herkos: permission"
msgstr "Herkos: oprávnění"

msgid "Herkos: Gloxi asks for permission"
msgstr "Herkos: Gloxi žádá o svolení"

msgid "Gloxi's reason: "
msgstr "Zdůvodnění od Gloxi: "

msgid "… and {n} more"
msgstr "… a {n} dalších"

msgid "Can be undone."
msgstr "Lze vrátit zpět."

msgid "Cannot be undone."
msgstr "Nelze vrátit zpět."

msgid "Riskier than usual: {why}."
msgstr "Riskantnější než obvykle: {why}."

msgid "Untrusted content came from: {src}"
msgstr "Nedůvěryhodný obsah pochází z: {src}"

msgid "Exactly this will be done:"
msgstr "Provede se přesně toto:"

msgid "Deny"
msgstr "Zamítnout"

msgid "Allow once"
msgstr "Povolit jednou"

msgid "Allow for this session"
msgstr "Povolit pro toto sezení"

msgid "Always allow"
msgstr "Vždy povolit"

msgid "[o] allow once"
msgstr "[o] povolit jednou"

msgid "[s] allow for this session"
msgstr "[s] povolit pro toto sezení"

msgid "[a] always allow"
msgstr "[a] vždy povolit"

msgid "[n] deny"
msgstr "[n] zamítnout"

msgid "Allowed."
msgstr "Povoleno."

msgid "Denied."
msgstr "Zamítnuto."

msgid "No answer: denied."
msgstr "Bez odpovědi: zamítnuto."

# Why an action is riskier (policy)
msgid "the tool has no Herkos manifest"
msgstr "nástroj nemá manifest Herkos"

msgid "the program changed this action since it was allowed"
msgstr "program tuto akci změnil od chvíle, kdy byla povolena"

msgid "the program describes this action at too great a length"
msgstr "program tuto akci popisuje příliš dlouze"

msgid "Let Gloxi use this program: {program}"
msgstr "Dovolit Gloxi používat tento program: {program}"

msgid "the tool describes this operation as riskier"
msgstr "nástroj tuto operaci popisuje jako riskantnější"

msgid "untrusted content is in the conversation"
msgstr "v konverzaci je nedůvěryhodný obsah"

msgid "content read earlier {kinds}"
msgstr "dříve přečtený obsah {kinds}"

msgid "it touches something outside the allowed folders"
msgstr "týká se něčeho mimo povolené složky"

msgid "it touches more than {n} items at once"
msgstr "týká se více než {n} položek najednou"

msgid "it cannot be undone"
msgstr "nelze to vrátit zpět"

msgid "Herkos cannot tell which of the program's commands this runs"
msgstr "Herkos nedokáže určit, který příkaz programu se tím spouští"

msgid "the manifest gives no level for the program's command {commands}"
msgstr "manifest neuvádí úroveň pro příkaz programu {commands}"

msgid "data leaves this device"
msgstr "data opouštějí toto zařízení"

msgid "it sends data to an address that came from untrusted content"
msgstr "posílá data na adresu, která pochází z nedůvěryhodného obsahu"

# Keros findings
msgid "asks the assistant to ignore its instructions"
msgstr "žádá asistenta, aby ignoroval své pokyny"

msgid "tries to give the assistant a new role or new instructions"
msgstr "snaží se asistentovi dát novou roli nebo nové pokyny"

msgid "contains chat-template or system markers"
msgstr "obsahuje značky šablony chatu nebo systému"

msgid "contains text hidden from people (HTML/CSS)"
msgstr "obsahuje text skrytý před lidmi (HTML/CSS)"

msgid "contains a link that could carry data away"
msgstr "obsahuje odkaz, který by mohl vynést data"

msgid "contains invisible or direction-changing characters"
msgstr "obsahuje neviditelné znaky nebo znaky měnící směr textu"

msgid "the local check found text addressed to the assistant"
msgstr "místní kontrola našla text určený asistentovi"

# Tool operations (manifest summaries)
msgid "List a folder"
msgstr "Vypsat složku"

msgid "Search files by name and text"
msgstr "Hledat soubory podle názvu a textu"

msgid "Read a file"
msgstr "Přečíst soubor"

msgid "Create a file"
msgstr "Vytvořit soubor"

msgid "Change a file"
msgstr "Změnit soubor"

msgid "Delete a file"
msgstr "Smazat soubor"

msgid "Undo an earlier change to a file"
msgstr "Vrátit dřívější změnu souboru"

# Backups (org.vilna.mcp.backup)
msgid "See whether backups are on and how the last one went"
msgstr "Zjistit, zda jsou zálohy zapnuté a jak dopadla poslední"

msgid "List the backups"
msgstr "Vypsat zálohy"

msgid "See how much space the folders take"
msgstr "Zjistit, kolik místa zabírají složky"

msgid "Make a backup now"
msgstr "Zálohovat hned"

msgid "Change how often backups are made"
msgstr "Změnit, jak často se zálohuje"

msgid "Change what goes into backups"
msgstr "Změnit, co se zálohuje"

msgid "Bring a backup back into a new folder"
msgstr "Vrátit zálohu do nové složky"

msgid "Choose where backups are kept"
msgstr "Vybrat, kde se zálohy ukládají"

msgid "Bring files back over the current ones"
msgstr "Vrátit soubory přes současné"

msgid "Delete backups"
msgstr "Smazat zálohy"

msgid "Move backups to another place"
msgstr "Přesunout zálohy jinam"

msgid "Replace the backup keys"
msgstr "Vyměnit klíče záloh"

msgid "Protect backups after a device was stolen"
msgstr "Ochránit zálohy po krádeži zařízení"

