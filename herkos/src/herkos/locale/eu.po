# Why an action is riskier (policy)
msgid "the tool has no Herkos manifest"
msgstr "tresnak ez du Herkos manifesturik"

msgid "the program changed this action since it was allowed"
msgstr "programak ekintza hau aldatu du baimendu zenetik"

msgid "the program describes this action at too great a length"
msgstr "programak luzeegi deskribatzen du ekintza hau"

msgid "Let Gloxi use this program: {program}"
msgstr "Utzi Gloxiri programa hau erabiltzen: {program}"

msgid "the tool describes this operation as riskier"
msgstr "tresnak eragiketa hau arriskutsuagotzat jotzen du"

msgid "untrusted content is in the conversation"
msgstr "fidagarria ez den edukia dago elkarrizketan"

msgid "content read earlier {kinds}"
msgstr "lehenago irakurritako edukia: {kinds}"

msgid "it touches something outside the allowed folders"
msgstr "baimendutako karpetetatik kanpoko zerbait ukitzen du"

msgid "it touches more than {n} items at once"
msgstr "{n} elementu baino gehiago ukitzen ditu aldi berean"

msgid "it cannot be undone"
msgstr "ezin da desegin"

msgid "Herkos cannot tell which of the program's commands this runs"
msgstr "Herkosek ezin du jakin honek programaren zein agindu exekutatzen duen"

msgid "the manifest gives no level for the program's command {commands}"
msgstr "manifestuak ez du mailarik ematen programaren {commands} aginduarentzat"

msgid "data leaves this device"
msgstr "datuak gailu honetatik ateratzen dira"

msgid "it sends data to an address that came from untrusted content"
msgstr "fidagarria ez den edukitik etorritako helbide batera bidaltzen ditu datuak"

# Keros findings
msgid "asks the assistant to ignore its instructions"
msgstr "laguntzaileari bere argibideei jaramonik ez egiteko eskatzen dio"

