# Certificate for the spare copy of vilnaos.com (ADR 0032), HTTP-01 through acme.vilnaos.com.
[Unit]
Description=Get or renew the vilnaos.com certificate for the spare host
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/lib/vilna-site/cert.sh
